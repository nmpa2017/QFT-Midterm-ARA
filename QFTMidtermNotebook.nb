Cell["Subsection 1.2:", "Subsection",
 CellChangeTimes->{{4.0038501990245495`*^9, 
  4.0038502070153656`*^9}},ExpressionUUID->"96905d58-1631-6349-90e2-\
3d7951b9c52a"],

Cell[TextData[{
 "Question \[LongDash] Tadpole integral with a hard cutoff\nEvaluate\n\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["T", "TI"], "\[CapitalLambda]"], "\[LongEqual]", 
         SubscriptBox["\[Integral]", 
          RowBox[{"|", 
            StyleBox["k", "TI"], "|", "<", "\[CapitalLambda]"}]], 
         FractionBox[
          RowBox[{
            SuperscriptBox[
             StyleBox["d", "TI"], "4"], 
            StyleBox["k", "TI"]}], 
          SuperscriptBox[
           RowBox[{"(", 
             RowBox[{"2", "\[Pi]"}], ")"}], "4"]], " ", 
         FractionBox["1", 
          RowBox[{
            SuperscriptBox[
             StyleBox["k", "TI"], "2"], "+", 
            SuperscriptBox[
             StyleBox["m", "TI"], "2"]}]], ",    ", 
         SuperscriptBox[
          StyleBox["m", "TI"], "2"], ">", "0", ","}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "$T_\\Lambda=\\int_{|k|<\\Lambda}\\frac{d^4k}{(2\\pi)^4}\\, \
\\frac{1}{k^2+m^2}, \\qquad m^2>0,$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "03a1d77f-8832-3447-b6d1-f48b138a6ccd"],
 "\n\nexactly, and expand through order ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox["\[CapitalLambda]", "-2"], TraditionalForm], 
     "errors" -> {}, "input" -> "$\\Lambda^{-2}$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "be6c92ce-55ca-6147-92d6-7625006b7d94"],
 ".\n\n1. Reduce to a radial integral\n\nThe propagator depends only on the \
magnitude of the Euclidean momentum $k$. We therefore use four-dimensional \
spherical coordinates:\n\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox[
          StyleBox["d", "TI"], "4"], 
         StyleBox["k", "TI"], "\[LongEqual]", 
         SuperscriptBox[
          StyleBox["k", "TI"], "3"], "\[DifferentialD]", 
         StyleBox["k", "TI"], "\[DifferentialD]", 
         SubscriptBox["\[CapitalOmega]", "3"], "."}], TraditionalForm], 
     "errors" -> {}, "input" -> "$d^4k=k^3\\,dk\\,d\\Omega_3.$", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "cec39927-7237-6143-8be5-e3735017a1f7"],
 "\n\nThe angular integral is the area of the unit three-sphere, ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Integral]", 
         StyleBox["d", "TI"], 
         SubscriptBox["\[CapitalOmega]", "3"], "\[LongEqual]", "2", 
         SuperscriptBox["\[Pi]", "2"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "$\\int d\\Omega_3=2\\pi^2$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "0ff2518d-80cc-6648-8cae-0fc3484f8377"],
 ". Thus\n\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         RowBox[{
           SubscriptBox[
            StyleBox["T", "TI"], "\[CapitalLambda]"], "\[LongEqual]", 
           FractionBox[
            RowBox[{"2", 
              SuperscriptBox["\[Pi]", "2"]}], 
            SuperscriptBox[
             RowBox[{"(", 
               RowBox[{"2", "\[Pi]"}], ")"}], "4"]], 
           SubsuperscriptBox["\[Integral]", "0", "\[CapitalLambda]"], 
           StyleBox["d", "TI"], 
           StyleBox["k", "TI"], " ", 
           FractionBox[
            SuperscriptBox[
             StyleBox["k", "TI"], "3"], 
            RowBox[{
              SuperscriptBox[
               StyleBox["k", "TI"], "2"], "+", 
              SuperscriptBox[
               StyleBox["m", "TI"], "2"]}]], "\[LongEqual]", 
           FractionBox["1", 
            RowBox[{"8", 
              SuperscriptBox["\[Pi]", "2"]}]], 
           SubsuperscriptBox["\[Integral]", "0", "\[CapitalLambda]"], 
           StyleBox["d", "TI"], 
           StyleBox["k", "TI"], " ", 
           FractionBox[
            SuperscriptBox[
             StyleBox["k", "TI"], "3"], 
            RowBox[{
              SuperscriptBox[
               StyleBox["k", "TI"], "2"], "+", 
              SuperscriptBox[
               StyleBox["m", "TI"], "2"]}]], "."}], 
         RowBox[{
           StyleBox["B", "TI"], "-", "03"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "$\\boxed{ T_\\Lambda =\\frac{2\\pi^2}{(2\\pi)^4} \\int_0^\\Lambda dk\\,\
\\frac{k^3}{k^2+m^2} =\\frac{1}{8\\pi^2}\\int_0^\\Lambda dk\\, \
\\frac{k^3}{k^2+m^2}. }       \\tag{B-03}$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "7554699c-3a4f-484b-bc1c-4567552c50df"],
 "\n\nThe cutoff restricts the magnitude of the full four-dimensional \
Euclidean momentum, not each component separately. We use ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["d", "TI"], "\[LongEqual]", "4"}], TraditionalForm], 
     "errors" -> {}, "input" -> "$d=4$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d3d93ca9-926c-474d-8127-384f16c715e1"],
 ", with no DR factor $\\mu^\\epsilon$.\n\n2. Evaluate the integral\n\nSet ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["u", "TI"], "\[LongEqual]", 
         SuperscriptBox[
          StyleBox["k", "TI"], "2"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "$u=k^2$, so $k^3dk=\\tfrac12u\\,du$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "1351ff21-f950-5f4b-9bc8-b9c1d8c58032"],
 ". Then\n\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["T", "TI"], "\[CapitalLambda]"], "\[LongEqual]", 
         FractionBox["1", 
          RowBox[{"16", 
            SuperscriptBox["\[Pi]", "2"]}]], 
         SubsuperscriptBox["\[Integral]", "0", 
          SuperscriptBox["\[CapitalLambda]", "2"]], 
         StyleBox["d", "TI"], 
         StyleBox["u", "TI"], " ", 
         FractionBox[
          StyleBox["u", "TI"], 
          RowBox[{
            StyleBox["u", "TI"], "+", 
            SuperscriptBox[
             StyleBox["m", "TI"], "2"]}]], "."}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "$T_\\Lambda =\\frac{1}{16\\pi^2}\\int_0^{\\Lambda^2}du\\, \
\\frac{u}{u+m^2}.$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e87d4dde-1ca0-1649-b0ba-8860a020a70d"],
 "\n\nSplitting the integrand as\n\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         FractionBox[
          StyleBox["u", "TI"], 
          RowBox[{
            StyleBox["u", "TI"], "+", 
            SuperscriptBox[
             StyleBox["m", "TI"], "2"]}]], "\[LongEqual]", "1", "-", 
         FractionBox[
          SuperscriptBox[
           StyleBox["m", "TI"], "2"], 
          RowBox[{
            StyleBox["u", "TI"], "+", 
            SuperscriptBox[
             StyleBox["m", "TI"], "2"]}]]}], TraditionalForm], "errors" -> {},
      "input" -> "$\\frac{u}{u+m^2}=1-\\frac{m^2}{u+m^2}$", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "7318e7a0-0c21-7444-b2fe-86b7ab66dbd9"],
 "\n\ngives\n\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["T", "TI"], "\[CapitalLambda]"], "\[LongEqual]", 
         FractionBox["1", 
          RowBox[{"16", 
            SuperscriptBox["\[Pi]", "2"]}]], 
         SubsuperscriptBox[
          RowBox[{"[", 
            RowBox[{
              StyleBox["u", "TI"], "-", 
              SuperscriptBox[
               StyleBox["m", "TI"], "2"], "ln", 
              RowBox[{"(", 
                RowBox[{
                  StyleBox["u", "TI"], "+", 
                  SuperscriptBox[
                   StyleBox["m", "TI"], "2"]}], ")"}]}], "]"}], "0", 
          SuperscriptBox["\[CapitalLambda]", "2"]], "."}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "$T_\\Lambda =\\frac{1}{16\\pi^2} \
\\left[u-m^2\\ln(u+m^2)\\right]_{0}^{\\Lambda^2}.$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "c68792df-f72b-5640-acec-dc53dfc99eec"],
 "\n\nConsequently, the exact result is\n\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         RowBox[{
           SubscriptBox[
            StyleBox["T", "TI"], "\[CapitalLambda]"], "\[LongEqual]", 
           FractionBox["1", 
            RowBox[{"16", 
              SuperscriptBox["\[Pi]", "2"]}]], 
           RowBox[{"[", 
             RowBox[{
               SuperscriptBox["\[CapitalLambda]", "2"], "-", 
               SuperscriptBox[
                StyleBox["m", "TI"], "2"], "ln", 
               RowBox[{"(", 
                 RowBox[{"1", "+", 
                   FractionBox[
                    SuperscriptBox["\[CapitalLambda]", "2"], 
                    SuperscriptBox[
                    StyleBox["m", "TI"], "2"]]}], ")"}]}], "]"}], "."}], 
         RowBox[{
           StyleBox["B", "TI"], "-", "04"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "$\\boxed{ T_\\Lambda =\\frac{1}{16\\pi^2} \\left[ \
\\Lambda^2-m^2\\ln\\left(1+\\frac{\\Lambda^2}{m^2}\\right) \\right]. } \
\\tag{B-04}$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "df2527f7-f0b3-fe4b-8c20-082379b2dbb2"],
 "\n3. Expand for a large cutoff\n\nFor fixed ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox[
          StyleBox["m", "TI"], "2"], ">", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "$m^2>0$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "43bb1808-2a72-3d44-96db-1ba9f385b295"],
 " and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox["\[CapitalLambda]", "2"], "\[GreaterGreater]", 
         SuperscriptBox[
          StyleBox["m", "TI"], "2"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "$\\Lambda^2\\gg m^2$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f09606e7-c288-c245-99cb-43ae55c57300"],
 ", write\n\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"ln", 
         RowBox[{"(", 
           RowBox[{"1", "+", 
             FractionBox[
              SuperscriptBox["\[CapitalLambda]", "2"], 
              SuperscriptBox[
               StyleBox["m", "TI"], "2"]]}], ")"}], "\[LongEqual]", "ln", 
         FractionBox[
          SuperscriptBox["\[CapitalLambda]", "2"], 
          SuperscriptBox[
           StyleBox["m", "TI"], "2"]], "+", "ln", 
         RowBox[{"(", 
           RowBox[{"1", "+", 
             FractionBox[
              SuperscriptBox[
               StyleBox["m", "TI"], "2"], 
              SuperscriptBox["\[CapitalLambda]", "2"]]}], ")"}], "."}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "$\\ln\\left(1+\\frac{\\Lambda^2}{m^2}\\right) \
=\\ln\\frac{\\Lambda^2}{m^2} +\\ln\\left(1+\\frac{m^2}{\\Lambda^2}\\right).$",
      "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f2c4010a-81e7-1143-b758-ce95bfbf87de"],
 "\n\nUsing ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"ln", 
         RowBox[{"(", 
           RowBox[{"1", "+", 
             StyleBox["x", "TI"]}], ")"}], "\[LongEqual]", 
         StyleBox["x", "TI"], "+", 
         StyleBox["O", "TI"], 
         RowBox[{"(", 
           SuperscriptBox[
            StyleBox["x", "TI"], "2"], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> "$\\ln(1+x)=x+O(x^2)$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f7342b42-f444-2c43-8a38-4e3563e05481"],
 ", we obtain\n\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         RowBox[{
           SubscriptBox[
            StyleBox["T", "TI"], "\[CapitalLambda]"], "\[LongEqual]", 
           FractionBox["1", 
            RowBox[{"16", 
              SuperscriptBox["\[Pi]", "2"]}]], 
           RowBox[{"[", 
             RowBox[{
               SuperscriptBox["\[CapitalLambda]", "2"], "-", 
               SuperscriptBox[
                StyleBox["m", "TI"], "2"], "ln", 
               FractionBox[
                SuperscriptBox["\[CapitalLambda]", "2"], 
                SuperscriptBox[
                 StyleBox["m", "TI"], "2"]], "-", 
               FractionBox[
                SuperscriptBox[
                 StyleBox["m", "TI"], "4"], 
                SuperscriptBox["\[CapitalLambda]", "2"]], "+", 
               StyleBox["O", "TI"], "\[NegativeThinSpace]", 
               RowBox[{"(", 
                 FractionBox[
                  SuperscriptBox[
                   StyleBox["m", "TI"], "6"], 
                  SuperscriptBox["\[CapitalLambda]", "4"]], ")"}]}], "]"}], 
           "."}], 
         RowBox[{
           StyleBox["B", "TI"], "-", "05"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "$\\boxed{ T_\\Lambda =\\frac{1}{16\\pi^2} \\left[ \\Lambda^2 \
-m^2\\ln\\frac{\\Lambda^2}{m^2} -\\frac{m^4}{\\Lambda^2} \
+O\\!\\left(\\frac{m^6}{\\Lambda^4}\\right) \\right]. } \\tag{B-05}$", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "6d1ef54f-0b4a-b444-bfab-4748f3653be0"],
 "\n\nThe first term is a quadratic divergence, the second is a \
mass-dependent logarithmic divergence, and the third vanishes as the cutoff \
is removed. Every term has mass dimension two, as required for ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["T", "TI"], "\[CapitalLambda]"], TraditionalForm], 
     "errors" -> {}, "input" -> "$T_\\Lambda$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "05b663d0-abd8-fe4b-8e21-e826ace246fa"],
 ".\n\nBelow, the derivation of  ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["B", "TI"], "-", "04"}], TraditionalForm], "errors" -> {}, 
     "input" -> "$\\tag{B-04}$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "c36f42e3-24c1-5d48-9aa5-89081e0a182a"],
 " and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["B", "TI"], "-", "05"}], TraditionalForm], "errors" -> {}, 
     "input" -> "$\\tag{B-05}$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "1c738af6-01a2-a747-bea5-fc13b5a6517f"],
 " have been confirmed by Mathematica."
}], "Text",
 CellChangeTimes->{
  4.004081754065401*^9, {4.00408202849329*^9, 4.004082091842678*^9}, {
   4.0040821233951244`*^9, 4.0040822152632904`*^9}, {4.004083970662445*^9, 
   4.0040840578965473`*^9}, 
   4.00408486100712*^9},ExpressionUUID->"d8cd0dc9-94bb-3c44-8b41-\
720373cc9c03"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Clear", "[", 
    RowBox[{
    "kRad", ",", "massSq", ",", "cutoff", ",", "tExact", ",", "tExpected"}], 
    "]"}], ";"}], "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{"Evaluate", " ", "the", " ", "radial", " ", "integral"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"tExact", "=", 
    RowBox[{"FullSimplify", "[", 
     RowBox[{
      RowBox[{"Integrate", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"kRad", "^", "3"}], "/", 
         RowBox[{"(", 
          RowBox[{"8", " ", 
           RowBox[{"Pi", "^", "2"}], " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"kRad", "^", "2"}], "+", "massSq"}], ")"}]}], ")"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"kRad", ",", "0", ",", "cutoff"}], "}"}], ",", 
        RowBox[{"Assumptions", "->", 
         RowBox[{
          RowBox[{"massSq", ">", "0"}], "&&", 
          RowBox[{"cutoff", ">", "0"}]}]}]}], "]"}], ",", 
      RowBox[{"Assumptions", "->", 
       RowBox[{
        RowBox[{"massSq", ">", "0"}], "&&", 
        RowBox[{"cutoff", ">", "0"}]}]}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{"Our", " ", "analytically", " ", "derived", " ", "answer"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"tExpected", "=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"cutoff", "^", "2"}], "-", 
       RowBox[{"massSq", " ", 
        RowBox[{"Log", "[", 
         RowBox[{"1", "+", 
          RowBox[{
           RowBox[{"cutoff", "^", "2"}], "/", "massSq"}]}], "]"}]}]}], ")"}], 
     "/", 
     RowBox[{"(", 
      RowBox[{"16", " ", 
       RowBox[{"Pi", "^", "2"}]}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
  "\n", 
  RowBox[{"(*", 
   RowBox[{
   "Display", " ", "both", " ", "expressions", " ", "and", " ", "compare", " ",
     "them"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{"{", 
  RowBox[{"tExact", ",", "tExpected", ",", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{"tExact", "-", "tExpected"}], ",", 
     RowBox[{"Assumptions", "->", 
      RowBox[{
       RowBox[{"massSq", ">", "0"}], "&&", 
       RowBox[{"cutoff", ">", "0"}]}]}]}], "]"}]}], "}"}]}], "Input",
 CellChangeTimes->{{4.00408375888731*^9, 4.00408375888731*^9}},
 CellLabel->"In[5]:=",ExpressionUUID->"e9d1b65d-bd78-5742-8c92-4cfdd2264efe"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   FractionBox[
    RowBox[{
     SuperscriptBox["cutoff", "2"], "+", 
     RowBox[{"massSq", " ", 
      RowBox[{"Log", "[", 
       FractionBox["massSq", 
        RowBox[{
         SuperscriptBox["cutoff", "2"], "+", "massSq"}]], "]"}]}]}], 
    RowBox[{"16", " ", 
     SuperscriptBox["\[Pi]", "2"]}]], ",", 
   FractionBox[
    RowBox[{
     SuperscriptBox["cutoff", "2"], "-", 
     RowBox[{"massSq", " ", 
      RowBox[{"Log", "[", 
       RowBox[{"1", "+", 
        FractionBox[
         SuperscriptBox["cutoff", "2"], "massSq"]}], "]"}]}]}], 
    RowBox[{"16", " ", 
     SuperscriptBox["\[Pi]", "2"]}]], ",", "0"}], "}"}]], "Output",
 CellChangeTimes->{4.0040837601602917`*^9},
 CellLabel->"Out[8]=",ExpressionUUID->"fe0c50c2-066b-7f4e-a75e-d2b642710ff3"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Clear", "[", 
    RowBox[{
    "massSq", ",", "cutoff", ",", "tExpected", ",", "tSeries", ",", 
     "tTruncated"}], "]"}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"tExpected", "=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"cutoff", "^", "2"}], "-", 
       RowBox[{"massSq", " ", 
        RowBox[{"Log", "[", 
         RowBox[{"1", "+", 
          RowBox[{
           RowBox[{"cutoff", "^", "2"}], "/", "massSq"}]}], "]"}]}]}], ")"}], 
     "/", 
     RowBox[{"(", 
      RowBox[{"16", " ", 
       RowBox[{"Pi", "^", "2"}]}], ")"}]}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"tSeries", "=", 
    RowBox[{"FullSimplify", "[", 
     RowBox[{
      RowBox[{"Series", "[", 
       RowBox[{"tExpected", ",", 
        RowBox[{"{", 
         RowBox[{"cutoff", ",", "Infinity", ",", "2"}], "}"}]}], "]"}], ",", 
      RowBox[{"Assumptions", "->", 
       RowBox[{
        RowBox[{"massSq", ">", "0"}], "&&", 
        RowBox[{"cutoff", ">", "0"}]}]}]}], "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"tTruncated", "=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"cutoff", "^", "2"}], "-", 
       RowBox[{"massSq", " ", 
        RowBox[{"Log", "[", 
         RowBox[{
          RowBox[{"cutoff", "^", "2"}], "/", "massSq"}], "]"}]}], "-", 
       RowBox[{
        RowBox[{"massSq", "^", "2"}], "/", 
        RowBox[{"cutoff", "^", "2"}]}]}], ")"}], "/", 
     RowBox[{"(", 
      RowBox[{"16", " ", 
       RowBox[{"Pi", "^", "2"}]}], ")"}]}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{"{", 
  RowBox[{"tSeries", ",", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Normal", "[", "tSeries", "]"}], "-", "tTruncated"}], ",", 
     RowBox[{"Assumptions", "->", 
      RowBox[{
       RowBox[{"massSq", ">", "0"}], "&&", 
       RowBox[{"cutoff", ">", "0"}]}]}]}], "]"}]}], "}"}]}], "Input",
 CellChangeTimes->{{4.0040839520594006`*^9, 4.0040839520594006`*^9}},
 CellLabel->"In[9]:=",ExpressionUUID->"00cbfc04-407f-1240-9bae-1ec024220398"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   InterpretationBox[
    RowBox[{
     FractionBox[
      SuperscriptBox["cutoff", "2"], 
      RowBox[{"16", " ", 
       SuperscriptBox["\[Pi]", "2"]}]], "+", 
     FractionBox[
      RowBox[{"massSq", " ", 
       RowBox[{"Log", "[", 
        FractionBox["massSq", 
         SuperscriptBox["cutoff", "2"]], "]"}]}], 
      RowBox[{"16", " ", 
       SuperscriptBox["\[Pi]", "2"]}]], "-", 
     FractionBox[
      SuperscriptBox["massSq", "2"], 
      RowBox[{"16", " ", 
       SuperscriptBox["\[Pi]", "2"], " ", 
       SuperscriptBox["cutoff", "2"]}]], "+", 
     InterpretationBox[
      SuperscriptBox[
       RowBox[{"O", "[", 
        FractionBox["1", "cutoff"], "]"}], "3"],
      SeriesData[$CellContext`cutoff, 
       DirectedInfinity[1], {}, -2, 3, 1],
      Editable->False]}],
    SeriesData[$CellContext`cutoff, 
     DirectedInfinity[1], {
     Rational[1, 16] Pi^(-2), 0, Rational[1, 16] $CellContext`massSq Pi^(-2) 
      Log[$CellContext`cutoff^(-2) $CellContext`massSq], 0, 
      Rational[-1, 16] $CellContext`massSq^2 Pi^(-2)}, -2, 3, 1],
    Editable->False], ",", "0"}], "}"}]], "Output",
 CellChangeTimes->{4.0040839532175255`*^9},
 CellLabel->"Out[13]=",ExpressionUUID->"12b60e91-f66d-2246-b24f-dd388c9e5191"]
}, Open  ]],

Cell[TextData[{
 "Question \[LongDash] Tadpole integral in dimensional regularization\n\n\
Evaluate ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["T", "TI"], 
        StyleBox["DR", FontSlant -> "Plain"]], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "$T_{\\mathrm{DR}}$ for $d=4-\\epsilon$, including one $\\mu^\\epsilon$ \
per loop, through the finite $O(\\epsilon^0)$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "0781c90f-50ba-d641-8de4-b39cf98e89d7"],
 " term.\n\nThe Lecture Notes give the Euclidean integral identity (13.7), at \
page 114:\n\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         RowBox[{"\[Integral]", 
           FractionBox[
            RowBox[{
              SuperscriptBox[
               StyleBox["d", "TI"], 
               StyleBox["d", "TI"]], 
              StyleBox["k", "TI"]}], 
            SuperscriptBox[
             RowBox[{"(", 
               RowBox[{"2", "\[Pi]"}], ")"}], 
             StyleBox["d", "TI"]]], 
           FractionBox["1", 
            SuperscriptBox[
             RowBox[{"(", 
               RowBox[{
                 SuperscriptBox[
                  StyleBox["k", "TI"], "2"], "+", 
                 SuperscriptBox[
                  StyleBox["m", "TI"], "2"]}], ")"}], "\[Alpha]"]], 
           "\[LongEqual]", 
           FractionBox[
            SuperscriptBox[
             RowBox[{"(", 
               SuperscriptBox[
                StyleBox["m", "TI"], "2"], ")"}], 
             RowBox[{
               StyleBox["d", "TI"], "/", "2", "-", "\[Alpha]"}]], 
            SuperscriptBox[
             RowBox[{"(", 
               RowBox[{"4", "\[Pi]"}], ")"}], 
             RowBox[{
               StyleBox["d", "TI"], "/", "2"}]]], 
           FractionBox[
            RowBox[{"\[CapitalGamma]", "(", 
              RowBox[{"\[Alpha]", "-", 
                StyleBox["d", "TI"], "/", "2"}], ")"}], 
            RowBox[{"\[CapitalGamma]", "(", "\[Alpha]", ")"}]], "."}], 
         RowBox[{
           StyleBox["B", "TI"], "-", "06"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "$\\boxed{ \\int\\frac{d^d k}{(2\\pi)^d}\\frac{1}{(k^2+m^2)^\\alpha} = \
\\frac{(m^2)^{d/2-\\alpha}}{(4\\pi)^{d/2}} \
\\frac{\\Gamma(\\alpha-d/2)}{\\Gamma(\\alpha)}. } \\tag{B-06}$", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "2e7b5d64-92bb-9048-bea2-cdb48bfb7a8f"],
 "\n\nSetting ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Alpha]", "\[LongEqual]", "1"}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "$\\alpha=1$, multiplying by $\\mu^\\epsilon$, and substituting \
$d=4-\\epsilon$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f1ca1f8a-8865-d64e-8a95-2cf828f50f5b"],
 " yields\n\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         RowBox[{
           SubscriptBox[
            StyleBox["T", "TI"], 
            StyleBox["DR", FontSlant -> "Plain"]], "\[LongEqual]", 
           FractionBox[
            RowBox[{
              SuperscriptBox["\[Mu]", "\[Epsilon]"], 
              SuperscriptBox[
               RowBox[{"(", 
                 SuperscriptBox[
                  StyleBox["m", "TI"], "2"], ")"}], 
               RowBox[{
                 StyleBox["d", "TI"], "/", "2", "-", "1"}]]}], 
            SuperscriptBox[
             RowBox[{"(", 
               RowBox[{"4", "\[Pi]"}], ")"}], 
             RowBox[{
               StyleBox["d", "TI"], "/", "2"}]]], "\[CapitalGamma]", 
           "\[NegativeThinSpace]", 
           RowBox[{"(", 
             RowBox[{"1", "-", 
               FractionBox[
                StyleBox["d", "TI"], "2"]}], ")"}], "\[LongEqual]", 
           FractionBox[
            SuperscriptBox[
             StyleBox["m", "TI"], "2"], 
            RowBox[{"16", 
              SuperscriptBox["\[Pi]", "2"]}]], 
           SuperscriptBox[
            RowBox[{"(", 
              FractionBox[
               RowBox[{"4", 
                 SuperscriptBox["\[Pi]\[Mu]", "2"]}], 
               SuperscriptBox[
                StyleBox["m", "TI"], "2"]], ")"}], 
            RowBox[{"\[Epsilon]", "/", "2"}]], "\[CapitalGamma]", 
           "\[NegativeThinSpace]", 
           RowBox[{"(", 
             RowBox[{"-1", "+", 
               FractionBox["\[Epsilon]", "2"]}], ")"}], "."}], 
         RowBox[{
           StyleBox["B", "TI"], "-", "07"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\boxed{ T_{\\mathrm{DR}} \
=\\frac{\\mu^\\epsilon(m^2)^{d/2-1}}{(4\\pi)^{d/2}} \\Gamma\\!\\left(1-\\frac \
d2\\right) =\\frac{m^2}{16\\pi^2} \
\\left(\\frac{4\\pi\\mu^2}{m^2}\\right)^{\\epsilon/2} \
\\Gamma\\!\\left(-1+\\frac{\\epsilon}{2}\\right). } \\tag{B-07}", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "3418cf20-2d08-c849-a600-09718726d42a"],
 "\n\nUsing\n\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[CapitalGamma]", "\[NegativeThinSpace]", 
         RowBox[{"(", 
           RowBox[{"-1", "+", 
             FractionBox["\[Epsilon]", "2"]}], ")"}], "\[LongEqual]", "-", 
         FractionBox["2", "\[Epsilon]"], "+", 
         SubscriptBox["\[Gamma]", 
          StyleBox["E", "TI"]], "-", "1", "+", 
         StyleBox["O", "TI"], 
         RowBox[{"(", "\[Epsilon]", ")"}], ",    ", 
         SuperscriptBox[
          StyleBox["X", "TI"], 
          RowBox[{"\[Epsilon]", "/", "2"}]], "\[LongEqual]", "1", "+", 
         FractionBox["\[Epsilon]", "2"], "ln", 
         StyleBox["X", "TI"], "+", 
         StyleBox["O", "TI"], 
         RowBox[{"(", 
           SuperscriptBox["\[Epsilon]", "2"], ")"}], ","}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "$\\Gamma\\!\\left(-1+\\frac{\\epsilon}{2}\\right) \
=-\\frac{2}{\\epsilon}+\\gamma_E-1+O(\\epsilon), \\qquad \
X^{\\epsilon/2}=1+\\frac{\\epsilon}{2}\\ln X+O(\\epsilon^2),$", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "919d32a3-c73e-ef4c-a8d3-2c52fc7d9526"],
 "\n\nwe obtain\n\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         RowBox[{
           SubscriptBox[
            StyleBox["T", "TI"], 
            StyleBox["DR", FontSlant -> "Plain"]], "\[LongEqual]", 
           FractionBox[
            SuperscriptBox[
             StyleBox["m", "TI"], "2"], 
            RowBox[{"16", 
              SuperscriptBox["\[Pi]", "2"]}]], 
           RowBox[{"[", 
             RowBox[{"-", 
               FractionBox["2", "\[Epsilon]"], "+", 
               SubscriptBox["\[Gamma]", 
                StyleBox["E", "TI"]], "-", "1", "-", "ln", 
               FractionBox[
                RowBox[{"4", 
                  SuperscriptBox["\[Pi]\[Mu]", "2"]}], 
                SuperscriptBox[
                 StyleBox["m", "TI"], "2"]]}], "]"}], "+", 
           StyleBox["O", "TI"], 
           RowBox[{"(", "\[Epsilon]", ")"}], "."}], 
         RowBox[{
           StyleBox["B", "TI"], "-", "08"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "$\\boxed{ T_{\\mathrm{DR}} =\\frac{m^2}{16\\pi^2} \\left[ \
-\\frac{2}{\\epsilon} +\\gamma_E-1 -\\ln\\frac{4\\pi\\mu^2}{m^2} \
\\right]+O(\\epsilon). } \\tag{B-08}$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e3cdf8cd-562d-264f-adf5-c02f6470100d"],
 "\n\nThe UV divergence appears as a ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"1", "/", "\[Epsilon]"}], TraditionalForm], "errors" -> {}, 
     "input" -> "$1/\\epsilon$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f0571b60-7146-c443-b69a-138b702cdb72"],
 " pole; there is no explicit quadratic-cutoff term. We retain ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["\[Gamma]", 
        StyleBox["E", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "$\\gamma_E$ and $\\ln(4\\pi)$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "abeec85b-6664-d144-aa7a-a650ac4fd7a2"],
 ", since no ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       OverscriptBox[
        StyleBox["MS", FontSlant -> "Plain"], "_"], TraditionalForm], 
     "errors" -> {}, "input" -> "$\\overline{\\mathrm{MS}}$", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "11c13527-521c-7e4f-a2d8-34b04c6ffc08"],
 " scale redefinition has been made.\nThe code below, verifies our derivation:"
}], "Text",
 CellChangeTimes->{{4.004085377296583*^9, 4.0040854444359856`*^9}, {
   4.0040854908758774`*^9, 4.0040855660755157`*^9}, {4.004085615794527*^9, 
   4.004085633406975*^9}, 4.004087676721876*^9, 4.004088219120779*^9, {
   4.004088697294571*^9, 
   4.0040887200596104`*^9}},ExpressionUUID->"ff9e2449-8a6d-9444-a62d-\
ef9a4892e41c"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Clear", "[", 
    RowBox[{
    "dimDR", ",", "epsDR", ",", "massSq", ",", "muScale", ",", "tDRFromNotes",
      ",", "tDRExpected", ",", "tDRSeries", ",", "tDRFinite"}], "]"}], ";"}], 
  "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"B", "-", 
      RowBox[{"06", " ", "with", " ", "alpha"}]}], "=", "1"}], ",", 
    RowBox[{"including", " ", "one", " ", 
     RowBox[{"mu", "^", "epsilon"}]}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"tDRFromNotes", "=", 
    RowBox[{
     RowBox[{"muScale", "^", "epsDR"}], " ", 
     RowBox[{
      RowBox[{"massSq", "^", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"dimDR", "/", "2"}], "-", "1"}], ")"}]}], "/", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"4", " ", "Pi"}], ")"}], "^", 
       RowBox[{"(", 
        RowBox[{"dimDR", "/", "2"}], ")"}]}]}], " ", 
     RowBox[{"Gamma", "[", 
      RowBox[{"1", "-", 
       RowBox[{"dimDR", "/", "2"}]}], "]"}]}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"tDRFromNotes", "=", 
    RowBox[{"tDRFromNotes", "/.", " ", 
     RowBox[{"dimDR", "->", 
      RowBox[{"4", "-", "epsDR"}]}]}]}], ";"}], "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"B", "-", "07"}], ":", 
    RowBox[{"rearranged", " ", "exact", " ", "expression"}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"tDRExpected", "=", 
    RowBox[{
     RowBox[{"massSq", "/", 
      RowBox[{"(", 
       RowBox[{"16", " ", 
        RowBox[{"Pi", "^", "2"}]}], ")"}]}], "*", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"4", " ", "Pi", " ", 
        RowBox[{
         RowBox[{"muScale", "^", "2"}], "/", "massSq"}]}], ")"}], "^", 
      RowBox[{"(", 
       RowBox[{"epsDR", "/", "2"}], ")"}]}], "*", 
     RowBox[{"Gamma", "[", 
      RowBox[{
       RowBox[{"-", "1"}], "+", 
       RowBox[{"epsDR", "/", "2"}]}], "]"}]}]}], ";"}], "\[IndentingNewLine]",
   "\n", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"B", "-", "08"}], ":", 
    RowBox[{
    "Laurent", " ", "expansion", " ", "through", " ", "the", " ", "finite", " ",
      "term"}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"tDRSeries", "=", 
    RowBox[{"FullSimplify", "[", 
     RowBox[{
      RowBox[{"Series", "[", 
       RowBox[{"tDRExpected", ",", 
        RowBox[{"{", 
         RowBox[{"epsDR", ",", "0", ",", "0"}], "}"}]}], "]"}], ",", 
      RowBox[{"Assumptions", "->", 
       RowBox[{
        RowBox[{"massSq", ">", "0"}], "&&", 
        RowBox[{"muScale", ">", "0"}]}]}]}], "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"tDRFinite", "=", 
    RowBox[{
     RowBox[{"massSq", "/", 
      RowBox[{"(", 
       RowBox[{"16", " ", 
        RowBox[{"Pi", "^", "2"}]}], ")"}]}], "*", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"-", "2"}], "/", "epsDR"}], "+", "EulerGamma", "-", "1", "-", 
       RowBox[{"Log", "[", 
        RowBox[{"4", " ", "Pi", " ", 
         RowBox[{
          RowBox[{"muScale", "^", "2"}], "/", "massSq"}]}], "]"}]}], 
      ")"}]}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{"Column", "[", 
  RowBox[{"{", 
   RowBox[{"\"\<Exact-expression difference (expected: 0)\>\"", ",", 
    RowBox[{"FullSimplify", "[", 
     RowBox[{
      RowBox[{"tDRFromNotes", "-", "tDRExpected"}], ",", 
      RowBox[{"Assumptions", "->", 
       RowBox[{
        RowBox[{"massSq", ">", "0"}], "&&", 
        RowBox[{"muScale", ">", "0"}], "&&", 
        RowBox[{"Element", "[", 
         RowBox[{"epsDR", ",", "Reals"}], "]"}]}]}]}], "]"}], 
    ",", "\"\<Laurent expansion\>\"", ",", "tDRSeries", 
    ",", "\"\<Expansion difference (expected: 0)\>\"", ",", 
    RowBox[{"FullSimplify", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Normal", "[", "tDRSeries", "]"}], "-", "tDRFinite"}], ",", 
      RowBox[{"Assumptions", "->", 
       RowBox[{
        RowBox[{"massSq", ">", "0"}], "&&", 
        RowBox[{"muScale", ">", "0"}]}]}]}], "]"}]}], "}"}], "]"}]}], "Input",
 CellChangeTimes->{{4.0040887277414074`*^9, 4.0040887277414074`*^9}},
 CellLabel->"In[14]:=",ExpressionUUID->"a342e39d-47e1-3b46-a16b-e98fafbcf9a7"],

Cell[BoxData[
 TagBox[GridBox[{
    {"\<\"Exact-expression difference (expected: 0)\"\>"},
    {"0"},
    {"\<\"Laurent expansion\"\>"},
    {
     InterpretationBox[
      RowBox[{
       RowBox[{"-", 
        FractionBox["massSq", 
         RowBox[{"8", " ", 
          SuperscriptBox["\[Pi]", "2"], " ", "epsDR"}]]}], "+", 
       FractionBox[
        RowBox[{"massSq", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", "1"}], "+", "EulerGamma", "-", 
           RowBox[{"Log", "[", 
            FractionBox[
             RowBox[{"4", " ", 
              SuperscriptBox["muScale", "2"], " ", "\[Pi]"}], "massSq"], 
            "]"}]}], ")"}]}], 
        RowBox[{"16", " ", 
         SuperscriptBox["\[Pi]", "2"]}]], "+", 
       InterpretationBox[
        SuperscriptBox[
         RowBox[{"O", "[", "epsDR", "]"}], "1"],
        SeriesData[$CellContext`epsDR, 0, {}, -1, 1, 1],
        Editable->False]}],
      SeriesData[$CellContext`epsDR, 0, {
       Rational[-1, 8] $CellContext`massSq Pi^(-2), 
        Rational[1, 16] $CellContext`massSq 
        Pi^(-2) (-1 + EulerGamma - Log[
         4 $CellContext`massSq^(-1) $CellContext`muScale^2 Pi])}, -1, 1, 1],
      Editable->False]},
    {"\<\"Expansion difference (expected: 0)\"\>"},
    {"0"}
   },
   DefaultBaseStyle->"Column",
   GridBoxAlignment->{"Columns" -> {{Left}}},
   GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}],
  "Column"]], "Output",
 CellChangeTimes->{4.004088728361555*^9},
 CellLabel->"Out[20]=",ExpressionUUID->"74de1d54-c164-9542-8e13-76ae12340042"]
}, Open  ]],

Cell[TextData[{
 "Question \[LongDash] Zero-momentum bubble with a hard cutoff\n\nEvaluate ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["B", "TI"], "\[CapitalLambda]"], "(", "0", ")"}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "$B_\\Lambda(0)$ exactly in $d=4$, expand through order $\\Lambda^{-2}$, \
and verify $B_\\Lambda(0)=-\\partial T_\\Lambda/\\partial m^2$", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "340d8132-64aa-234c-a8bd-ae1b6a5c2021"],
 ".\n\nAt zero external momentum, the two propagators have the same \
denominator. Using the four-dimensional angular integral $2\\pi^2$,\n\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         RowBox[{
           SubscriptBox[
            StyleBox["B", "TI"], "\[CapitalLambda]"], 
           RowBox[{"(", "0", ")"}], "\[LongEqual]", 
           SubscriptBox["\[Integral]", 
            RowBox[{"|", 
              StyleBox["k", "TI"], "|", "<", "\[CapitalLambda]"}]], 
           FractionBox[
            RowBox[{
              SuperscriptBox[
               StyleBox["d", "TI"], "4"], 
              StyleBox["k", "TI"]}], 
            SuperscriptBox[
             RowBox[{"(", 
               RowBox[{"2", "\[Pi]"}], ")"}], "4"]], 
           FractionBox["1", 
            SuperscriptBox[
             RowBox[{"(", 
               RowBox[{
                 SuperscriptBox[
                  StyleBox["k", "TI"], "2"], "+", 
                 SuperscriptBox[
                  StyleBox["m", "TI"], "2"]}], ")"}], "2"]], "\[LongEqual]", 
           FractionBox["1", 
            RowBox[{"8", 
              SuperscriptBox["\[Pi]", "2"]}]], 
           SubsuperscriptBox["\[Integral]", "0", "\[CapitalLambda]"], 
           StyleBox["d", "TI"], 
           StyleBox["k", "TI"], " ", 
           FractionBox[
            SuperscriptBox[
             StyleBox["k", "TI"], "3"], 
            SuperscriptBox[
             RowBox[{"(", 
               RowBox[{
                 SuperscriptBox[
                  StyleBox["k", "TI"], "2"], "+", 
                 SuperscriptBox[
                  StyleBox["m", "TI"], "2"]}], ")"}], "2"]], "."}], 
         RowBox[{
           StyleBox["B", "TI"], "-", "09"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "$\\boxed{ B_\\Lambda(0) =\\int_{|k|<\\Lambda}\\frac{d^4k}{(2\\pi)^4} \
\\frac{1}{(k^2+m^2)^2} =\\frac{1}{8\\pi^2}\\int_0^\\Lambda dk\\, \
\\frac{k^3}{(k^2+m^2)^2}. } \\tag{B-09}$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "757ac287-305b-7148-82d4-bb72a96de54c"],
 "\n\nSet ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["u", "TI"], "\[LongEqual]", 
         SuperscriptBox[
          StyleBox["k", "TI"], "2"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "$u=k^2$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "729c46f0-fca8-f04a-b59b-c8d2d1cd9701"],
 ", so $k^3dk=\\tfrac12u\\,du$. Then split the integrand:\n\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["B", "TI"], "\[CapitalLambda]"], 
         RowBox[{"(", "0", ")"}], "\[LongEqual]", 
         FractionBox["1", 
          RowBox[{"16", 
            SuperscriptBox["\[Pi]", "2"]}]], 
         SubsuperscriptBox["\[Integral]", "0", 
          SuperscriptBox["\[CapitalLambda]", "2"]], 
         StyleBox["d", "TI"], 
         StyleBox["u", "TI"], " ", 
         FractionBox[
          StyleBox["u", "TI"], 
          SuperscriptBox[
           RowBox[{"(", 
             RowBox[{
               StyleBox["u", "TI"], "+", 
               SuperscriptBox[
                StyleBox["m", "TI"], "2"]}], ")"}], "2"]], ",    ", 
         FractionBox[
          StyleBox["u", "TI"], 
          SuperscriptBox[
           RowBox[{"(", 
             RowBox[{
               StyleBox["u", "TI"], "+", 
               SuperscriptBox[
                StyleBox["m", "TI"], "2"]}], ")"}], "2"]], "\[LongEqual]", 
         FractionBox["1", 
          RowBox[{
            StyleBox["u", "TI"], "+", 
            SuperscriptBox[
             StyleBox["m", "TI"], "2"]}]], "-", 
         FractionBox[
          SuperscriptBox[
           StyleBox["m", "TI"], "2"], 
          SuperscriptBox[
           RowBox[{"(", 
             RowBox[{
               StyleBox["u", "TI"], "+", 
               SuperscriptBox[
                StyleBox["m", "TI"], "2"]}], ")"}], "2"]], "."}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "$B_\\Lambda(0) =\\frac{1}{16\\pi^2}\\int_0^{\\Lambda^2}du\\, \
\\frac{u}{(u+m^2)^2}, \\qquad \\frac{u}{(u+m^2)^2} \
=\\frac{1}{u+m^2}-\\frac{m^2}{(u+m^2)^2}.$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "4f73bf98-693e-f349-8a5d-41416373765d"],
 "\n\nIntegrating gives\n\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         RowBox[{
           SubscriptBox[
            StyleBox["B", "TI"], "\[CapitalLambda]"], 
           RowBox[{"(", "0", ")"}], "\[LongEqual]", 
           FractionBox["1", 
            RowBox[{"16", 
              SuperscriptBox["\[Pi]", "2"]}]], 
           RowBox[{"[", 
             RowBox[{"ln", 
               RowBox[{"(", 
                 RowBox[{"1", "+", 
                   FractionBox[
                    SuperscriptBox["\[CapitalLambda]", "2"], 
                    SuperscriptBox[
                    StyleBox["m", "TI"], "2"]]}], ")"}], "-", 
               FractionBox[
                SuperscriptBox["\[CapitalLambda]", "2"], 
                RowBox[{
                  SuperscriptBox["\[CapitalLambda]", "2"], "+", 
                  SuperscriptBox[
                   StyleBox["m", "TI"], "2"]}]]}], "]"}], "."}], 
         RowBox[{
           StyleBox["B", "TI"], "-", "10"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "$\\boxed{ B_\\Lambda(0) =\\frac{1}{16\\pi^2} \\left[ \
\\ln\\left(1+\\frac{\\Lambda^2}{m^2}\\right) \
-\\frac{\\Lambda^2}{\\Lambda^2+m^2} \\right]. } \\tag{B-10}$", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "0cb17bcb-c99b-d248-8bec-9d2a1b63c2cd"],
 "\n\nFor ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox["\[CapitalLambda]", "2"], "\[GreaterGreater]", 
         SuperscriptBox[
          StyleBox["m", "TI"], "2"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "$\\Lambda^2\\gg m^2$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ec95c186-c965-6e46-aaf2-ecaecb531865"],
 ", expand the logarithm and rational term:\n\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         RowBox[{
           SubscriptBox[
            StyleBox["B", "TI"], "\[CapitalLambda]"], 
           RowBox[{"(", "0", ")"}], "\[LongEqual]", 
           FractionBox["1", 
            RowBox[{"16", 
              SuperscriptBox["\[Pi]", "2"]}]], 
           RowBox[{"[", 
             RowBox[{"ln", 
               FractionBox[
                SuperscriptBox["\[CapitalLambda]", "2"], 
                SuperscriptBox[
                 StyleBox["m", "TI"], "2"]], "-", "1", "+", 
               FractionBox[
                RowBox[{"2", 
                  SuperscriptBox[
                   StyleBox["m", "TI"], "2"]}], 
                SuperscriptBox["\[CapitalLambda]", "2"]], "+", 
               StyleBox["O", "TI"], "\[NegativeThinSpace]", 
               RowBox[{"(", 
                 FractionBox[
                  SuperscriptBox[
                   StyleBox["m", "TI"], "4"], 
                  SuperscriptBox["\[CapitalLambda]", "4"]], ")"}]}], "]"}], 
           "."}], 
         RowBox[{
           StyleBox["B", "TI"], "-", "11"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "$\\boxed{ B_\\Lambda(0) =\\frac{1}{16\\pi^2} \\left[ \
\\ln\\frac{\\Lambda^2}{m^2}-1 +\\frac{2m^2}{\\Lambda^2} \
+O\\!\\left(\\frac{m^4}{\\Lambda^4}\\right) \\right]. } \\tag{B-11}$", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ee7ad248-0c4e-c146-a21e-6f75d97c58e2"],
 "\n\nUnlike the tadpole, the bubble has only a logarithmic divergence. It is \
dimensionless, consistent with the measure contributing four powers of \
momentum and the two propagators contributing minus four.\nFrom B-04,\n\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["T", "TI"], "\[CapitalLambda]"], "\[LongEqual]", 
         FractionBox["1", 
          RowBox[{"16", 
            SuperscriptBox["\[Pi]", "2"]}]], 
         RowBox[{"[", 
           RowBox[{
             SuperscriptBox["\[CapitalLambda]", "2"], "-", 
             SuperscriptBox[
              StyleBox["m", "TI"], "2"], "ln", 
             RowBox[{"(", 
               RowBox[{"1", "+", 
                 FractionBox[
                  SuperscriptBox["\[CapitalLambda]", "2"], 
                  SuperscriptBox[
                   StyleBox["m", "TI"], "2"]]}], ")"}]}], "]"}], "."}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "$T_\\Lambda=\\frac{1}{16\\pi^2} \
\\left[\\Lambda^2-m^2\\ln\\left(1+\\frac{\\Lambda^2}{m^2}\\right)\\right].$", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e3b50bb2-1919-ea43-8f0b-23b539e2eba5"],
 "\n\nDifferentiating with respect to ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox[
        StyleBox["m", "TI"], "2"], TraditionalForm], "errors" -> {}, "input" -> 
     "$m^2$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e485d351-96dd-104e-bfab-06fcb7182792"],
 ", holding ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[CapitalLambda]", TraditionalForm], "errors" -> {}, 
     "input" -> "$\\Lambda$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b6308c25-735f-4a43-b167-7a14036ef6e1"],
 " fixed, gives\n\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"-", 
         FractionBox[
          RowBox[{"\[PartialD]", 
            SubscriptBox[
             StyleBox["T", "TI"], "\[CapitalLambda]"]}], 
          RowBox[{"\[PartialD]", 
            SuperscriptBox[
             StyleBox["m", "TI"], "2"]}]], "\[LongEqual]", 
         FractionBox["1", 
          RowBox[{"16", 
            SuperscriptBox["\[Pi]", "2"]}]], 
         RowBox[{"[", 
           RowBox[{"ln", 
             RowBox[{"(", 
               RowBox[{"1", "+", 
                 FractionBox[
                  SuperscriptBox["\[CapitalLambda]", "2"], 
                  SuperscriptBox[
                   StyleBox["m", "TI"], "2"]]}], ")"}], "-", 
             FractionBox[
              SuperscriptBox["\[CapitalLambda]", "2"], 
              RowBox[{
                SuperscriptBox["\[CapitalLambda]", "2"], "+", 
                SuperscriptBox[
                 StyleBox["m", "TI"], "2"]}]]}], "]"}], "."}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "$-\\frac{\\partial T_\\Lambda}{\\partial m^2} =\\frac{1}{16\\pi^2} \
\\left[ \\ln\\left(1+\\frac{\\Lambda^2}{m^2}\\right) \
-\\frac{\\Lambda^2}{\\Lambda^2+m^2} \\right].$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f0837869-af1c-5f4e-a741-fc40d8ab3ed7"],
 "\n\nThis is precisely the independently evaluated bubble integral in B-10. \
Therefore,\n\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         RowBox[{
           SubscriptBox[
            StyleBox["B", "TI"], "\[CapitalLambda]"], 
           RowBox[{"(", "0", ")"}], "\[LongEqual]", "-", 
           FractionBox[
            RowBox[{"\[PartialD]", 
              SubscriptBox[
               StyleBox["T", "TI"], "\[CapitalLambda]"]}], 
            RowBox[{"\[PartialD]", 
              SuperscriptBox[
               StyleBox["m", "TI"], "2"]}]], "."}], 
         RowBox[{
           StyleBox["B", "TI"], "-", "12"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "$\\boxed{ B_\\Lambda(0)=-\\frac{\\partial T_\\Lambda}{\\partial m^2}. } \
\\tag{B-12}$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "7ecf6d96-81a3-6e4e-afa6-4dd263de5d2f"],
 "\n\nThe identity holds for the exact regularized expressions at finite ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[CapitalLambda]", TraditionalForm], "errors" -> {}, 
     "input" -> "$\\Lambda$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "537e272f-550d-024d-9897-bb02a093986c"],
 ", not just in their large-cutoff expansions.\nThe code below checks and \
confirms our derivations"
}], "Text",
 CellChangeTimes->{{4.0040901649187775`*^9, 4.004090319587681*^9}, 
   4.0040905202144394`*^9, {4.0042743662251587`*^9, 
   4.004274374876129*^9}},ExpressionUUID->"55d9c97a-fc1f-6d45-870a-\
06f315c688e3"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Clear", "[", 
    RowBox[{
    "massSq", ",", " ", "cutoff", ",", " ", "bCutoff", ",", " ", "bSeries", ",",
      " ", "bTruncated"}], "]"}], ";"}], "\n", "\n", 
  RowBox[{"(*", " ", 
   RowBox[{"Exact", " ", "cutoff", " ", 
    RowBox[{"result", ":", " ", 
     RowBox[{"B", "-", "10"}]}]}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"bCutoff", " ", "=", "\n", "  ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"Log", "[", 
        RowBox[{"1", " ", "+", " ", 
         RowBox[{
          RowBox[{"cutoff", "^", "2"}], "/", "massSq"}]}], "]"}], "\n", 
       "     ", "-", " ", 
       RowBox[{
        RowBox[{"cutoff", "^", "2"}], "/", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"cutoff", "^", "2"}], " ", "+", " ", "massSq"}], ")"}]}]}], 
      ")"}], "/", 
     RowBox[{"(", 
      RowBox[{"16", " ", 
       RowBox[{"Pi", "^", "2"}]}], ")"}]}]}], ";"}], "\n", "\n", 
  RowBox[{"(*", " ", 
   RowBox[{"Expand", " ", "through", " ", 
    RowBox[{"1", "/", 
     RowBox[{"cutoff", "^", "2"}]}]}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"bSeries", " ", "=", " ", 
    RowBox[{"FullSimplify", "[", "\n", "   ", 
     RowBox[{
      RowBox[{"Series", "[", 
       RowBox[{"bCutoff", ",", " ", 
        RowBox[{"{", 
         RowBox[{"cutoff", ",", " ", "Infinity", ",", " ", "2"}], "}"}]}], 
       "]"}], ",", "\n", "   ", 
      RowBox[{"Assumptions", " ", "->", " ", 
       RowBox[{
        RowBox[{"massSq", " ", ">", " ", "0"}], " ", "&&", " ", 
        RowBox[{"cutoff", " ", ">", " ", "0"}]}]}]}], "\n", "   ", "]"}]}], 
   ";"}], "\n", "\n", 
  RowBox[{"(*", " ", 
   RowBox[{"Analytically", " ", "derived", " ", 
    RowBox[{"expansion", ":", " ", 
     RowBox[{"B", "-", "11"}]}]}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"bTruncated", " ", "=", "\n", "  ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"Log", "[", 
        RowBox[{
         RowBox[{"cutoff", "^", "2"}], "/", "massSq"}], "]"}], " ", "-", " ", 
       "1", "\n", "     ", "+", " ", 
       RowBox[{"2", " ", 
        RowBox[{"massSq", "/", 
         RowBox[{"cutoff", "^", "2"}]}]}]}], ")"}], "/", 
     RowBox[{"(", 
      RowBox[{"16", " ", 
       RowBox[{"Pi", "^", "2"}]}], ")"}]}]}], ";"}], "\n"}], "\n", 
 RowBox[{"Column", "[", 
  RowBox[{"{", "\n", "  ", 
   RowBox[{"\"\<Large-cutoff expansion:\>\"", ",", "\n", "  ", "bSeries", ",",
     "\n", "  ", "\"\<Difference from B-11 (expected: 0):\>\"", ",", "\n", 
    "  ", 
    RowBox[{"FullSimplify", "[", "\n", "   ", 
     RowBox[{
      RowBox[{
       RowBox[{"Normal", "[", "bSeries", "]"}], " ", "-", " ", "bTruncated"}],
       ",", "\n", "   ", 
      RowBox[{"Assumptions", " ", "->", " ", 
       RowBox[{
        RowBox[{"massSq", " ", ">", " ", "0"}], " ", "&&", " ", 
        RowBox[{"cutoff", " ", ">", " ", "0"}]}]}]}], "\n", "   ", "]"}]}], 
   "\n", "  ", "}"}], "]"}]}], "Input",
 CellChangeTimes->{{4.0040955400637894`*^9, 4.0040955400637894`*^9}},
 CellLabel->"In[26]:=",ExpressionUUID->"4117a2f4-ed43-9b40-98a5-1044c93a13ea"],

Cell[BoxData[
 TagBox[GridBox[{
    {"\<\"Large-cutoff expansion:\"\>"},
    {
     InterpretationBox[
      RowBox[{
       FractionBox[
        RowBox[{
         RowBox[{"-", "1"}], "+", 
         RowBox[{"2", " ", 
          RowBox[{"Log", "[", "cutoff", "]"}]}], "-", 
         RowBox[{"Log", "[", "massSq", "]"}]}], 
        RowBox[{"16", " ", 
         SuperscriptBox["\[Pi]", "2"]}]], "+", 
       FractionBox["massSq", 
        RowBox[{"8", " ", 
         SuperscriptBox["\[Pi]", "2"], " ", 
         SuperscriptBox["cutoff", "2"]}]], "+", 
       InterpretationBox[
        SuperscriptBox[
         RowBox[{"O", "[", 
          FractionBox["1", "cutoff"], "]"}], "3"],
        SeriesData[$CellContext`cutoff, 
         DirectedInfinity[1], {}, 0, 3, 1],
        Editable->False]}],
      SeriesData[$CellContext`cutoff, 
       DirectedInfinity[1], {
       Rational[1, 16] 
        Pi^(-2) (-1 + 2 Log[$CellContext`cutoff] - Log[$CellContext`massSq]), 
        0, Rational[1, 8] $CellContext`massSq Pi^(-2)}, 0, 3, 1],
      Editable->False]},
    {"\<\"Difference from B-11 (expected: 0):\"\>"},
    {"0"}
   },
   DefaultBaseStyle->"Column",
   GridBoxAlignment->{"Columns" -> {{Left}}},
   GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}],
  "Column"]], "Output",
 CellChangeTimes->{4.00409554126803*^9},
 CellLabel->"Out[30]=",ExpressionUUID->"5a3d120f-d274-4d40-af65-868bd814e7a4"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Clear", "[", 
    RowBox[{
    "massSq", ",", "cutoff", ",", "tCutoff", ",", "bCutoff", ",", "minusDT"}],
     "]"}], ";"}], "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{"Exact", " ", "evaluated", " ", 
    RowBox[{"tadpole", ":", 
     RowBox[{"B", "-", "04"}]}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"tCutoff", "=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"cutoff", "^", "2"}], "-", 
       RowBox[{"massSq", " ", 
        RowBox[{"Log", "[", 
         RowBox[{"1", "+", 
          RowBox[{
           RowBox[{"cutoff", "^", "2"}], "/", "massSq"}]}], "]"}]}]}], ")"}], 
     "/", 
     RowBox[{"(", 
      RowBox[{"16", " ", 
       RowBox[{"Pi", "^", "2"}]}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
  "\n", 
  RowBox[{"(*", 
   RowBox[{"Exact", " ", "independently", " ", "evaluated", " ", 
    RowBox[{"bubble", ":", 
     RowBox[{"B", "-", "10"}]}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"bCutoff", "=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"Log", "[", 
        RowBox[{"1", "+", 
         RowBox[{
          RowBox[{"cutoff", "^", "2"}], "/", "massSq"}]}], "]"}], "-", 
       RowBox[{
        RowBox[{"cutoff", "^", "2"}], "/", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"cutoff", "^", "2"}], "+", "massSq"}], ")"}]}]}], ")"}], "/", 
     RowBox[{"(", 
      RowBox[{"16", " ", 
       RowBox[{"Pi", "^", "2"}]}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
  "\n", 
  RowBox[{"(*", 
   RowBox[{"Differentiate", " ", "the", " ", "evaluated", " ", "tadpole"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"minusDT", "=", 
    RowBox[{"FullSimplify", "[", 
     RowBox[{
      RowBox[{"-", 
       RowBox[{"D", "[", 
        RowBox[{"tCutoff", ",", "massSq"}], "]"}]}], ",", 
      RowBox[{"Assumptions", "->", 
       RowBox[{
        RowBox[{"massSq", ">", "0"}], "&&", 
        RowBox[{"cutoff", ">", "0"}]}]}]}], "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{"Column", "[", 
  RowBox[{"{", 
   RowBox[{"\"\<Minus the mass-squared derivative of T:\>\"", ",", "minusDT", 
    ",", "\"\<Difference from B(0) (expected: 0):\>\"", ",", 
    RowBox[{"FullSimplify", "[", 
     RowBox[{
      RowBox[{"minusDT", "-", "bCutoff"}], ",", 
      RowBox[{"Assumptions", "->", 
       RowBox[{
        RowBox[{"massSq", ">", "0"}], "&&", 
        RowBox[{"cutoff", ">", "0"}]}]}]}], "]"}]}], "}"}], "]"}]}], "Input",
 CellChangeTimes->{{4.0040947440077324`*^9, 4.0040947440077324`*^9}},
 CellLabel->"In[21]:=",ExpressionUUID->"e6c457d7-85e1-3c4d-a109-26af3c7a8968"],

Cell[BoxData[
 TagBox[GridBox[{
    {"\<\"Minus the mass-squared derivative of T:\"\>"},
    {
     FractionBox[
      RowBox[{
       RowBox[{"-", 
        SuperscriptBox["cutoff", "2"]}], "+", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          SuperscriptBox["cutoff", "2"], "+", "massSq"}], ")"}], " ", 
        RowBox[{"Log", "[", 
         FractionBox[
          RowBox[{
           SuperscriptBox["cutoff", "2"], "+", "massSq"}], "massSq"], 
         "]"}]}]}], 
      RowBox[{"16", " ", 
       RowBox[{"(", 
        RowBox[{
         SuperscriptBox["cutoff", "2"], "+", "massSq"}], ")"}], " ", 
       SuperscriptBox["\[Pi]", "2"]}]]},
    {"\<\"Difference from B(0) (expected: 0):\"\>"},
    {"0"}
   },
   DefaultBaseStyle->"Column",
   GridBoxAlignment->{"Columns" -> {{Left}}},
   GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}],
  "Column"]], "Output",
 CellChangeTimes->{4.004094745283619*^9},
 CellLabel->"Out[25]=",ExpressionUUID->"c7c44f34-7ac7-e542-b88b-a38f4185103d"]
}, Open  ]],

Cell[TextData[{
 "Question \[LongDash] Zero-momentum bubble in dimensional regularization\n\n\
Evaluate ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["B", "TI"], 
          StyleBox["DR", FontSlant -> "Plain"]], "(", "0", ")"}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "$B_{\\mathrm{DR}}(0)$ through the finite term for $d=4-\\epsilon$, then \
verify $B(0)=-\\partial T/\\partial m^2$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "5ff54a47-c5b3-a14b-afdf-d098e560b353"],
 " using the evaluated DR expressions.\n\n1. Evaluate the bubble\n\nApply the \
Fields Notes identity (13.7), quoted as B-06, with ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Alpha]", "\[LongEqual]", "2"}], TraditionalForm], 
     "errors" -> {}, "input" -> "$\\alpha=2$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "3178faab-c128-ae4b-a83c-4b4c1730272d"],
 ". Including one ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox["\[Mu]", "\[Epsilon]"], TraditionalForm], 
     "errors" -> {}, "input" -> "$\\mu^\\epsilon$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "483a429e-c1ff-134f-9bfb-f4c0c4774809"],
 " per loop gives\n\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         RowBox[{
           SubscriptBox[
            StyleBox["B", "TI"], 
            StyleBox["DR", FontSlant -> "Plain"]], 
           RowBox[{"(", "0", ")"}], "\[LongEqual]", 
           FractionBox[
            RowBox[{
              SuperscriptBox["\[Mu]", "\[Epsilon]"], 
              SuperscriptBox[
               RowBox[{"(", 
                 SuperscriptBox[
                  StyleBox["m", "TI"], "2"], ")"}], 
               RowBox[{
                 StyleBox["d", "TI"], "/", "2", "-", "2"}]]}], 
            SuperscriptBox[
             RowBox[{"(", 
               RowBox[{"4", "\[Pi]"}], ")"}], 
             RowBox[{
               StyleBox["d", "TI"], "/", "2"}]]], "\[CapitalGamma]", 
           "\[NegativeThinSpace]", 
           RowBox[{"(", 
             RowBox[{"2", "-", 
               FractionBox[
                StyleBox["d", "TI"], "2"]}], ")"}], "\[LongEqual]", 
           FractionBox["1", 
            RowBox[{"16", 
              SuperscriptBox["\[Pi]", "2"]}]], 
           SuperscriptBox[
            RowBox[{"(", 
              FractionBox[
               RowBox[{"4", 
                 SuperscriptBox["\[Pi]\[Mu]", "2"]}], 
               SuperscriptBox[
                StyleBox["m", "TI"], "2"]], ")"}], 
            RowBox[{"\[Epsilon]", "/", "2"}]], "\[CapitalGamma]", 
           "\[NegativeThinSpace]", 
           RowBox[{"(", 
             FractionBox["\[Epsilon]", "2"], ")"}], "."}], 
         RowBox[{
           StyleBox["B", "TI"], "-", "13"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "$\\boxed{ B_{\\mathrm{DR}}(0) \
=\\frac{\\mu^\\epsilon(m^2)^{d/2-2}}{(4\\pi)^{d/2}} \\Gamma\\!\\left(2-\\frac \
d2\\right) =\\frac{1}{16\\pi^2} \
\\left(\\frac{4\\pi\\mu^2}{m^2}\\right)^{\\epsilon/2} \
\\Gamma\\!\\left(\\frac{\\epsilon}{2}\\right). } \\tag{B-13}$", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "784165ba-7eef-1747-b6e5-84557db3eabb"],
 "\n\nHere ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[CapitalGamma]", 
         RowBox[{"(", "2", ")"}], "\[LongEqual]", "1"}], TraditionalForm], 
     "errors" -> {}, "input" -> "$\\Gamma(2)=1$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "57ddabf3-cae4-144f-ba2f-64cfaceab4d1"],
 ".\n\nUsing\n\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[CapitalGamma]", "\[NegativeThinSpace]", 
         RowBox[{"(", 
           FractionBox["\[Epsilon]", "2"], ")"}], "\[LongEqual]", 
         FractionBox["2", "\[Epsilon]"], "-", 
         SubscriptBox["\[Gamma]", 
          StyleBox["E", "TI"]], "+", 
         StyleBox["O", "TI"], 
         RowBox[{"(", "\[Epsilon]", ")"}], ","}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "$\\Gamma\\!\\left(\\frac{\\epsilon}{2}\\right) \
=\\frac{2}{\\epsilon}-\\gamma_E+O(\\epsilon),$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "7363bea7-63e1-5442-97bc-d589f05e8189"],
 "\n\nand expanding the scale factor as before, we obtain\n\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         RowBox[{
           SubscriptBox[
            StyleBox["B", "TI"], 
            StyleBox["DR", FontSlant -> "Plain"]], 
           RowBox[{"(", "0", ")"}], "\[LongEqual]", 
           FractionBox["1", 
            RowBox[{"16", 
              SuperscriptBox["\[Pi]", "2"]}]], 
           RowBox[{"[", 
             RowBox[{
               FractionBox["2", "\[Epsilon]"], "-", 
               SubscriptBox["\[Gamma]", 
                StyleBox["E", "TI"]], "+", "ln", 
               FractionBox[
                RowBox[{"4", 
                  SuperscriptBox["\[Pi]\[Mu]", "2"]}], 
                SuperscriptBox[
                 StyleBox["m", "TI"], "2"]]}], "]"}], "+", 
           StyleBox["O", "TI"], 
           RowBox[{"(", "\[Epsilon]", ")"}], "."}], 
         RowBox[{
           StyleBox["B", "TI"], "-", "14"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "$\\boxed{ B_{\\mathrm{DR}}(0) =\\frac{1}{16\\pi^2} \\left[ \
\\frac{2}{\\epsilon}-\\gamma_E +\\ln\\frac{4\\pi\\mu^2}{m^2} \
\\right]+O(\\epsilon). } \\tag{B-14}$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f85beab7-9295-2044-806a-4d5359189683"],
 "\n\nThe ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"1", "/", "\[Epsilon]"}], TraditionalForm], "errors" -> {}, 
     "input" -> "$1/\\epsilon$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d78ecf76-5009-fd4f-b96c-4a747831bce4"],
 " pole represents the bubble\[CloseCurlyQuote]s logarithmic UV divergence.\n\
\n2. Verify the derivative identity using the exact DR results\n\nStarting \
from the evaluated tadpole B-07, differentiate at fixed $\\mu$ and $d$:\n\n$",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"-", 
         FractionBox[
          RowBox[{"\[PartialD]", 
            SubscriptBox[
             StyleBox["T", "TI"], 
             StyleBox["DR", FontSlant -> "Plain"]]}], 
          RowBox[{"\[PartialD]", 
            SuperscriptBox[
             StyleBox["m", "TI"], "2"]}]], "\[LongEqual]", 
         FractionBox[
          RowBox[{
            SuperscriptBox["\[Mu]", "\[Epsilon]"], 
            SuperscriptBox[
             RowBox[{"(", 
               SuperscriptBox[
                StyleBox["m", "TI"], "2"], ")"}], 
             RowBox[{
               StyleBox["d", "TI"], "/", "2", "-", "2"}]]}], 
          SuperscriptBox[
           RowBox[{"(", 
             RowBox[{"4", "\[Pi]"}], ")"}], 
           RowBox[{
             StyleBox["d", "TI"], "/", "2"}]]], 
         RowBox[{"(", 
           RowBox[{"1", "-", 
             FractionBox[
              StyleBox["d", "TI"], "2"]}], ")"}], "\[CapitalGamma]", 
         "\[NegativeThinSpace]", 
         RowBox[{"(", 
           RowBox[{"1", "-", 
             FractionBox[
              StyleBox["d", "TI"], "2"]}], ")"}], "."}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "$-\\frac{\\partial T_{\\mathrm{DR}}}{\\partial m^2} = \
\\frac{\\mu^\\epsilon(m^2)^{d/2-2}}{(4\\pi)^{d/2}} \\left(1-\\frac d2\\right) \
\\Gamma\\!\\left(1-\\frac d2\\right).$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "5661b528-a2b7-ce45-b0bc-06bd0c77e32e"],
 "\n\nThe gamma-function recurrence ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[CapitalGamma]", 
         RowBox[{"(", 
           RowBox[{
             StyleBox["z", "TI"], "+", "1"}], ")"}], "\[LongEqual]", 
         StyleBox["z", "TI"], "\[CapitalGamma]", 
         RowBox[{"(", 
           StyleBox["z", "TI"], ")"}]}], TraditionalForm], "errors" -> {}, 
     "input" -> "$\\Gamma(z+1)=z\\Gamma(z)$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b4a9d27c-7cfe-ab47-b6a8-95befa102f8b"],
 " gives\n\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         RowBox[{"(", 
           RowBox[{"1", "-", 
             FractionBox[
              StyleBox["d", "TI"], "2"]}], ")"}], "\[CapitalGamma]", 
         "\[NegativeThinSpace]", 
         RowBox[{"(", 
           RowBox[{"1", "-", 
             FractionBox[
              StyleBox["d", "TI"], "2"]}], ")"}], "\[LongEqual]", 
         "\[CapitalGamma]", "\[NegativeThinSpace]", 
         RowBox[{"(", 
           RowBox[{"2", "-", 
             FractionBox[
              StyleBox["d", "TI"], "2"]}], ")"}], "."}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "$\\left(1-\\frac d2\\right)\\Gamma\\!\\left(1-\\frac d2\\right) \
=\\Gamma\\!\\left(2-\\frac d2\\right).$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "4e96992f-9b23-a24f-8758-8523d72e578b"],
 "\n\nComparing with B-13 therefore proves\n\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         RowBox[{"-", 
           FractionBox[
            RowBox[{"\[PartialD]", 
              SubscriptBox[
               StyleBox["T", "TI"], 
               StyleBox["DR", FontSlant -> "Plain"]]}], 
            RowBox[{"\[PartialD]", 
              SuperscriptBox[
               StyleBox["m", "TI"], "2"]}]], "\[LongEqual]", 
           FractionBox[
            RowBox[{
              SuperscriptBox["\[Mu]", "\[Epsilon]"], 
              SuperscriptBox[
               RowBox[{"(", 
                 SuperscriptBox[
                  StyleBox["m", "TI"], "2"], ")"}], 
               RowBox[{
                 StyleBox["d", "TI"], "/", "2", "-", "2"}]]}], 
            SuperscriptBox[
             RowBox[{"(", 
               RowBox[{"4", "\[Pi]"}], ")"}], 
             RowBox[{
               StyleBox["d", "TI"], "/", "2"}]]], "\[CapitalGamma]", 
           "\[NegativeThinSpace]", 
           RowBox[{"(", 
             RowBox[{"2", "-", 
               FractionBox[
                StyleBox["d", "TI"], "2"]}], ")"}], "\[LongEqual]", 
           SubscriptBox[
            StyleBox["B", "TI"], 
            StyleBox["DR", FontSlant -> "Plain"]], 
           RowBox[{"(", "0", ")"}], "."}], 
         RowBox[{
           StyleBox["B", "TI"], "-", "15"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "$\\boxed{ -\\frac{\\partial T_{\\mathrm{DR}}}{\\partial m^2} = \
\\frac{\\mu^\\epsilon(m^2)^{d/2-2}}{(4\\pi)^{d/2}} \\Gamma\\!\\left(2-\\frac \
d2\\right) =B_{\\mathrm{DR}}(0). } \\tag{B-15}$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "5c2329e4-7078-2d43-b13c-072d56795226"],
 "\n\nThis is the DR counterpart of B-12, established from the evaluated \
regularized integrals.\n\nAs a check through the finite term, differentiating \
B-08 yields\n\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"-", 
         FractionBox["\[PartialD]", 
          RowBox[{"\[PartialD]", 
            SuperscriptBox[
             StyleBox["m", "TI"], "2"]}]], 
         RowBox[{"{", 
           RowBox[{
             FractionBox[
              SuperscriptBox[
               StyleBox["m", "TI"], "2"], 
              RowBox[{"16", 
                SuperscriptBox["\[Pi]", "2"]}]], 
             RowBox[{"[", 
               RowBox[{"-", 
                 FractionBox["2", "\[Epsilon]"], "+", 
                 SubscriptBox["\[Gamma]", 
                  StyleBox["E", "TI"]], "-", "1", "-", "ln", 
                 FractionBox[
                  RowBox[{"4", 
                    SuperscriptBox["\[Pi]\[Mu]", "2"]}], 
                  SuperscriptBox[
                   StyleBox["m", "TI"], "2"]]}], "]"}]}], "}"}], 
         "\[LongEqual]", 
         FractionBox["1", 
          RowBox[{"16", 
            SuperscriptBox["\[Pi]", "2"]}]], 
         RowBox[{"[", 
           RowBox[{
             FractionBox["2", "\[Epsilon]"], "-", 
             SubscriptBox["\[Gamma]", 
              StyleBox["E", "TI"]], "+", "ln", 
             FractionBox[
              RowBox[{"4", 
                SuperscriptBox["\[Pi]\[Mu]", "2"]}], 
              SuperscriptBox[
               StyleBox["m", "TI"], "2"]]}], "]"}], ","}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "$-\\frac{\\partial}{\\partial m^2} \\left\\{ \\frac{m^2}{16\\pi^2} \
\\left[-\\frac{2}{\\epsilon}+\\gamma_E-1 \
-\\ln\\frac{4\\pi\\mu^2}{m^2}\\right] \\right\\} = \\frac{1}{16\\pi^2} \
\\left[\\frac{2}{\\epsilon}-\\gamma_E \
+\\ln\\frac{4\\pi\\mu^2}{m^2}\\right],$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "bf7e752c-2e2e-8747-9e02-b9a797fa22c0"],
 "\n\nwhich agrees with B-14. The constant $-1$ in the tadpole cancels \
against the term produced by differentiating its logarithm.\nThe derivation \
is checked in the code below."
}], "Text",
 CellChangeTimes->{{4.0040840859848022`*^9, 4.0040840888032436`*^9}, {
   4.004088714377079*^9, 4.0040887150499325`*^9}, 4.0040947416196575`*^9, {
   4.004095984340822*^9, 4.004096127608652*^9}, {4.004274347672304*^9, 
   4.004274361935137*^9}},ExpressionUUID->"0e9a1caf-4e29-b941-a0de-\
4b3b80d7b059"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Clear", "[", 
    RowBox[{
    "dimDR", ",", "epsDR", ",", "massSq", ",", "muScale", ",", "bFromNotes", ",",
      "bDRExact", ",", "bDRSeries", ",", "bDRFinite"}], "]"}], ";"}], 
  "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Fields", " ", "Notes", " ", 
     RowBox[{"Eq", ".", 
      RowBox[{"(", "13.7", ")"}]}]}], ",", 
    RowBox[{"alpha", "=", "2"}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"bFromNotes", "=", 
    RowBox[{
     RowBox[{"muScale", "^", "epsDR"}], " ", 
     RowBox[{
      RowBox[{"massSq", "^", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"dimDR", "/", "2"}], "-", "2"}], ")"}]}], "/", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"4", " ", "Pi"}], ")"}], "^", 
       RowBox[{"(", 
        RowBox[{"dimDR", "/", "2"}], ")"}]}]}], "*", 
     RowBox[{
      RowBox[{"Gamma", "[", 
       RowBox[{"2", "-", 
        RowBox[{"dimDR", "/", "2"}]}], "]"}], "/", 
      RowBox[{"Gamma", "[", "2", "]"}]}]}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"bFromNotes", "=", 
    RowBox[{"bFromNotes", "/.", " ", 
     RowBox[{"dimDR", "->", 
      RowBox[{"4", "-", "epsDR"}]}]}]}], ";"}], "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{"B", "-", "13"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"bDRExact", "=", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{"4", " ", "Pi", " ", 
        RowBox[{
         RowBox[{"muScale", "^", "2"}], "/", "massSq"}]}], ")"}], "^", 
      RowBox[{"(", 
       RowBox[{"epsDR", "/", "2"}], ")"}]}], "*", 
     RowBox[{
      RowBox[{"Gamma", "[", 
       RowBox[{"epsDR", "/", "2"}], "]"}], "/", 
      RowBox[{"(", 
       RowBox[{"16", " ", 
        RowBox[{"Pi", "^", "2"}]}], ")"}]}]}]}], ";"}], "\[IndentingNewLine]",
   "\n", 
  RowBox[{"(*", 
   RowBox[{"Expand", " ", "through", " ", "the", " ", "finite", " ", "term"}],
    "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"bDRSeries", "=", 
    RowBox[{"FullSimplify", "[", 
     RowBox[{
      RowBox[{"Series", "[", 
       RowBox[{"bDRExact", ",", 
        RowBox[{"{", 
         RowBox[{"epsDR", ",", "0", ",", "0"}], "}"}]}], "]"}], ",", 
      RowBox[{"Assumptions", "->", 
       RowBox[{
        RowBox[{"massSq", ">", "0"}], "&&", 
        RowBox[{"muScale", ">", "0"}]}]}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{"B", "-", "14"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"bDRFinite", "=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"2", "/", "epsDR"}], "-", "EulerGamma", "+", 
       RowBox[{"Log", "[", 
        RowBox[{"4", " ", "Pi", " ", 
         RowBox[{
          RowBox[{"muScale", "^", "2"}], "/", "massSq"}]}], "]"}]}], ")"}], "/", 
     RowBox[{"(", 
      RowBox[{"16", " ", 
       RowBox[{"Pi", "^", "2"}]}], ")"}]}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{"Column", "[", 
  RowBox[{"{", 
   RowBox[{"\"\<Exact-expression difference (expected: 0):\>\"", ",", 
    RowBox[{"FullSimplify", "[", 
     RowBox[{
      RowBox[{"bFromNotes", "-", "bDRExact"}], ",", 
      RowBox[{"Assumptions", "->", 
       RowBox[{
        RowBox[{"massSq", ">", "0"}], "&&", 
        RowBox[{"muScale", ">", "0"}], "&&", 
        RowBox[{"Element", "[", 
         RowBox[{"epsDR", ",", "Reals"}], "]"}]}]}]}], "]"}], 
    ",", "\"\<Laurent expansion:\>\"", ",", "bDRSeries", 
    ",", "\"\<Expansion difference (expected: 0):\>\"", ",", 
    RowBox[{"FullSimplify", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Normal", "[", "bDRSeries", "]"}], "-", "bDRFinite"}], ",", 
      RowBox[{"Assumptions", "->", 
       RowBox[{
        RowBox[{"massSq", ">", "0"}], "&&", 
        RowBox[{"muScale", ">", "0"}]}]}]}], "]"}]}], "}"}], "]"}]}], "Input",
 CellChangeTimes->{{4.0040965273909225`*^9, 4.0040965273909225`*^9}},
 CellLabel->"In[37]:=",ExpressionUUID->"2819a0f5-acf8-cf41-9023-dfe0901365eb"],

Cell[BoxData[
 TagBox[GridBox[{
    {"\<\"Exact-expression difference (expected: 0):\"\>"},
    {"0"},
    {"\<\"Laurent expansion:\"\>"},
    {
     InterpretationBox[
      RowBox[{
       FractionBox["1", 
        RowBox[{"8", " ", 
         SuperscriptBox["\[Pi]", "2"], " ", "epsDR"}]], "+", 
       FractionBox[
        RowBox[{
         RowBox[{"-", "EulerGamma"}], "+", 
         RowBox[{"Log", "[", 
          FractionBox[
           RowBox[{"4", " ", 
            SuperscriptBox["muScale", "2"], " ", "\[Pi]"}], "massSq"], 
          "]"}]}], 
        RowBox[{"16", " ", 
         SuperscriptBox["\[Pi]", "2"]}]], "+", 
       InterpretationBox[
        SuperscriptBox[
         RowBox[{"O", "[", "epsDR", "]"}], "1"],
        SeriesData[$CellContext`epsDR, 0, {}, -1, 1, 1],
        Editable->False]}],
      SeriesData[$CellContext`epsDR, 0, {
       Rational[1, 8] Pi^(-2), Rational[1, 16] 
        Pi^(-2) (-EulerGamma + 
         Log[4 $CellContext`massSq^(-1) $CellContext`muScale^2 Pi])}, -1, 1, 
       1],
      Editable->False]},
    {"\<\"Expansion difference (expected: 0):\"\>"},
    {"0"}
   },
   DefaultBaseStyle->"Column",
   GridBoxAlignment->{"Columns" -> {{Left}}},
   GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}],
