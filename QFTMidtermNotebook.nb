        RowBox[{"Pi", "^", "2"}]}], ")"}]}]}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"tDRFinite", "=", 
    RowBox[{
     RowBox[{"massSq", "/", 
      RowBox[{"(", 
       RowBox[{"16", " ", 
        RowBox[{"Pi", "^", "2"}]}], ")"}]}], "*", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"-", "2"}], "/", "epsDR"}], "+", "EulerGamma", "-", "1", "-", 
       RowBox[{"Log", "[", 
        RowBox[{"4", " ", "Pi", " ", 
         RowBox[{
          RowBox[{"muScale", "^", "2"}], "/", "massSq"}]}], "]"}]}], 
      ")"}]}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"bDRFinite", "=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"2", "/", "epsDR"}], "-", "EulerGamma", "+", 
       RowBox[{"Log", "[", 
        RowBox[{"4", " ", "Pi", " ", 
         RowBox[{
          RowBox[{"muScale", "^", "2"}], "/", "massSq"}]}], "]"}]}], ")"}], "/", 
     RowBox[{"(", 
      RowBox[{"16", " ", 
       RowBox[{"Pi", "^", "2"}]}], ")"}]}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{"Column", "[", 
  RowBox[{"{", 
   RowBox[{"\"\<Exact derivative identity: -dT/d(m^2) - B(0) (expected: 0):\>\
\"", ",", 
    RowBox[{"FullSimplify", "[", 
     RowBox[{
      RowBox[{"FunctionExpand", "[", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{"D", "[", 
          RowBox[{"tDRExact", ",", "massSq"}], "]"}]}], "-", "bDRExact"}], 
       "]"}], ",", 
      RowBox[{"Assumptions", "->", 
       RowBox[{
        RowBox[{"massSq", ">", "0"}], "&&", 
        RowBox[{"muScale", ">", "0"}], "&&", 
        RowBox[{"0", "<", "epsDR", "<", "2"}]}]}]}], "]"}], 
    ",", "\"\<Pole-plus-finite derivative identity (expected: 0):\>\"", ",", 
    RowBox[{"FullSimplify", "[", 
