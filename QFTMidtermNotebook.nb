     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "5386359d-7534-6f43-8cc6-0b1fcf887b6b"],
 "\n\nAfter shifting the integration momentum and applying the DR \
scalar-integral identity, the remaining parameter integral is a beta \
function. The result is\n\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         RowBox[{
           SubscriptBox[
            StyleBox["J", "TI"], 
            RowBox[{"\[Alpha]", ",", "\[Beta]"}]], 
           RowBox[{"(", 
             StyleBox["Q", "TI"], ")"}], "\[LongEqual]", 
           FractionBox[
            SuperscriptBox[
             RowBox[{"(", 
               SuperscriptBox[
                StyleBox["Q", "TI"], "2"], ")"}], 
             RowBox[{
               StyleBox["d", "TI"], "/", "2", "-", "\[Alpha]", "-", 
               "\[Beta]"}]], 
            SuperscriptBox[
             RowBox[{"(", 
               RowBox[{"4", "\[Pi]"}], ")"}], 
             RowBox[{
               StyleBox["d", "TI"], "/", "2"}]]], 
           FractionBox[
            RowBox[{"\[CapitalGamma]", 
              RowBox[{"(", 
                RowBox[{"\[Alpha]", "+", "\[Beta]", "-", 
                  StyleBox["d", "TI"], "/", "2"}], ")"}], "\[CapitalGamma]", 
              RowBox[{"(", 
                RowBox[{
                  StyleBox["d", "TI"], "/", "2", "-", "\[Alpha]"}], ")"}], 
              "\[CapitalGamma]", 
              RowBox[{"(", 
                RowBox[{
                  StyleBox["d", "TI"], "/", "2", "-", "\[Beta]"}], ")"}]}], 
            RowBox[{"\[CapitalGamma]", 
              RowBox[{"(", "\[Alpha]", ")"}], "\[CapitalGamma]", 
              RowBox[{"(", "\[Beta]", ")"}], "\[CapitalGamma]", 
              RowBox[{"(", 
                RowBox[{
                  StyleBox["d", "TI"], "-", "\[Alpha]", "-", "\[Beta]"}], 
                ")"}]}]], "."}], 
         RowBox[{
           StyleBox["B", "TI"], "-", "32"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "$\\boxed{ J_{\\alpha,\\beta}(Q) = \\frac{(Q^2)^{d/2-\\alpha-\\beta}}{(4\
\\pi)^{d/2}} \\frac{ \\Gamma(\\alpha+\\beta-d/2) \\Gamma(d/2-\\alpha) \
\\Gamma(d/2-\\beta) }{ \\Gamma(\\alpha)\\Gamma(\\beta) \
\\Gamma(d-\\alpha-\\beta) }. } \\tag{B-32}$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "7e62031f-97a6-7d42-9afa-5164bafbbdab"],
 "\n\nThis identity is first derived where the integrals converge and then \
analytically continued. No factor ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox["\[Mu]", "\[Epsilon]"], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "$\\mu^\\epsilon$ is included in $J_{\\alpha,\\beta}$", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "3b4a5552-f79a-9649-b5e0-38609b4e0221"],
 "; both loop factors already appear in B-31.\n\n4. First convolution: \
integrate over $\\ell$\n\nAt fixed ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["k", "TI"], TraditionalForm], "errors" -> {}, "input" -> 
     "$k$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f6c86ebf-4011-b042-98bf-76569b42ae14"],
 ", set ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["Q", "TI"], "\[LongEqual]", 
         StyleBox["p", "TI"], "-", 
         StyleBox["k", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "$Q=p-k$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "6ea2e990-c9c1-6c4e-a9dc-d96ef5d6163f"],
 " and use B-32 with ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Alpha]", "\[LongEqual]", "\[Beta]", "\[LongEqual]", "1"}], 
       TraditionalForm], "errors" -> {}, "input" -> "$\\alpha=\\beta=1$", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "38799447-6775-d841-a3ce-75757c58af72"],
 ":\n\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         RowBox[{"\[Integral]", 
           FractionBox[
            RowBox[{
              SuperscriptBox[
               StyleBox["d", "TI"], 
               StyleBox["d", "TI"]], "\[ScriptL]"}], 
            SuperscriptBox[
             RowBox[{"(", 
               RowBox[{"2", "\[Pi]"}], ")"}], 
             StyleBox["d", "TI"]]], 
           FractionBox["1", 
            RowBox[{
              SuperscriptBox["\[ScriptL]", "2"], 
              SuperscriptBox[
               RowBox[{"(", 
                 RowBox[{
                   StyleBox["p", "TI"], "-", 
                   StyleBox["k", "TI"], "-", "\[ScriptL]"}], ")"}], "2"]}]], 
           "\[LongEqual]", 
           FractionBox[
            SuperscriptBox[
             RowBox[{"[", 
               SuperscriptBox[
                RowBox[{"(", 
                  RowBox[{
                    StyleBox["p", "TI"], "-", 
                    StyleBox["k", "TI"]}], ")"}], "2"], "]"}], 
             RowBox[{
               StyleBox["d", "TI"], "/", "2", "-", "2"}]], 
            SuperscriptBox[
             RowBox[{"(", 
               RowBox[{"4", "\[Pi]"}], ")"}], 
             RowBox[{
               StyleBox["d", "TI"], "/", "2"}]]], 
           FractionBox[
            RowBox[{"\[CapitalGamma]", 
              RowBox[{"(", 
                RowBox[{"2", "-", 
                  StyleBox["d", "TI"], "/", "2"}], ")"}], "\[CapitalGamma]", 
              SuperscriptBox[
               RowBox[{"(", 
                 RowBox[{
                   StyleBox["d", "TI"], "/", "2", "-", "1"}], ")"}], "2"]}], 
            RowBox[{"\[CapitalGamma]", "(", 
              RowBox[{
                StyleBox["d", "TI"], "-", "2"}], ")"}]], "."}], 
         RowBox[{
           StyleBox["B", "TI"], "-", "33"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "$\\boxed{ \\int\\frac{d^d\\ell}{(2\\pi)^d} \
\\frac{1}{\\ell^2(p-k-\\ell)^2} = \\frac{[(p-k)^2]^{d/2-2}}{(4\\pi)^{d/2}} \
\\frac{ \\Gamma(2-d/2)\\Gamma(d/2-1)^2 }{ \\Gamma(d-2) }. } \\tag{B-33}$", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "611ee653-7ed0-a843-950d-876be3a66663"],
 "\n\nSubstituting this into ",
