                    StyleBox["p", "TI"], "-", 
                    StyleBox["k", "TI"]}], ")"}], "2"], "]"}], 
             RowBox[{" ", "2", "-", 
               StyleBox["d", "TI"], "/", "2"}]]}]], "."}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "$H(p)= \\frac{\\mu^{2\\epsilon}}{(4\\pi)^{d/2}} \
\\frac{\\Gamma(2-d/2)\\Gamma(d/2-1)^2}{\\Gamma(d-2)} \
\\int\\frac{d^dk}{(2\\pi)^d} \\frac{1}{k^2[(p-k)^2]^{\\,2-d/2}}.$", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b914d861-e74c-0f40-a9a4-004e7a1edcd9"],
 "\n5. Second convolution: integrate over ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["k", "TI"], TraditionalForm], "errors" -> {}, "input" -> 
     "$k$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e500b2bc-26ce-ad41-b7f6-b7274716f42f"],
 "\n\nApply B-32 again, now with\n\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
        "\[Alpha]", "\[LongEqual]", "1", ",    ", "\[Beta]", "\[LongEqual]", 
         "2", "-", 
         FractionBox[
          StyleBox["d", "TI"], "2"], "."}], TraditionalForm], "errors" -> {}, 
     "input" -> "$\\alpha=1,\\qquad \\beta=2-\\frac d2.$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "cf5229cc-4783-2e40-a20f-8eeaeccefd7f"],
 "\n\nThe remaining integral is\n\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         FractionBox[
          SuperscriptBox[
           RowBox[{"(", 
             SuperscriptBox[
              StyleBox["p", "TI"], "2"], ")"}], 
           RowBox[{
             StyleBox["d", "TI"], "-", "3"}]], 
          SuperscriptBox[
           RowBox[{"(", 
             RowBox[{"4", "\[Pi]"}], ")"}], 
           RowBox[{
             StyleBox["d", "TI"], "/", "2"}]]], 
         FractionBox[
          RowBox[{"\[CapitalGamma]", 
            RowBox[{"(", 
              RowBox[{"3", "-", 
                StyleBox["d", "TI"]}], ")"}], "\[CapitalGamma]", 
            RowBox[{"(", 
              RowBox[{
                StyleBox["d", "TI"], "/", "2", "-", "1"}], ")"}], 
            "\[CapitalGamma]", 
            RowBox[{"(", 
              RowBox[{
                StyleBox["d", "TI"], "-", "2"}], ")"}]}], 
          RowBox[{"\[CapitalGamma]", 
            RowBox[{"(", 
              RowBox[{"2", "-", 
                StyleBox["d", "TI"], "/", "2"}], ")"}], "\[CapitalGamma]", 
            RowBox[{"(", 
              RowBox[{"3", 
                StyleBox["d", "TI"], "/", "2", "-", "3"}], ")"}]}]], "."}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "$\\frac{(p^2)^{d-3}}{(4\\pi)^{d/2}} \\frac{ \
\\Gamma(3-d)\\Gamma(d/2-1)\\Gamma(d-2) }{ \\Gamma(2-d/2)\\Gamma(3d/2-3) }.$", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "9cbd1519-578d-634f-8dac-eb2f6ff1da70"],
 "\n\nMultiplying the two convolution factors cancels ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[CapitalGamma]", "(", 
         RowBox[{"2", "-", 
           StyleBox["d", "TI"], "/", "2"}], ")"}], TraditionalForm], 
     "errors" -> {}, "input" -> "$\\Gamma(2-d/2)$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "be12ab67-4383-4a48-959b-8ef734193d85"],
 " and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[CapitalGamma]", "(", 
         RowBox[{
           StyleBox["d", "TI"], "-", "2"}], ")"}], TraditionalForm], 
     "errors" -> {}, "input" -> "$\\Gamma(d-2)$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "4b6af2f8-4381-0247-99dc-351dcaf80930"],
 ", giving\n\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         RowBox[{
           StyleBox["H", "TI"], 
           RowBox[{"(", 
             StyleBox["p", "TI"], ")"}], "\[LongEqual]", 
           FractionBox[
            RowBox[{
              SuperscriptBox["\[Mu]", 
               RowBox[{"2", "\[Epsilon]"}]], 
              SuperscriptBox[
               RowBox[{"(", 
                 SuperscriptBox[
                  StyleBox["p", "TI"], "2"], ")"}], 
               RowBox[{
                 StyleBox["d", "TI"], "-", "3"}]]}], 
            SuperscriptBox[
             RowBox[{"(", 
               RowBox[{"4", "\[Pi]"}], ")"}], 
             StyleBox["d", "TI"]]], 
           FractionBox[
            RowBox[{"\[CapitalGamma]", 
              RowBox[{"(", 
                RowBox[{"3", "-", 
                  StyleBox["d", "TI"]}], ")"}], "\[CapitalGamma]", 
              SuperscriptBox[
               RowBox[{"(", 
                 RowBox[{
                   StyleBox["d", "TI"], "/", "2", "-", "1"}], ")"}], "3"]}], 
            RowBox[{"\[CapitalGamma]", "(", 
              RowBox[{"3", 
                StyleBox["d", "TI"], "/", "2", "-", "3"}], ")"}]], "."}], 
         RowBox[{
           StyleBox["B", "TI"], "-", "34"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "$\\boxed{ H(p)= \\frac{\\mu^{2\\epsilon}(p^2)^{d-3}}{(4\\pi)^d} \\frac{ \
\\Gamma(3-d)\\Gamma(d/2-1)^3 }{ \\Gamma(3d/2-3) }. } \\tag{B-34}$", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "61a79898-aac1-6145-bb4e-322c26d393df"],
 "\n\nWith ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["d", "TI"], "\[LongEqual]", "4", "-", "\[Epsilon]"}], 
       TraditionalForm], "errors" -> {}, "input" -> "$d=4-\\epsilon$", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "18eadb0c-5b66-0b44-af8f-74978285e366"],
 ", this becomes\n\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         RowBox[{
           StyleBox["H", "TI"], 
           RowBox[{"(", 
             StyleBox["p", "TI"], ")"}], "\[LongEqual]", 
           FractionBox[
            SuperscriptBox[
             StyleBox["p", "TI"], "2"], 
