 CellLabel->"In[31]:=",ExpressionUUID->"89d23e21-fc15-af46-8f9c-d0704edbe1e9"],

Cell[BoxData[
 TagBox[GridBox[{
    {"\<\"Exact derivative identity: -dT/d(m^2) - B(0) (expected: 0):\"\>"},
    {"0"},
    {"\<\"Pole-plus-finite derivative identity (expected: 0):\"\>"},
    {"0"}
   },
   DefaultBaseStyle->"Column",
   GridBoxAlignment->{"Columns" -> {{Left}}},
   GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}],
  "Column"]], "Output",
 CellChangeTimes->{4.0040963545349636`*^9},
 CellLabel->"Out[36]=",ExpressionUUID->"05c2627b-ed05-bd4f-b76d-39354ed2efce"]
}, Open  ]],

Cell["\<\
Question | Evaluate T and B(0) using a spherical hard cutoff and dimensional \
regularization, obtain the required expansions, identify divergences, and \
verify B(0) = \[Minus]\[PartialD]T/\[PartialD]m\.b2 in both schemes.

Derivation | In d = 4, angular integration reduces the cutoff integrals to \
elementary radial integrals, yielding exact expressions and expansions \
through \[CapitalLambda]\:207b\.b2. In DR, Fields Notes Eq. (13.7), with \
\[Alpha] = 1 and \[Alpha] = 2, gives the gamma-function expressions; setting \
d = 4 \[Minus] \[CurlyEpsilon] and including one \[Mu]^\[CurlyEpsilon] per \
loop yields their Laurent expansions through the finite term. The evaluated \
expressions satisfy the derivative identity at fixed regulator and scale.

Check | Mathematica confirms the cutoff tadpole result and expansion, the \
cutoff bubble expansion, and the derivative identity in both schemes. The DR \
bubble Laurent expansion and the exact and pole-plus-finite derivative \
comparisons agree with the derivation. The tadpole has quadratic and \
logarithmic cutoff divergences, whereas the bubble has only a logarithmic \
cutoff divergence; in DR near four dimensions, the UV divergences appear as \
1/\[CurlyEpsilon] poles.

Anchor IDs | B-03\[Dash]B-15.

Status |Mathematica Checked\
\>", "Text",
 CellChangeTimes->{
  4.0040976349362297`*^9, {4.004259400109314*^9, 
   4.0042594111152954`*^9}},ExpressionUUID->"4e669049-3022-fb47-b8a6-\
8d59403ded50"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Subsection 1.3", "Subsection",
 CellChangeTimes->{{4.004248330521784*^9, 
  4.0042483348197765`*^9}},ExpressionUUID->"2917eb16-97d9-624c-b063-\
4eff8c03f981"],

Cell[TextData[{
 "Question \[LongDash] DR counterterms from the subtraction conditions\n\n\
Determine the one-loop counterterms in dimensional regularization by imposing\
\n\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         RowBox[{
           SuperscriptBox["\[CapitalGamma]", 
            RowBox[{"(", "2", ")"}]], 
           RowBox[{"(", "0", ")"}], "\[LongEqual]", 
           SuperscriptBox[
            StyleBox["m", "TI"], "2"], ",    ", 
           SubscriptBox[
            RowBox[{
              FractionBox[
               RowBox[{"\[PartialD]", 
                 SuperscriptBox["\[CapitalGamma]", 
                  RowBox[{"(", "2", ")"}]]}], 
               RowBox[{"\[PartialD]", 
                 SuperscriptBox[
                  StyleBox["p", "TI"], "2"]}]], "\[VerticalSeparator]"}], 
            RowBox[{
              SuperscriptBox[
               StyleBox["p", "TI"], "2"], "\[LongEqual]", "0"}]], 
           "\[LongEqual]", "1", ",    ", 
           SuperscriptBox["\[CapitalGamma]", 
            RowBox[{"(", "4", ")"}]], 
           RowBox[{"(", "0", ")"}], "\[LongEqual]", "\[Lambda]", "."}], 
         RowBox[{
           StyleBox["B", "TI"], "-", "16"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "$\\boxed{ \\Gamma^{(2)}(0)=m^2,\\qquad \
\\left.\\frac{\\partial\\Gamma^{(2)}}{\\partial p^2}\\right|_{p^2=0}=1, \
\\qquad \\Gamma^{(4)}(0)=\\lambda. } \\tag{B-16}$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "98032d70-2aad-2e4c-a8d9-b53069476172"],
 "\n\nThese conditions fix both the divergent and finite parts of the \
counterterms.\n\n1. Two-point function: mass and field counterterms\n\nWith \
the Euclidean signs specified in the brief,\n\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox["\[CapitalGamma]", 
          RowBox[{"(", "2", ")"}]], 
         RowBox[{"(", 
           StyleBox["p", "TI"], ")"}], "\[LongEqual]", 
         SuperscriptBox[
          StyleBox["p", "TI"], "2"], "+", 
         SuperscriptBox[
          StyleBox["m", "TI"], "2"], "+", "\[Delta]", 
         SubscriptBox[
          StyleBox["Z", "TI"], "\[Phi]"], " ", 
         SuperscriptBox[
          StyleBox["p", "TI"], "2"], "+", "\[Delta]", 
         SuperscriptBox[
          StyleBox["m", "TI"], "2"], "+", 
         FractionBox["\[Lambda]", "2"], 
         SubscriptBox[
          StyleBox["T", "TI"], 
          StyleBox["DR", FontSlant -> "Plain"]], "."}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "$\\Gamma^{(2)}(p) =p^2+m^2+\\delta Z_\\phi\\,p^2+\\delta m^2 \
+\\frac{\\lambda}{2}T_{\\mathrm{DR}}.$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d441a8c7-98b4-3e4f-9b7c-5503c0b431b0"],
 "\n\nThe tadpole is independent of external momentum. Consequently, \
differentiating with respect to ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox[
        StyleBox["p", "TI"], "2"], TraditionalForm], "errors" -> {}, "input" -> 
     "$p^2$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "1fbba80b-e862-e94c-8a60-c8c6d7e5a323"],
 " gives ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"1", "+", "\[Delta]", 
         SubscriptBox[
          StyleBox["Z", "TI"], "\[Phi]"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "$1+\\delta Z_\\phi$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "417487c6-5caf-ec44-b211-c40c9d70b1e3"],
 ", so the normalization condition requires ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Delta]", 
         SubscriptBox[
          StyleBox["Z", "TI"], "\[Phi]"], "\[LongEqual]", "0"}], 
       TraditionalForm], "errors" -> {}, "input" -> "$\\delta Z_\\phi=0$", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f7c7db26-4e7c-164c-8fc5-88f7d1380893"],
 ". Evaluating the vertex at ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["p", "TI"], "\[LongEqual]", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "$p=0$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "6acd3617-7b64-a445-bd81-9cb81a95c8de"],
 " then requires the mass counterterm to cancel the entire tadpole:\n\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         RowBox[{"\[Delta]", 
           SubsuperscriptBox[
            StyleBox["Z", "TI"], "\[Phi]", 
            RowBox[{"(", "1", ")"}]], "\[LongEqual]", "0", ",    ", 
           "\[Delta]", 
           SubsuperscriptBox[
            StyleBox["m", "TI"], 
            StyleBox["DR", FontSlant -> "Plain"], "2"], "\[LongEqual]", "-", 
           FractionBox["\[Lambda]", "2"], 
           SubscriptBox[
            StyleBox["T", "TI"], 
            StyleBox["DR", FontSlant -> "Plain"]], "\[LongEqual]", 
           FractionBox[
            RowBox[{"\[Lambda]", 
              SuperscriptBox[
               StyleBox["m", "TI"], "2"]}], 
            RowBox[{"32", 
              SuperscriptBox["\[Pi]", "2"]}]], 
           RowBox[{"[", 
             RowBox[{
               FractionBox["2", "\[Epsilon]"], "-", 
               SubscriptBox["\[Gamma]", 
                StyleBox["E", "TI"]], "+", "1", "+", "ln", 
               FractionBox[
                RowBox[{"4", 
                  SuperscriptBox["\[Pi]\[Mu]", "2"]}], 
                SuperscriptBox[
                 StyleBox["m", "TI"], "2"]]}], "]"}], "+", 
           StyleBox["O", "TI"], 
           RowBox[{"(", "\[Epsilon]", ")"}], "."}], 
         RowBox[{
           StyleBox["B", "TI"], "-", "17"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "$\\boxed{ \\delta Z_\\phi^{(1)}=0,\\qquad \\delta \
m_{\\mathrm{DR}}^2=-\\frac{\\lambda}{2}T_{\\mathrm{DR}} =\\frac{\\lambda \
m^2}{32\\pi^2} \\left[ \\frac{2}{\\epsilon}-\\gamma_E+1 \
+\\ln\\frac{4\\pi\\mu^2}{m^2} \\right]+O(\\epsilon). } \\tag{B-17}$", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e387dbdc-31d1-5e4c-a04d-499a74641b1f"],
 "\n\nHere the superscript ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"(", "1", ")"}], TraditionalForm], "errors" -> {}, "input" -> 
     "$(1)$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e25f7bb8-dd32-a941-887e-ff4b7b284c23"],
 " denotes one-loop order; higher-loop corrections are not included.\n\n2. \
Four-point function: coupling counterterm\n\nThe one-loop four-point vertex \
is\n\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox["\[CapitalGamma]", 
          RowBox[{"(", "4", ")"}]], 
         RowBox[{"(", 
           SubscriptBox[
            StyleBox["p", "TI"], 
            StyleBox["i", "TI"]], ")"}], "\[LongEqual]", "\[Lambda]", "+", 
         "\[Delta]\[Lambda]", "-", 
         FractionBox[
          SuperscriptBox["\[Lambda]", "2"], "2"], 
         RowBox[{"[", 
           RowBox[{
             SubscriptBox[
              StyleBox["B", "TI"], 
              StyleBox["DR", FontSlant -> "Plain"]], 
             RowBox[{"(", 
               SubscriptBox[
                StyleBox["P", "TI"], "12"], ")"}], "+", 
             SubscriptBox[
              StyleBox["B", "TI"], 
              StyleBox["DR", FontSlant -> "Plain"]], 
             RowBox[{"(", 
               SubscriptBox[
                StyleBox["P", "TI"], "13"], ")"}], "+", 
             SubscriptBox[
              StyleBox["B", "TI"], 
              StyleBox["DR", FontSlant -> "Plain"]], 
             RowBox[{"(", 
               SubscriptBox[
                StyleBox["P", "TI"], "14"], ")"}]}], "]"}], "."}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "$\\Gamma^{(4)}(p_i) =\\lambda+\\delta\\lambda -\\frac{\\lambda^2}{2} \
\\left[B_{\\mathrm{DR}}(P_{12})+ B_{\\mathrm{DR}}(P_{13})+ \
B_{\\mathrm{DR}}(P_{14})\\right].$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "004aa778-2445-744d-a605-428959003664"],
 "\n\nAt zero external momenta, all three channels equal ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["B", "TI"], 
          StyleBox["DR", FontSlant -> "Plain"]], "(", "0", ")"}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "$B_{\\mathrm{DR}}(0)$. Requiring $\\Gamma^{(4)}(0)=\\lambda$", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "16258bec-0a4b-4640-8823-0ed744eb3a4e"],
 " therefore gives\n\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         RowBox[{
           SubscriptBox["\[Delta]\[Lambda]", 
            StyleBox["DR", FontSlant -> "Plain"]], "\[LongEqual]", 
           FractionBox[
            RowBox[{"3", 
              SuperscriptBox["\[Lambda]", "2"]}], "2"], 
           SubscriptBox[
            StyleBox["B", "TI"], 
            StyleBox["DR", FontSlant -> "Plain"]], 
           RowBox[{"(", "0", ")"}], "\[LongEqual]", 
           FractionBox[
            RowBox[{"3", 
              SuperscriptBox["\[Lambda]", "2"]}], 
            RowBox[{"32", 
              SuperscriptBox["\[Pi]", "2"]}]], 
           RowBox[{"[", 
             RowBox[{
               FractionBox["2", "\[Epsilon]"], "-", 
               SubscriptBox["\[Gamma]", 
                StyleBox["E", "TI"]], "+", "ln", 
               FractionBox[
                RowBox[{"4", 
                  SuperscriptBox["\[Pi]\[Mu]", "2"]}], 
                SuperscriptBox[
                 StyleBox["m", "TI"], "2"]]}], "]"}], "+", 
           StyleBox["O", "TI"], 
           RowBox[{"(", "\[Epsilon]", ")"}], "."}], 
         RowBox[{
           StyleBox["B", "TI"], "-", "18"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "$\\boxed{ \\delta\\lambda_{\\mathrm{DR}} \
=\\frac{3\\lambda^2}{2}B_{\\mathrm{DR}}(0) =\\frac{3\\lambda^2}{32\\pi^2} \
\\left[ \\frac{2}{\\epsilon}-\\gamma_E +\\ln\\frac{4\\pi\\mu^2}{m^2} \
\\right]+O(\\epsilon). } \\tag{B-18}$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "1cd13bf3-9565-f846-a796-450d298b9a96"],
 "\n\nThe equalities involving ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["T", "TI"], 
        StyleBox["DR", FontSlant -> "Plain"]], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "$T_{\\mathrm{DR}}$ and $B_{\\mathrm{DR}}(0)$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "bd20257d-3b8f-844d-baf6-14da48a1a5d1"],
 " define the counterterms before the Laurent expansion; the displayed \
expansions retain their poles and finite terms.\n\nInterpretation\n\nThese \
are zero-momentum subtraction counterterms, not minimal-subtraction \
counterterms. We cancel the full loop corrections at the subtraction point, \
including finite constants and logarithms. MS would subtract only the pole \
terms.\n\nHard-cutoff counterterms\n\nThe same subtraction conditions B-16 \
give\n\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Delta]", 
         SubsuperscriptBox[
          StyleBox["Z", "TI"], "\[Phi]", 
          RowBox[{"(", "1", ")"}]], "\[LongEqual]", "0", ",    ", "\[Delta]", 
         SubsuperscriptBox[
          StyleBox["m", "TI"], "\[CapitalLambda]", "2"], "\[LongEqual]", "-", 
         FractionBox["\[Lambda]", "2"], 
         SubscriptBox[
          StyleBox["T", "TI"], "\[CapitalLambda]"], ",    ", 
         SubscriptBox["\[Delta]\[Lambda]", "\[CapitalLambda]"], 
         "\[LongEqual]", 
         FractionBox[
          RowBox[{"3", 
            SuperscriptBox["\[Lambda]", "2"]}], "2"], 
         SubscriptBox[
          StyleBox["B", "TI"], "\[CapitalLambda]"], 
         RowBox[{"(", "0", ")"}], "."}], TraditionalForm], "errors" -> {}, 
     "input" -> 
     "$\\delta Z_\\phi^{(1)}=0,\\qquad \\delta \
m_\\Lambda^2=-\\frac{\\lambda}{2}T_\\Lambda,\\qquad \\delta\\lambda_\\Lambda=\
\\frac{3\\lambda^2}{2}B_\\Lambda(0).$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "5eb6f18f-6b31-054b-a69f-6e58f9e5a2cb"],
 "\n\nSubstituting the exact cutoff integrals B-04 and B-10 yields\n\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         RowBox[{"\[Delta]", 
           SubsuperscriptBox[
            StyleBox["m", "TI"], "\[CapitalLambda]", "2"], "\[LongEqual]", 
           "-", 
           FractionBox["\[Lambda]", 
            RowBox[{"32", 
              SuperscriptBox["\[Pi]", "2"]}]], 
           RowBox[{"[", 
             RowBox[{
               SuperscriptBox["\[CapitalLambda]", "2"], "-", 
               SuperscriptBox[
                StyleBox["m", "TI"], "2"], "ln", 
               RowBox[{"(", 
                 RowBox[{"1", "+", 
                   FractionBox[
                    SuperscriptBox["\[CapitalLambda]", "2"], 
                    SuperscriptBox[
                    StyleBox["m", "TI"], "2"]]}], ")"}]}], "]"}], ",    ", 
           "\[Delta]", 
           SubsuperscriptBox[
            StyleBox["Z", "TI"], "\[Phi]", 
            RowBox[{"(", "1", ")"}]], "\[LongEqual]", "0."}], 
         RowBox[{
           StyleBox["B", "TI"], "-", "19"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "$\\boxed{ \\delta m_\\Lambda^2 =-\\frac{\\lambda}{32\\pi^2} \\left[ \
\\Lambda^2-m^2\\ln\\left(1+\\frac{\\Lambda^2}{m^2}\\right) \\right], \\qquad \
\\delta Z_\\phi^{(1)}=0. } \\tag{B-19}$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "579dc3e6-8424-d24c-9eb1-95567969f029"],
 "\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         RowBox[{
           SubscriptBox["\[Delta]\[Lambda]", "\[CapitalLambda]"], 
           "\[LongEqual]", 
           FractionBox[
            RowBox[{"3", 
              SuperscriptBox["\[Lambda]", "2"]}], 
            RowBox[{"32", 
              SuperscriptBox["\[Pi]", "2"]}]], 
           RowBox[{"[", 
             RowBox[{"ln", 
               RowBox[{"(", 
                 RowBox[{"1", "+", 
                   FractionBox[
                    SuperscriptBox["\[CapitalLambda]", "2"], 
                    SuperscriptBox[
                    StyleBox["m", "TI"], "2"]]}], ")"}], "-", 
               FractionBox[
                SuperscriptBox["\[CapitalLambda]", "2"], 
                RowBox[{
                  SuperscriptBox["\[CapitalLambda]", "2"], "+", 
                  SuperscriptBox[
                   StyleBox["m", "TI"], "2"]}]]}], "]"}], "."}], 
         RowBox[{
           StyleBox["B", "TI"], "-", "20"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "$\\boxed{ \\delta\\lambda_\\Lambda =\\frac{3\\lambda^2}{32\\pi^2} \
\\left[ \\ln\\left(1+\\frac{\\Lambda^2}{m^2}\\right) \
-\\frac{\\Lambda^2}{\\Lambda^2+m^2} \\right]. } \\tag{B-20}$", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "a06f3e79-0f2a-ae49-b9bf-57e23010261d"],
 "\n\nThese include the finite terms required by zero-momentum subtraction. \
As in DR, substituting them into the vertices cancels the loop corrections at \
the subtraction point and satisfies all three conditions.\n\nQuestion \
\[LongDash] Regulator independence of the subtracted bubble and its slope\n\n\
Show that ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["B", "TI"], 
         RowBox[{"(", 
           StyleBox["P", "TI"], ")"}], "-", 
         StyleBox["B", "TI"], 
         RowBox[{"(", "0", ")"}]}], TraditionalForm], "errors" -> {}, "input" -> 
     "$B(P)-B(0)$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "3b625c7e-02eb-4849-a939-9a779486e036"],
 " and its derivative at ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox[
          StyleBox["P", "TI"], "2"], "\[LongEqual]", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "$P^2=0$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "c93d6c61-b16d-ab4d-9c83-3c4453bac68e"],
 " agree in DR and the hard-cutoff scheme after removing the regulators. \
Throughout, ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox[
        StyleBox["P", "TI"], "2"], TraditionalForm], "errors" -> {}, "input" -> 
     "$P^2$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "1596e008-f0ab-e443-b545-a994339ae5b3"],
 " is Euclidean and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox[
          StyleBox["m", "TI"], "2"], ">", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "$m^2>0$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b4fc3a67-eedd-1744-9e44-a8b4bb7a1729"],
 ".\n\n1. Dimensional regularization\n\nUsing the Feynman-parameter identity\n\
\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         FractionBox["1", 
          RowBox[{
            StyleBox["A", "TI"], 
            StyleBox["B", "TI"]}]], "\[LongEqual]", 
         SubsuperscriptBox["\[Integral]", "0", "1"], 
         StyleBox["d", "TI"], 
         StyleBox["x", "TI"], " ", 
         FractionBox["1", 
          SuperscriptBox[
           RowBox[{"[", 
             RowBox[{
               StyleBox["x", "TI"], 
               StyleBox["A", "TI"], "+", 
               RowBox[{"(", 
                 RowBox[{"1", "-", 
                   StyleBox["x", "TI"]}], ")"}], 
               StyleBox["B", "TI"]}], "]"}], "2"]], ","}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "$\\frac1{AB}=\\int_0^1dx\\,\\frac1{[xA+(1-x)B]^2},$", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "3ab1907a-5e14-b841-a504-dcd0b88858d6"],
 "\n\ncombine the propagators and shift the loop momentum. Translation \
invariance is valid in DR. Applying B-06 with ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Alpha]", "\[LongEqual]", "2"}], TraditionalForm], 
     "errors" -> {}, "input" -> "$\\alpha=2$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "c111f1c3-9578-b142-99b0-50e924d8411f"],
 " gives\n\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox[
      StyleBox["B", "TI"], 
      StyleBox["DR",
       FontSlant->"Plain"]], "(", 
     StyleBox["P", "TI"], ")"}], "\[LongEqual]", 
    RowBox[{
     FractionBox[
      RowBox[{
       SuperscriptBox["\[Mu]", "\[Epsilon]"], 
       RowBox[{"\[CapitalGamma]", "(", 
        RowBox[{"\[Epsilon]", "/", "2"}], ")"}]}], 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"4", "\[Pi]"}], ")"}], 
       RowBox[{"2", "-", 
        RowBox[{"\[Epsilon]", "/", "2"}]}]]], 
     RowBox[{
      SubsuperscriptBox["\[Integral]", "0", "1"], 
      RowBox[{
       StyleBox["d", "TI"], 
       StyleBox["x", "TI"], " ", 
       RowBox[{
        SuperscriptBox[
         RowBox[{"[", 
          RowBox[{
           SuperscriptBox[
            StyleBox["m", "TI"], "2"], "+", 
           RowBox[{
            RowBox[{
             StyleBox["x", "TI"], "(", 
             RowBox[{"1", "-", 
              StyleBox["x", "TI"]}], ")"}], 
            SuperscriptBox[
             StyleBox["P", "TI"], "2"]}]}], "]"}], 
         RowBox[{
          RowBox[{"-", "\[Epsilon]"}], "/", "2"}]], "."}]}]}]}]}], 
   TraditionalForm]],ExpressionUUID->"bc051a7c-697b-9d4c-90d4-010544882466"],
 "\n\nSubtracting the zero-momentum expression before taking ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Epsilon]", "\[Rule]", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "$\\epsilon\\to0$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "942647f2-b221-3348-a22a-30fed593b47c"],
 ",\n\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["B", "TI"], 
          StyleBox["DR", FontSlant -> "Plain"]], 
         RowBox[{"(", 
           StyleBox["P", "TI"], ")"}], "-", 
         SubscriptBox[
          StyleBox["B", "TI"], 
          StyleBox["DR", FontSlant -> "Plain"]], 
         RowBox[{"(", "0", ")"}], "\[LongEqual]", 
         FractionBox[
          RowBox[{
            SuperscriptBox["\[Mu]", "\[Epsilon]"], "\[CapitalGamma]", 
            RowBox[{"(", 
              RowBox[{"\[Epsilon]", "/", "2"}], ")"}]}], 
          SuperscriptBox[
           RowBox[{"(", 
             RowBox[{"4", "\[Pi]"}], ")"}], 
           RowBox[{"2", "-", "\[Epsilon]", "/", "2"}]]], 
         SubsuperscriptBox["\[Integral]", "0", "1"], 
         StyleBox["d", "TI"], 
         StyleBox["x", "TI"], " ", 
         RowBox[{"{", 
           RowBox[{
             SuperscriptBox[
              RowBox[{"[", 
                RowBox[{
                  SuperscriptBox[
                   StyleBox["m", "TI"], "2"], "+", 
                  StyleBox["x", "TI"], 
                  RowBox[{"(", 
                    RowBox[{"1", "-", 
                    StyleBox["x", "TI"]}], ")"}], 
                  SuperscriptBox[
                   StyleBox["P", "TI"], "2"]}], "]"}], 
              RowBox[{"-", "\[Epsilon]", "/", "2"}]], "-", 
             SuperscriptBox[
              RowBox[{"(", 
                SuperscriptBox[
                 StyleBox["m", "TI"], "2"], ")"}], 
              RowBox[{"-", "\[Epsilon]", "/", "2"}]]}], "}"}], "."}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "$B_{\\mathrm{DR}}(P)-B_{\\mathrm{DR}}(0) =\\frac{\\mu^\\epsilon\\Gamma(\
\\epsilon/2)} {(4\\pi)^{2-\\epsilon/2}} \\int_0^1dx\\, \
\\left\\{[m^2+x(1-x)P^2]^{-\\epsilon/2} -(m^2)^{-\\epsilon/2}\\right\\}.$", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f394f6dc-f0cb-f04d-aeb2-41caf4e483f2"],
 "\n\nThe expression in braces is\n\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"-", 
         FractionBox["\[Epsilon]", "2"], "ln", 
         RowBox[{"(", 
           RowBox[{"1", "+", 
             FractionBox[
              RowBox[{
                StyleBox["x", "TI"], 
                RowBox[{"(", 
                  RowBox[{"1", "-", 
                    StyleBox["x", "TI"]}], ")"}], 
                SuperscriptBox[
                 StyleBox["P", "TI"], "2"]}], 
              SuperscriptBox[
               StyleBox["m", "TI"], "2"]]}], ")"}], "+", 
         StyleBox["O", "TI"], 
         RowBox[{"(", 
           SuperscriptBox["\[Epsilon]", "2"], ")"}], "."}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "$-\\frac{\\epsilon}{2} \
\\ln\\left(1+\\frac{x(1-x)P^2}{m^2}\\right)+O(\\epsilon^2).$", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "40294105-850f-5046-93c4-80343d8116b7"],
 "\n\nIts factor of ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Epsilon]", TraditionalForm], "errors" -> {}, 
     "input" -> "$\\epsilon$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "dcff567e-58e9-6e45-8438-1e842a260338"],
 " cancels the pole ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[CapitalGamma]", 
         RowBox[{"(", 
           RowBox[{"\[Epsilon]", "/", "2"}], ")"}], "\[LongEqual]", "2", "/", 
         "\[Epsilon]", "+", 
         StyleBox["O", "TI"], 
         RowBox[{"(", "1", ")"}]}], TraditionalForm], "errors" -> {}, "input" -> 
     "$\\Gamma(\\epsilon/2)=2/\\epsilon+O(1)$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "a3d12cf5-afcb-6e4f-844c-4c6390ba1da3"],
 ", leaving\n\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         RowBox[{"\[CapitalDelta]", 
           SubscriptBox[
            StyleBox["B", "TI"], 
            StyleBox["DR", FontSlant -> "Plain"]], 
           RowBox[{"(", 
             SuperscriptBox[
              StyleBox["P", "TI"], "2"], ")"}], "\[Congruent]", 
           UnderscriptBox["lim", 
            RowBox[{"\[Epsilon]", "\[Rule]", "0"}], LimitsPositioning -> 
            True], 
           RowBox[{"[", 
             RowBox[{
               SubscriptBox[
                StyleBox["B", "TI"], 
                StyleBox["DR", FontSlant -> "Plain"]], 
               RowBox[{"(", 
                 StyleBox["P", "TI"], ")"}], "-", 
               SubscriptBox[
                StyleBox["B", "TI"], 
                StyleBox["DR", FontSlant -> "Plain"]], 
               RowBox[{"(", "0", ")"}]}], "]"}], "\[LongEqual]", "-", 
           FractionBox["1", 
            RowBox[{"16", 
              SuperscriptBox["\[Pi]", "2"]}]], 
           SubsuperscriptBox["\[Integral]", "0", "1"], 
           StyleBox["d", "TI"], 
           StyleBox["x", "TI"], " ", "ln", 
           RowBox[{"(", 
             RowBox[{"1", "+", 
               FractionBox[
                RowBox[{
                  StyleBox["x", "TI"], 
                  RowBox[{"(", 
                    RowBox[{"1", "-", 
                    StyleBox["x", "TI"]}], ")"}], 
                  SuperscriptBox[
                   StyleBox["P", "TI"], "2"]}], 
                SuperscriptBox[
                 StyleBox["m", "TI"], "2"]]}], ")"}], "."}], 
         RowBox[{
           StyleBox["B", "TI"], "-", "21"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "$\\boxed{ \\Delta B_{\\mathrm{DR}}(P^2) \\equiv\\lim_{\\epsilon\\to0} \
[B_{\\mathrm{DR}}(P)-B_{\\mathrm{DR}}(0)] =-\\frac1{16\\pi^2}\\int_0^1dx\\, \
\\ln\\left(1+\\frac{x(1-x)P^2}{m^2}\\right). } \\tag{B-21}$", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "32bffe46-0603-a74e-ace1-09e1d1da204d"],
 "\n2. Hard cutoff: subtract, remove the cutoff, then shift\n\nFirst form the \
difference with the same cutoff domain in both terms:\n\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         RowBox[{"\[CapitalDelta]", 
           SubscriptBox[
            StyleBox["B", "TI"], "\[CapitalLambda]"], 
           RowBox[{"(", 
             SuperscriptBox[
              StyleBox["P", "TI"], "2"], ")"}], "\[LongEqual]", 
           SubscriptBox["\[Integral]", 
            RowBox[{"|", 
              StyleBox["k", "TI"], "|", "<", "\[CapitalLambda]"}]], 
           FractionBox[
            RowBox[{
              SuperscriptBox[
               StyleBox["d", "TI"], "4"], 
              StyleBox["k", "TI"]}], 
            SuperscriptBox[
             RowBox[{"(", 
               RowBox[{"2", "\[Pi]"}], ")"}], "4"]], 
           RowBox[{"[", 
             RowBox[{
               FractionBox["1", 
                RowBox[{
                  RowBox[{"(", 
                    RowBox[{
                    SuperscriptBox[
                    StyleBox["k", "TI"], "2"], "+", 
                    SuperscriptBox[
                    StyleBox["m", "TI"], "2"]}], ")"}], "(", 
                  RowBox[{
                    SuperscriptBox[
                    RowBox[{"(", 
                    RowBox[{
                    StyleBox["k", "TI"], "+", 
                    StyleBox["P", "TI"]}], ")"}], "2"], "+", 
                    SuperscriptBox[
                    StyleBox["m", "TI"], "2"]}], ")"}]], "-", 
               FractionBox["1", 
                SuperscriptBox[
                 RowBox[{"(", 
                   RowBox[{
                    SuperscriptBox[
                    StyleBox["k", "TI"], "2"], "+", 
                    SuperscriptBox[
                    StyleBox["m", "TI"], "2"]}], ")"}], "2"]]}], "]"}], "."}], 
         RowBox[{
           StyleBox["B", "TI"], "-", "22"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "$\\boxed{ \\Delta B_\\Lambda(P^2) \
=\\int_{|k|<\\Lambda}\\frac{d^4k}{(2\\pi)^4} \\left[ \
\\frac1{(k^2+m^2)((k+P)^2+m^2)} -\\frac1{(k^2+m^2)^2} \\right]. } \
\\tag{B-22}$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "dfd1e9f0-b991-6742-acda-c6734e9db521"],
 "\n\nAt large ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       TemplateBox[{
         RowBox[{
           StyleBox["k", "TI"]}]}, "Abs"], TraditionalForm], "errors" -> {}, 
     "input" -> "$|k|$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "30f84a1f-028d-a548-a6f7-a5fd0a4a54b7"],
 ", the leading ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"1", "/", 
         SuperscriptBox[
          StyleBox["k", "TI"], "4"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "$1/k^4$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "af0f0f81-de82-a749-b7c1-2c6b31bab800"],
 " terms cancel, and the remaining integrand is ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["O", "TI"], "(", 
         RowBox[{"|", 
           StyleBox["k", "TI"], 
           SuperscriptBox["|", "-5"]}], ")"}], TraditionalForm], 
     "errors" -> {}, "input" -> "$O(|k|^{-5})$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d4b2c21c-b997-6545-b031-3e25ef3bb970"],
 ". The difference is therefore UV convergent; ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox[
          StyleBox["m", "TI"], "2"], ">", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "$m^2>0$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e4288b70-6be6-6c47-8c97-d7b0f22c4a24"],
 " also prevents an infrared divergence. We can now take ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[CapitalLambda]", "\[Rule]", "\[Infinity]"}], 
       TraditionalForm], "errors" -> {}, "input" -> "$\\Lambda\\to\\infty$", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "76a6c583-7155-d943-8c72-2f389840e932"],
 ".\n\nOnly after this limit, apply Feynman parametrization and shift the \
momentum in the combined, subtracted expression. No finite-cutoff boundary \
contribution survives. Writing\n\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubsuperscriptBox[
          StyleBox["M", "TI"], 
          StyleBox["x", "TI"], "2"], "\[LongEqual]", 
         SuperscriptBox[
          StyleBox["m", "TI"], "2"], "+", 
         StyleBox["x", "TI"], 
         RowBox[{"(", 
           RowBox[{"1", "-", 
             StyleBox["x", "TI"]}], ")"}], 
         SuperscriptBox[
          StyleBox["P", "TI"], "2"], ","}], TraditionalForm], "errors" -> {}, 
     "input" -> "$M_x^2=m^2+x(1-x)P^2,$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "8d34765b-91ba-374e-b800-e74b6ede5803"],
 "\n\nwe obtain\n\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[CapitalDelta]", 
         SubscriptBox[
          StyleBox["B", "TI"], 
          StyleBox["cutoff", FontSlant -> "Plain"]], 
         RowBox[{"(", 
           SuperscriptBox[
            StyleBox["P", "TI"], "2"], ")"}], "\[LongEqual]", 
         SubsuperscriptBox["\[Integral]", "0", "1"], 
         StyleBox["d", "TI"], 
         StyleBox["x", "TI"], "\[Integral]", 
         FractionBox[
          RowBox[{
            SuperscriptBox[
             StyleBox["d", "TI"], "4"], 
            StyleBox["q", "TI"]}], 
          SuperscriptBox[
           RowBox[{"(", 
             RowBox[{"2", "\[Pi]"}], ")"}], "4"]], 
         RowBox[{"[", 
           RowBox[{
             FractionBox["1", 
              SuperscriptBox[
               RowBox[{"(", 
                 RowBox[{
                   SuperscriptBox[
                    StyleBox["q", "TI"], "2"], "+", 
                   SubsuperscriptBox[
                    StyleBox["M", "TI"], 
                    StyleBox["x", "TI"], "2"]}], ")"}], "2"]], "-", 
             FractionBox["1", 
              SuperscriptBox[
               RowBox[{"(", 
                 RowBox[{
                   SuperscriptBox[
                    StyleBox["q", "TI"], "2"], "+", 
                   SuperscriptBox[
                    StyleBox["m", "TI"], "2"]}], ")"}], "2"]]}], "]"}], "."}],
        TraditionalForm], "errors" -> {}, "input" -> 
     "$\\Delta B_{\\mathrm{cutoff}}(P^2) \
=\\int_0^1dx\\int\\frac{d^4q}{(2\\pi)^4} \\left[ \\frac1{(q^2+M_x^2)^2} \
-\\frac1{(q^2+m^2)^2} \\right].$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ed1eeeb9-c033-fa47-8470-b62bbccf2ffe"],
 "\n\nThe subtraction must remain intact: the individual integrals are \
divergent.\n\nUsing radial coordinates and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["u", "TI"], "\[LongEqual]", 
         SuperscriptBox[
          StyleBox["q", "TI"], "2"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "$u=q^2$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "3a91a79a-dffa-3e4b-9829-a4ba7e235222"],
 ", the inner integral is\n\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         FractionBox["1", 
          RowBox[{"16", 
            SuperscriptBox["\[Pi]", "2"]}]], 
         SubsuperscriptBox["\[Integral]", "0", "\[Infinity]"], 
         StyleBox["d", "TI"], 
         StyleBox["u", "TI"], " ", 
         StyleBox["u", "TI"], 
         RowBox[{"[", 
           RowBox[{
             FractionBox["1", 
              SuperscriptBox[
               RowBox[{"(", 
                 RowBox[{
                   StyleBox["u", "TI"], "+", 
                   SubsuperscriptBox[
                    StyleBox["M", "TI"], 
                    StyleBox["x", "TI"], "2"]}], ")"}], "2"]], "-", 
             FractionBox["1", 
              SuperscriptBox[
               RowBox[{"(", 
                 RowBox[{
                   StyleBox["u", "TI"], "+", 
                   SuperscriptBox[
                    StyleBox["m", "TI"], "2"]}], ")"}], "2"]]}], "]"}], 
         "\[LongEqual]", "-", 
         FractionBox["1", 
          RowBox[{"16", 
            SuperscriptBox["\[Pi]", "2"]}]], "ln", 
         FractionBox[
          SubsuperscriptBox[
           StyleBox["M", "TI"], 
           StyleBox["x", "TI"], "2"], 
          SuperscriptBox[
           StyleBox["m", "TI"], "2"]], "."}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "$\\frac1{16\\pi^2}\\int_0^\\infty du\\,u \
\\left[\\frac1{(u+M_x^2)^2}-\\frac1{(u+m^2)^2}\\right] \
=-\\frac1{16\\pi^2}\\ln\\frac{M_x^2}{m^2}.$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "11dfd910-748f-f34d-b595-2c53be3d4508"],
 "\n\nHence\n\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         RowBox[{"\[CapitalDelta]", 
           SubscriptBox[
            StyleBox["B", "TI"], 
            StyleBox["cutoff", FontSlant -> "Plain"]], 
           RowBox[{"(", 
             SuperscriptBox[
              StyleBox["P", "TI"], "2"], ")"}], "\[LongEqual]", "-", 
           FractionBox["1", 
            RowBox[{"16", 
              SuperscriptBox["\[Pi]", "2"]}]], 
           SubsuperscriptBox["\[Integral]", "0", "1"], 
           StyleBox["d", "TI"], 
           StyleBox["x", "TI"], " ", "ln", 
           RowBox[{"(", 
             RowBox[{"1", "+", 
               FractionBox[
                RowBox[{
                  StyleBox["x", "TI"], 
                  RowBox[{"(", 
                    RowBox[{"1", "-", 
                    StyleBox["x", "TI"]}], ")"}], 
                  SuperscriptBox[
                   StyleBox["P", "TI"], "2"]}], 
                SuperscriptBox[
                 StyleBox["m", "TI"], "2"]]}], ")"}], "\[LongEqual]", 
           "\[CapitalDelta]", 
           SubscriptBox[
            StyleBox["B", "TI"], 
            StyleBox["DR", FontSlant -> "Plain"]], 
           RowBox[{"(", 
             SuperscriptBox[
              StyleBox["P", "TI"], "2"], ")"}], "."}], 
         RowBox[{
           StyleBox["B", "TI"], "-", "23"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "$\\boxed{ \\Delta B_{\\mathrm{cutoff}}(P^2) \
=-\\frac1{16\\pi^2}\\int_0^1dx\\, \\ln\\left(1+\\frac{x(1-x)P^2}{m^2}\\right) \
=\\Delta B_{\\mathrm{DR}}(P^2). } \\tag{B-23}$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "38d4a83e-ed61-9a4e-809d-3792b352debb"],
 "\n3. Slope at zero momentum\n\nDifferentiate the common finite expression:\n\
\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         FractionBox[
          RowBox[{
            StyleBox["d", "TI"], "\[CapitalDelta]", 
            StyleBox["B", "TI"]}], 
          RowBox[{
            StyleBox["d", "TI"], 
            SuperscriptBox[
             StyleBox["P", "TI"], "2"]}]], "\[LongEqual]", "-", 
         FractionBox["1", 
          RowBox[{"16", 
            SuperscriptBox["\[Pi]", "2"]}]], 
         SubsuperscriptBox["\[Integral]", "0", "1"], 
         StyleBox["d", "TI"], 
         StyleBox["x", "TI"], " ", 
         FractionBox[
          RowBox[{
            StyleBox["x", "TI"], "(", 
            RowBox[{"1", "-", 
              StyleBox["x", "TI"]}], ")"}], 
          RowBox[{
            SuperscriptBox[
             StyleBox["m", "TI"], "2"], "+", 
            StyleBox["x", "TI"], 
            RowBox[{"(", 
              RowBox[{"1", "-", 
                StyleBox["x", "TI"]}], ")"}], 
            SuperscriptBox[
             StyleBox["P", "TI"], "2"]}]], "."}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "$\\frac{d\\Delta B}{dP^2} =-\\frac1{16\\pi^2}\\int_0^1dx\\, \
\\frac{x(1-x)}{m^2+x(1-x)P^2}.$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ead828e4-d219-7a4d-8d1f-30c8dc24ab0b"],
 "\n\nSince ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubsuperscriptBox["\[Integral]", "0", "1"], 
         StyleBox["d", "TI"], 
         StyleBox["x", "TI"], " ", 
         StyleBox["x", "TI"], 
         RowBox[{"(", 
           RowBox[{"1", "-", 
             StyleBox["x", "TI"]}], ")"}], "\[LongEqual]", "1", "/", "6"}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "$\\int_0^1dx\\,x(1-x)=1/6$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "5cbb1da3-592b-e641-a686-d2df8f52bfdc"],
 ",\n\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         RowBox[{"\[CapitalDelta]", 
           StyleBox["B", "TI"], 
           RowBox[{"(", "0", ")"}], "\[LongEqual]", "0", ",    ", 
           SubscriptBox[
            RowBox[{
              FractionBox[
               RowBox[{
                 StyleBox["d", "TI"], "\[CapitalDelta]", 
                 StyleBox["B", "TI"]}], 
               RowBox[{
                 StyleBox["d", "TI"], 
                 SuperscriptBox[
                  StyleBox["P", "TI"], "2"]}]], "\[VerticalSeparator]"}], 
            RowBox[{
              SuperscriptBox[
               StyleBox["P", "TI"], "2"], "\[LongEqual]", "0"}]], 
           "\[LongEqual]", "-", 
           FractionBox["1", 
            RowBox[{"96", 
              SuperscriptBox["\[Pi]", "2"], 
              SuperscriptBox[
               StyleBox["m", "TI"], "2"]}]], "."}], 
         RowBox[{
           StyleBox["B", "TI"], "-", "24"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "$\\boxed{ \\Delta B(0)=0,\\qquad \\left.\\frac{d\\Delta \
B}{dP^2}\\right|_{P^2=0} =-\\frac1{96\\pi^2m^2}. } \\tag{B-24}$", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "7f70822a-70c9-b64f-b762-a7fc340771e3"],
 "\n\nThus both regulators give the same finite momentum dependence and the \
same nonzero slope. The negative slope means that the Euclidean bubble \
decreases as $P^2$ increases away from zero.\nThe code below the equivalence \
of the two regularizations."
}], "Text",
 CellChangeTimes->{{4.004248944745331*^9, 4.0042490960127983`*^9}, {
   4.0042505699982624`*^9, 4.004250603922825*^9}, {4.0042534310610733`*^9, 
   4.004253509104313*^9}, 4.004253567002144*^9, {4.004253603526716*^9, 
   4.0042537878687305`*^9}, {4.0042742950352535`*^9, 
   4.0042743358797817`*^9}},ExpressionUUID->"b9e64c2c-ae77-844b-b344-\
beaafd428c7a"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Clear", "[", 
    RowBox[{
    "epsDR", ",", "massSq", ",", "muScale", ",", "pSq", ",", "x", ",", "uRad",
      ",", "upperSq", ",", "massA", ",", "drKernel", ",", "drFiniteKernel", ",",
      "cutoffRadial", ",", "cutoffFiniteKernel", ",", "slopeDR", ",", 
     "slopeCutoff", ",", "expectedSlope"}], "]"}], ";"}], 
  "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{"DR", ":", 
    RowBox[{"subtract", " ", "before", " ", "removing", " ", "epsilon"}]}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"drKernel", "=", 
    RowBox[{
     RowBox[{
      RowBox[{"Gamma", "[", 
       RowBox[{"epsDR", "/", "2"}], "]"}], "/", 
      RowBox[{"(", 
       RowBox[{"16", " ", 
        RowBox[{"Pi", "^", "2"}]}], ")"}]}], "*", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"4", " ", "Pi", " ", 
        RowBox[{
         RowBox[{"muScale", "^", "2"}], "/", "massSq"}]}], ")"}], "^", 
      RowBox[{"(", 
       RowBox[{"epsDR", "/", "2"}], ")"}]}], "*", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", "+", 
          RowBox[{"x", " ", 
           RowBox[{"(", 
            RowBox[{"1", "-", "x"}], ")"}], " ", 
           RowBox[{"pSq", "/", "massSq"}]}]}], ")"}], "^", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "epsDR"}], "/", "2"}], ")"}]}], "-", "1"}], ")"}]}]}], 
   ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"drFiniteKernel", "=", 
    RowBox[{"FullSimplify", "[", 
     RowBox[{
      RowBox[{"Normal", "[", 
       RowBox[{"Series", "[", 
        RowBox[{"drKernel", ",", 
         RowBox[{"{", 
          RowBox[{"epsDR", ",", "0", ",", "0"}], "}"}]}], "]"}], "]"}], ",", 
      RowBox[{"Assumptions", "->", 
       RowBox[{
        RowBox[{"massSq", ">", "0"}], "&&", 
        RowBox[{"muScale", ">", "0"}], "&&", 
        RowBox[{"pSq", ">=", "0"}], "&&", 
        RowBox[{"0", "<=", "x", "<=", "1"}]}]}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{"Cutoff", " ", 
    RowBox[{"route", ":", 
     RowBox[{
     "evaluate", " ", "the", " ", "convergent", " ", "radial", " ", 
      "difference"}]}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"cutoffRadial", "=", 
    RowBox[{"Integrate", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"uRad", "/", 
        RowBox[{"(", 
         RowBox[{"16", " ", 
          RowBox[{"Pi", "^", "2"}]}], ")"}]}], "*", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"1", "/", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"uRad", "+", "massA"}], ")"}], "^", "2"}]}], "-", 
         RowBox[{"1", "/", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"uRad", "+", "massSq"}], ")"}], "^", "2"}]}]}], ")"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"uRad", ",", "0", ",", "upperSq"}], "}"}], ",", 
      RowBox[{"Assumptions", "->", 
       RowBox[{
        RowBox[{"massA", ">", "0"}], "&&", 
        RowBox[{"massSq", ">", "0"}], "&&", 
        RowBox[{"upperSq", ">", "0"}]}]}]}], "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"cutoffFiniteKernel", "=", 
    RowBox[{"FullSimplify", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Limit", "[", 
        RowBox[{"cutoffRadial", ",", 
         RowBox[{"upperSq", "->", "Infinity"}], ",", 
         RowBox[{"Assumptions", "->", 
          RowBox[{
           RowBox[{"massA", ">", "0"}], "&&", 
           RowBox[{"massSq", ">", "0"}]}]}]}], "]"}], "/.", " ", 
       RowBox[{"massA", "->", 
        RowBox[{"massSq", "+", 
         RowBox[{"x", " ", 
          RowBox[{"(", 
           RowBox[{"1", "-", "x"}], ")"}], " ", "pSq"}]}]}]}], ",", 
      RowBox[{"Assumptions", "->", 
       RowBox[{
        RowBox[{"massSq", ">", "0"}], "&&", 
        RowBox[{"pSq", ">=", "0"}], "&&", 
        RowBox[{"0", "<=", "x", "<=", "1"}]}]}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{
   "Integrate", " ", "the", " ", "derivatives", " ", "over", " ", "the", " ", 
    "Feynman", " ", "parameter"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"slopeDR", "=", 
    RowBox[{"FullSimplify", "[", 
     RowBox[{
      RowBox[{"Integrate", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"D", "[", 
          RowBox[{"drFiniteKernel", ",", "pSq"}], "]"}], "/.", " ", 
         RowBox[{"pSq", "->", "0"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"x", ",", "0", ",", "1"}], "}"}], ",", 
        RowBox[{"Assumptions", "->", 
         RowBox[{"massSq", ">", "0"}]}]}], "]"}], ",", 
      RowBox[{"Assumptions", "->", 
       RowBox[{"massSq", ">", "0"}]}]}], "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"slopeCutoff", "=", 
    RowBox[{"FullSimplify", "[", 
     RowBox[{
      RowBox[{"Integrate", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"D", "[", 
          RowBox[{"cutoffFiniteKernel", ",", "pSq"}], "]"}], "/.", " ", 
         RowBox[{"pSq", "->", "0"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"x", ",", "0", ",", "1"}], "}"}], ",", 
        RowBox[{"Assumptions", "->", 
         RowBox[{"massSq", ">", "0"}]}]}], "]"}], ",", 
      RowBox[{"Assumptions", "->", 
       RowBox[{"massSq", ">", "0"}]}]}], "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"expectedSlope", "=", 
    RowBox[{
     RowBox[{"-", "1"}], "/", 
     RowBox[{"(", 
      RowBox[{"96", " ", 
       RowBox[{"Pi", "^", "2"}], " ", "massSq"}], ")"}]}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{"Column", "[", 
  RowBox[{"{", 
   RowBox[{"\"\<DR finite kernel (integrate over x from 0 to 1):\>\"", ",", 
    "drFiniteKernel", 
    ",", "\"\<Cutoff finite kernel (integrate over x from 0 to 1):\>\"", ",", 
    "cutoffFiniteKernel", 
    ",", "\"\<Kernel difference for arbitrary Euclidean pSq (expected: \
0):\>\"", ",", 
    RowBox[{"FullSimplify", "[", 
     RowBox[{
      RowBox[{"drFiniteKernel", "-", "cutoffFiniteKernel"}], ",", 
      RowBox[{"Assumptions", "->", 
       RowBox[{
        RowBox[{"massSq", ">", "0"}], "&&", 
        RowBox[{"pSq", ">=", "0"}], "&&", 
        RowBox[{"0", "<=", "x", "<=", "1"}]}]}]}], "]"}], 
    ",", "\"\<Subtracted values at pSq = 0 (expected: {0, 0}):\>\"", ",", 
    RowBox[{"FullSimplify", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"drFiniteKernel", ",", "cutoffFiniteKernel"}], "}"}], "/.", 
       " ", 
       RowBox[{"pSq", "->", "0"}]}], ",", 
      RowBox[{"Assumptions", "->", 
       RowBox[{"massSq", ">", "0"}]}]}], "]"}], 
    ",", "\"\<Slopes from DR and cutoff:\>\"", ",", 
    RowBox[{"{", 
     RowBox[{"slopeDR", ",", "slopeCutoff"}], "}"}], 
    ",", "\"\<Slope residuals against B-24 (expected: {0, 0}):\>\"", ",", 
    RowBox[{"FullSimplify", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"slopeDR", "-", "expectedSlope"}], ",", 
        RowBox[{"slopeCutoff", "-", "expectedSlope"}]}], "}"}], ",", 
      RowBox[{"Assumptions", "->", 
       RowBox[{"massSq", ">", "0"}]}]}], "]"}]}], "}"}], "]"}]}], "Input",
 CellChangeTimes->{{4.004256661704153*^9, 4.004256661704153*^9}},
 CellLabel->"In[10]:=",ExpressionUUID->"5fa57c75-3c9e-e048-8fba-5a4f269f79cc"],

Cell[BoxData[
 TagBox[GridBox[{
    {"\<\"DR finite kernel (integrate over x from 0 to 1):\"\>"},
    {
     RowBox[{"-", 
      FractionBox[
       RowBox[{"Log", "[", 
        RowBox[{"1", "-", 
         FractionBox[
          RowBox[{"pSq", " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"-", "1"}], "+", "x"}], ")"}], " ", "x"}], "massSq"]}], 
        "]"}], 
       RowBox[{"16", " ", 
        SuperscriptBox["\[Pi]", "2"]}]]}]},
    {"\<\"Cutoff finite kernel (integrate over x from 0 to 1):\"\>"},
    {
     FractionBox[
      RowBox[{"Log", "[", 
       FractionBox["massSq", 
        RowBox[{"massSq", "-", 
         RowBox[{"pSq", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"-", "1"}], "+", "x"}], ")"}], " ", "x"}]}]], "]"}], 
      RowBox[{"16", " ", 
       SuperscriptBox["\[Pi]", "2"]}]]},
    {"\<\"Kernel difference for arbitrary Euclidean pSq (expected: 0):\"\>"},
    {"0"},
    {"\<\"Subtracted values at pSq = 0 (expected: {0, 0}):\"\>"},
    {
     RowBox[{"{", 
      RowBox[{"0", ",", "0"}], "}"}]},
    {"\<\"Slopes from DR and cutoff:\"\>"},
    {
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", 
        FractionBox["1", 
         RowBox[{"96", " ", "massSq", " ", 
          SuperscriptBox["\[Pi]", "2"]}]]}], ",", 
       RowBox[{"-", 
        FractionBox["1", 
         RowBox[{"96", " ", "massSq", " ", 
          SuperscriptBox["\[Pi]", "2"]}]]}]}], "}"}]},
    {"\<\"Slope residuals against B-24 (expected: {0, 0}):\"\>"},
    {
     RowBox[{"{", 
      RowBox[{"0", ",", "0"}], "}"}]}
   },
   DefaultBaseStyle->"Column",
   GridBoxAlignment->{"Columns" -> {{Left}}},
   GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}],
  "Column"]], "Output",
 CellChangeTimes->{4.0042566656451817`*^9},
 CellLabel->"Out[18]=",ExpressionUUID->"3921e498-de1c-ff4a-9ebd-11b2e190b3d4"]
}, Open  ]],

Cell["\<\
Question | Determine the one-loop counterterms in both regulators under \
zero-momentum subtraction, and demonstrate regulator independence of B(P) \
\[Minus] B(0) and its slope at P\.b2 = 0.

Derivation | The normalization conditions fix \[Delta]Z\[CurlyPhi] = 0, \
\[Delta]m\.b2 = \[Minus]\[Lambda]T/2, and \[Delta]\[Lambda] = \
3\[Lambda]\.b2B(0)/2, including finite terms. In DR, subtraction cancels the \
pole and leaves a finite Feynman-parameter integral. For the cutoff \
calculation, the convergent difference is formed first, \[CapitalLambda] \
\[RightArrow] \[Infinity] is taken, and only then is loop momentum shifted. \
Both routes give the same finite function and the same slope, \[Minus]1/(96\
\[Pi]\.b2m\.b2).

Check | The counterterms satisfy the normalization conditions by direct \
substitution. Mathematica code checks the subtraction algebra, equality of \
the finite parameter integrands, and agreement of the zero-momentum slopes; \
execution results have not yet been explicitly confirmed.

Anchor IDs | B-16\[Dash]B-24.

Status | derived and Mathematica checked.\
\>", "Text",
 CellChangeTimes->{
  4.0042591856081505`*^9, {4.004259367414961*^9, 
   4.0042593813067913`*^9}},ExpressionUUID->"19c52e0a-f4bd-a440-bdf6-\
3625e9dbb330"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Subsection 1.4:", "Subsection",
 CellChangeTimes->{{4.0042617481974926`*^9, 
  4.004261760450964*^9}},ExpressionUUID->"a74e5205-ef2c-2b43-baf3-\
d235bf9cfd6d"],

Cell[TextData[{
 "We retain the established conventions:\n\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["d", "TI"], "\[LongEqual]", "4", "-", "\[Epsilon]", ",    ", 
         StyleBox["g", "TI"], "\[LongEqual]", 
         FractionBox["\[Lambda]", 
          RowBox[{"16", 
            SuperscriptBox["\[Pi]", "2"]}]], ","}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "$d=4-\\epsilon,\\qquad g=\\frac{\\lambda}{16\\pi^2},$", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d04b87a4-936d-904f-a35a-4c1cf834abcd"],
 "\n\nwith Euclidean signature, ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox[
          StyleBox["m", "TI"], "2"], ">", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "$m^2>0$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "15ec5267-47bd-0d4e-9fcd-c4b5f0779821"],
 " throughout Part 1, and one factor ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox["\[Mu]", "\[Epsilon]"], TraditionalForm], 
     "errors" -> {}, "input" -> "$\\mu^\\epsilon$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "4d9d2d66-a004-0840-a0f5-b12ba7ca5db0"],
 " per DR loop. The overall ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox["\[Mu]", "\[Epsilon]"], TraditionalForm], 
     "errors" -> {}, "input" -> "$\\mu^\\epsilon$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "74038295-55ea-d04e-a383-22ff449d1b2e"],
 " is stripped from ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox["\[CapitalGamma]", 
        RowBox[{"(", "4", ")"}]], TraditionalForm], "errors" -> {}, "input" -> 
     "$\\Gamma^{(4)}$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "738d277d-7258-1b4c-a1d8-4b126d07d730"],
 ".\n\n1. MS coupling counterterm\n\nFrom B-14, the pole of each bubble is\n\n\
",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          RowBox[{
            RowBox[{
              SubscriptBox[
               StyleBox["B", "TI"], 
               StyleBox["DR", FontSlant -> "Plain"]], "(", 
              StyleBox["P", "TI"], ")"}], "\[VerticalSeparator]"}], 
          StyleBox["pole", FontSlant -> "Plain"]], "\[LongEqual]", 
         FractionBox["2", 
          RowBox[{"16", 
            SuperscriptBox["\[Pi]", "2"], "\[Epsilon]"}]], "."}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "$\\left.B_{\\mathrm{DR}}(P)\\right|_{\\mathrm{pole}} \
=\\frac{2}{16\\pi^2\\epsilon}.$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b7662f2a-ce79-4e40-ab1d-e2f78c666977"],
 "\n\nIt is independent of ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["P", "TI"], TraditionalForm], "errors" -> {}, "input" -> 
     "$P$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "a9d0670c-c58d-494d-b164-224caec7d86b"],
 ". Using the three-channel contribution\n\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"-", 
         FractionBox[
          SuperscriptBox["\[Lambda]", "2"], "2"], 
         RowBox[{"[", 
           RowBox[{
             StyleBox["B", "TI"], 
             RowBox[{"(", 
               SubscriptBox[
                StyleBox["P", "TI"], "12"], ")"}], "+", 
             StyleBox["B", "TI"], 
             RowBox[{"(", 
               SubscriptBox[
                StyleBox["P", "TI"], "13"], ")"}], "+", 
             StyleBox["B", "TI"], 
             RowBox[{"(", 
               SubscriptBox[
                StyleBox["P", "TI"], "14"], ")"}]}], "]"}], ","}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "$-\\frac{\\lambda^2}{2} \\bigl[B(P_{12})+B(P_{13})+B(P_{14})\\bigr],$", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b276848a-2c17-1640-a727-2d1af83d9a42"],
 "\n\nthe divergent part of the four-point vertex is\n\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"-", 
         FractionBox[
          RowBox[{"3", 
            SuperscriptBox["\[Lambda]", "2"]}], 
          RowBox[{"16", 
            SuperscriptBox["\[Pi]", "2"], "\[Epsilon]"}]], "."}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "$-\\frac{3\\lambda^2}{16\\pi^2\\epsilon}.$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "7bb4ac7d-001c-5049-bb3b-a4e7fc1ef33e"],
 "\n\nMS cancels this pole without subtracting the finite part. Thus\n\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         RowBox[{
           SubscriptBox["\[Delta]\[Lambda]", 
            StyleBox["MS", FontSlant -> "Plain"]], "\[LongEqual]", 
           FractionBox[
            RowBox[{"3", 
              SuperscriptBox["\[Lambda]", "2"]}], 
            RowBox[{"16", 
              SuperscriptBox["\[Pi]", "2"], "\[Epsilon]"}]], "+", 
           StyleBox["O", "TI"], 
           RowBox[{"(", 
             SuperscriptBox["\[Lambda]", "3"], ")"}], ",    ", 
           SubscriptBox[
            StyleBox["g", "TI"], "0"], "\[Congruent]", 
           FractionBox[
            SubscriptBox["\[Lambda]", "0"], 
            RowBox[{"16", 
              SuperscriptBox["\[Pi]", "2"]}]], "\[LongEqual]", 
           SuperscriptBox["\[Mu]", "\[Epsilon]"], 
           RowBox[{"[", 
             RowBox[{
               StyleBox["g", "TI"], "+", 
               FractionBox[
                RowBox[{"3", 
                  SuperscriptBox[
                   StyleBox["g", "TI"], "2"]}], "\[Epsilon]"], "+", 
               StyleBox["O", "TI"], 
               RowBox[{"(", 
                 SuperscriptBox[
                  StyleBox["g", "TI"], "3"], ")"}]}], "]"}], "."}], 
         RowBox[{
           StyleBox["B", "TI"], "-", "25"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "$\\boxed{ \\delta\\lambda_{\\mathrm{MS}} \
=\\frac{3\\lambda^2}{16\\pi^2\\epsilon}+O(\\lambda^3), \\qquad \
g_0\\equiv\\frac{\\lambda_0}{16\\pi^2} =\\mu^\\epsilon \\left[g+\\frac{3g^2}{\
\\epsilon}+O(g^3)\\right]. } \\tag{B-25}$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "28b8f1e2-177b-5345-a621-ab9de4a135f5"],
 "\n\nHere ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["g", "TI"], TraditionalForm], "errors" -> {}, "input" -> 
     "$g$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "0f29dca2-6583-d249-9cbf-94e05f47d27f"],
 " is dimensionless, whereas ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["g", "TI"], "0"], TraditionalForm], "errors" -> {}, "input" -> 
     "$g_0$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b9ca1645-e160-5e4b-9805-78a7589d8571"],
 " has mass dimension ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Epsilon]", TraditionalForm], "errors" -> {}, 
     "input" -> "$\\epsilon$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d40138cd-a31a-b244-bb0f-5c385df2b660"],
 ". Field renormalization does not contribute to this relation at the \
displayed order, as established below.\n\n2. Derivation of ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["\[Beta]", 
        StyleBox["g", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "$\\beta_g$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "c03ab32a-62da-3e4a-90d0-a2a7d36d41c7"],
 "\n\nThe beta function is defined by varying ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Mu]", TraditionalForm], "errors" -> {}, "input" -> 
     "$\\mu$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b5059782-57c7-7e4e-bf2b-1695d584eb4d"],
 " at fixed bare parameters:\n\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         RowBox[{
           SubscriptBox["\[Beta]", 
            StyleBox["g", "TI"]], "\[Congruent]", 
           SubscriptBox[
            RowBox[{
              RowBox[{"\[Mu]", 
                FractionBox[
                 RowBox[{
                   StyleBox["d", "TI"], 
                   StyleBox["g", "TI"]}], 
                 RowBox[{
                   StyleBox["d", "TI"], "\[Mu]"}]]}], 
              "\[VerticalSeparator]"}], 
            RowBox[{
              SubscriptBox["\[Lambda]", "0"], ",", 
              SubsuperscriptBox[
               StyleBox["m", "TI"], "0", "2"], ",", "\[Epsilon]"}]], ",    ", 
           "0", "\[LongEqual]", "\[Epsilon]", 
           RowBox[{"[", 
             RowBox[{
               StyleBox["g", "TI"], "+", 
               FractionBox[
                RowBox[{"3", 
                  SuperscriptBox[
                   StyleBox["g", "TI"], "2"]}], "\[Epsilon]"], "+", 
               "\[CenterEllipsis]"}], "]"}], "+", 
           SubscriptBox["\[Beta]", 
            StyleBox["g", "TI"]], 
           RowBox[{"[", 
             RowBox[{"1", "+", 
               FractionBox[
                RowBox[{"6", 
                  StyleBox["g", "TI"]}], "\[Epsilon]"], "+", 
               "\[CenterEllipsis]"}], "]"}], "."}], 
         RowBox[{
           StyleBox["B", "TI"], "-", "26"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "$\\boxed{ \\beta_g \\equiv \
\\left.\\mu\\frac{dg}{d\\mu}\\right|_{\\lambda_0,m_0^2,\\epsilon}, \\qquad 0= \
\\epsilon\\left[g+\\frac{3g^2}{\\epsilon}+\\cdots\\right] \
+\\beta_g\\left[1+\\frac{6g}{\\epsilon}+\\cdots\\right]. } \\tag{B-26}$", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b6ecb5cc-17c8-e346-a9a6-187ef1357cf4"],
 "\n\nThe second equation follows by differentiating B-25.\n\nWrite\n\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[Beta]", 
          StyleBox["g", "TI"]], "\[LongEqual]", "-", "\[Epsilon]", 
         StyleBox["g", "TI"], "+", 
         StyleBox["b", "TI"], " ", 
         SuperscriptBox[
          StyleBox["g", "TI"], "2"], "+", 
         StyleBox["O", "TI"], 
         RowBox[{"(", 
           SuperscriptBox[
            StyleBox["g", "TI"], "3"], ")"}], "."}], TraditionalForm], 
     "errors" -> {}, "input" -> "$\\beta_g=-\\epsilon g+b\\,g^2+O(g^3).$", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "a652d41c-a76d-5d4f-b21f-bf720a1d8974"],
 "\n\nSubstituting into B-26 and retaining terms through ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox[
        StyleBox["g", "TI"], "2"], TraditionalForm], "errors" -> {}, "input" -> 
     "$g^2$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b4d30285-2dc1-9c46-ab4b-92147d180522"],
 ",\n\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       Cell[
        BoxData[
         FormBox[
          GridBox[{{
             Cell[
              TextData[{" ", 
                Cell["0", "InlineFormula"], " "}]], 
             Cell[
              TextData[{" ", 
                Cell[
                 BoxData[
                  RowBox[{"\[LongEqual]", "\[Epsilon]", 
                    StyleBox["g", "TI"], "+", "3", 
                    SuperscriptBox[
                    StyleBox["g", "TI"], "2"], "+", 
                    RowBox[{"(", 
                    RowBox[{"-", "\[Epsilon]", 
                    StyleBox["g", "TI"], "+", 
                    StyleBox["b", "TI"], 
                    SuperscriptBox[
                    StyleBox["g", "TI"], "2"]}], ")"}], 
                    RowBox[{"(", 
                    RowBox[{"1", "+", 
                    FractionBox[
                    RowBox[{"6", 
                    StyleBox["g", "TI"]}], "\[Epsilon]"]}], ")"}], "+", 
                    StyleBox["O", "TI"], 
                    RowBox[{"(", 
                    SuperscriptBox[
                    StyleBox["g", "TI"], "3"], ")"}]}]], "InlineFormula"], 
                " "}]]}, {
             Cell[
              TextData[{" ", 
                Cell["\[Null]", "InlineFormula"], " "}]], 
             Cell[
              TextData[{" ", 
                Cell[
                 BoxData[
                  RowBox[{"\[LongEqual]", "\[Epsilon]", 
                    StyleBox["g", "TI"], "+", "3", 
                    SuperscriptBox[
                    StyleBox["g", "TI"], "2"], "-", "\[Epsilon]", 
                    StyleBox["g", "TI"], "-", "6", 
                    SuperscriptBox[
                    StyleBox["g", "TI"], "2"], "+", 
                    StyleBox["b", "TI"], 
                    SuperscriptBox[
                    StyleBox["g", "TI"], "2"], "+", 
                    StyleBox["O", "TI"], 
                    RowBox[{"(", 
                    SuperscriptBox[
                    StyleBox["g", "TI"], "3"], ")"}]}]], "InlineFormula"], 
                " "}]]}, {
             Cell[
              TextData[{" ", 
                Cell["\[Null]", "InlineFormula"], " "}]], 
             Cell[
              TextData[{" ", 
                Cell[
                 BoxData[
                  RowBox[{"\[LongEqual]", 
                    RowBox[{"(", 
                    RowBox[{
                    StyleBox["b", "TI"], "-", "3"}], ")"}], 
                    SuperscriptBox[
                    StyleBox["g", "TI"], "2"], "+", 
                    StyleBox["O", "TI"], 
                    RowBox[{"(", 
                    SuperscriptBox[
                    StyleBox["g", "TI"], "3"], ")"}], "."}]], 
                 "InlineFormula"], " "}]]}}], TraditionalForm]]], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "$\\begin{aligned} 0 &=\\epsilon g+3g^2 +\\left(-\\epsilon g+b \
g^2\\right) \\left(1+\\frac{6g}{\\epsilon}\\right)+O(g^3)\\\\ &=\\epsilon \
g+3g^2-\\epsilon g-6g^2+b g^2+O(g^3)\\\\ &=(b-3)g^2+O(g^3). \\end{aligned}$", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b68dc66c-0eec-6d47-ace0-5db15ad1f7f7"],
 "\n\nTherefore,\n\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         RowBox[{
           SubscriptBox["\[Beta]", 
            StyleBox["g", "TI"]], "\[LongEqual]", "-", "\[Epsilon]", 
           StyleBox["g", "TI"], "+", "3", 
           SuperscriptBox[
            StyleBox["g", "TI"], "2"], "+", 
           StyleBox["O", "TI"], 
           RowBox[{"(", 
             SuperscriptBox[
              StyleBox["g", "TI"], "3"], ")"}], "."}], 
         RowBox[{
           StyleBox["B", "TI"], "-", "27"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "$\\boxed{ \\beta_g=-\\epsilon g+3g^2+O(g^3). } \\tag{B-27}$", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d86780f5-0883-1a4c-8b7b-a50041a11679"],
 "\n\nThe ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"-", "\[Epsilon]", 
         StyleBox["g", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "$-\\epsilon g$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ad0deed8-ad73-4141-8bad-31f5b3da598c"],
 " term comes from the engineering dimension of the coupling. It must be \
retained during differentiation: its product with the pole term contributes \
at order ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox[
        StyleBox["g", "TI"], "2"], TraditionalForm], "errors" -> {}, "input" -> 
     "$g^2$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "cb5e79ad-851a-c943-93e2-41c05cebc6af"],
 ".\n\n3. Fixed point through order ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Epsilon]", TraditionalForm], "errors" -> {}, 
     "input" -> "$\\epsilon$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "8baaefc2-9dd3-f048-a68d-a87a7a0b1e9c"],
 "\n\nSolving ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[Beta]", 
          StyleBox["g", "TI"]], 
         RowBox[{"(", 
           SubscriptBox[
            StyleBox["g", "TI"], "*"], ")"}], "\[LongEqual]", "0"}], 
       TraditionalForm], "errors" -> {}, "input" -> "$\\beta_g(g_*)=0$", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "69279b09-9d77-9f47-a13c-3d0cd5b365dd"],
 " gives\n\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"0", "\[LongEqual]", 
         SubscriptBox[
          StyleBox["g", "TI"], "*"], 
         RowBox[{"[", 
           RowBox[{"-", "\[Epsilon]", "+", "3", 
             SubscriptBox[
              StyleBox["g", "TI"], "*"], "+", 
             StyleBox["O", "TI"], 
             RowBox[{"(", 
               SubsuperscriptBox[
                StyleBox["g", "TI"], "*", "2"], ")"}]}], "]"}], "."}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "$0=g_*\\left[-\\epsilon+3g_*+O(g_*^2)\\right].$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "73815eb8-3a1e-3c4f-99b9-2593fb13fa4e"],
 "\n\nHence\n\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         RowBox[{
           SubsuperscriptBox[
            StyleBox["g", "TI"], 
            StyleBox["G", FontSlant -> "Plain"], "*"], "\[LongEqual]", "0", 
           ",    ", 
           SubsuperscriptBox[
            StyleBox["g", "TI"], 
            StyleBox["WF", FontSlant -> "Plain"], "*"], "\[LongEqual]", 
           FractionBox["\[Epsilon]", "3"], "+", 
           StyleBox["O", "TI"], 
           RowBox[{"(", 
             SuperscriptBox["\[Epsilon]", "2"], ")"}], "."}], 
         RowBox[{
           StyleBox["B", "TI"], "-", "28"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "$\\boxed{ g_{\\mathrm G}^*=0, \\qquad \
g_{\\mathrm{WF}}^*=\\frac{\\epsilon}{3}+O(\\epsilon^2). } \\tag{B-28}$", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "6a647dab-50f5-864f-a543-d93bb950d3ed"],
 "\n\nThe nonzero solution is the Wilson\[Dash]Fisher fixed point for small \
positive ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Epsilon]", TraditionalForm], "errors" -> {}, 
     "input" -> "$\\epsilon$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "8fe8a907-ad8b-e942-9b9b-7ba8b99bfa3b"],
 ".\n\nChapter 21 check. The supplied notes give the leading small-",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Epsilon]", TraditionalForm], "errors" -> {}, 
     "input" -> "$\\epsilon$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "5766c80e-399d-dd4a-9f9f-28baa5777a2a"],
 " beta function on printed p. 219 and\n\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[Lambda]", "*"], "\[LongEqual]", 
         FractionBox[
          SuperscriptBox[
           RowBox[{"(", 
             RowBox[{"4", "\[Pi]"}], ")"}], "2"], "3"], "\[Epsilon]", "+", 
         StyleBox["O", "TI"], 
         RowBox[{"(", 
           SuperscriptBox["\[Epsilon]", "2"], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "$\\lambda_*=\\frac{(4\\pi)^2}{3}\\epsilon+O(\\epsilon^2)$", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d2446fcb-f734-9649-96c1-593e155a36af"],
 "\n\nin Eq. (21.9), printed p. 220. Dividing by $16\\pi^2$ reproduces B-28. \
Chapter 21 uses a finite symmetric-momentum subtraction condition, so this is \
a check of the leading result\[LongDash]not an identification of that scheme \
with MS.\n\n4. Establishing the one-loop field counterterm\n\nUsing our \
Euclidean sign convention, the two-point vertex is\n\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox["\[CapitalGamma]", 
          RowBox[{"(", "2", ")"}]], 
         RowBox[{"(", 
           StyleBox["p", "TI"], ")"}], "\[LongEqual]", 
         SuperscriptBox[
          StyleBox["p", "TI"], "2"], "+", 
         SuperscriptBox[
          StyleBox["m", "TI"], "2"], "+", "\[Delta]", 
         SubscriptBox[
          StyleBox["Z", "TI"], "\[Phi]"], 
         SuperscriptBox[
          StyleBox["p", "TI"], "2"], "+", "\[Delta]", 
         SuperscriptBox[
          StyleBox["m", "TI"], "2"], "+", 
         FractionBox["\[Lambda]", "2"], 
         SubscriptBox[
          StyleBox["T", "TI"], 
          StyleBox["DR", FontSlant -> "Plain"]], "+", 
         StyleBox["O", "TI"], 
         RowBox[{"(", 
           SuperscriptBox["\[Lambda]", "2"], ")"}], "."}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "$\\Gamma^{(2)}(p) = p^2+m^2+\\delta Z_\\phi p^2+\\delta m^2 \
+\\frac{\\lambda}{2}T_{\\mathrm{DR}}+O(\\lambda^2).$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "61e7b714-ee04-e043-824e-be2edcc64dc7"],
 "\n\nFrom B-08,\n\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         FractionBox["\[Lambda]", "2"], 
         SubscriptBox[
          StyleBox["T", "TI"], 
          StyleBox["DR", FontSlant -> "Plain"]], "\[LongEqual]", 
         FractionBox[
          RowBox[{
            StyleBox["g", "TI"], 
            SuperscriptBox[
             StyleBox["m", "TI"], "2"]}], "2"], 
         RowBox[{"[", 
           RowBox[{"-", 
             FractionBox["2", "\[Epsilon]"], "+", 
             SubscriptBox["\[Gamma]", 
              StyleBox["E", "TI"]], "-", "1", "-", "ln", 
             FractionBox[
              RowBox[{"4", 
                SuperscriptBox["\[Pi]\[Mu]", "2"]}], 
              SuperscriptBox[
               StyleBox["m", "TI"], "2"]]}], "]"}], "+", 
         StyleBox["O", "TI"], 
         RowBox[{"(", "\[Epsilon]", ")"}], "."}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "$\\frac{\\lambda}{2}T_{\\mathrm{DR}} = \\frac{g m^2}{2} \\left[ \
-\\frac{2}{\\epsilon} +\\gamma_E-1-\\ln\\frac{4\\pi\\mu^2}{m^2} \
\\right]+O(\\epsilon).$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "2676bdab-2ee9-a047-a646-9f1527df4098"],
 "\n\nThus its pole is\n\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          RowBox[{
            RowBox[{
              FractionBox["\[Lambda]", "2"], 
              SubscriptBox[
               StyleBox["T", "TI"], 
               StyleBox["DR", FontSlant -> "Plain"]]}], 
            "\[VerticalSeparator]"}], 
          StyleBox["pole", FontSlant -> "Plain"]], "\[LongEqual]", "-", 
         FractionBox[
          RowBox[{
            StyleBox["g", "TI"], 
            SuperscriptBox[
             StyleBox["m", "TI"], "2"]}], "\[Epsilon]"], "."}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "$\\left.\\frac{\\lambda}{2}T_{\\mathrm{DR}}\\right|_{\\mathrm{pole}} =-\
\\frac{g m^2}{\\epsilon}.$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "31d2b390-da0f-9248-809e-8941d33c4c62"],
 "\n\nThis is proportional to ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox[
        StyleBox["m", "TI"], "2"], TraditionalForm], "errors" -> {}, "input" -> 
     "$m^2$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "9383ecde-c075-6a44-8033-cd7eb8c4b00b"],
 ", not to ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox[
        StyleBox["p", "TI"], "2"], TraditionalForm], "errors" -> {}, "input" -> 
     "$p^2$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "c5f2b743-a9ef-c840-813a-f94d82f5e5d4"],
 ". It is canceled by the MS mass counterterm\n\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Delta]", 
         SubsuperscriptBox[
          StyleBox["m", "TI"], 
          StyleBox["MS", FontSlant -> "Plain"], "2"], "\[LongEqual]", 
         FractionBox[
          RowBox[{
            StyleBox["g", "TI"], 
            SuperscriptBox[
             StyleBox["m", "TI"], "2"]}], "\[Epsilon]"]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "$\\delta m_{\\mathrm{MS}}^2=\\frac{g m^2}{\\epsilon}$", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "532f8649-be51-b64b-83dc-5de13b7ad65f"],
 "\n\nat this order. There is no momentum-dependent divergence requiring a \
field counterterm.\n\nMore directly, the external momentum never enters the \
tadpole integral:\n\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         RowBox[{
           SubsuperscriptBox["\[CapitalSigma]", 
            StyleBox["tad", FontSlant -> "Plain"], 
            RowBox[{"(", "1", ")"}]], 
           RowBox[{"(", 
             StyleBox["p", "TI"], ")"}], "\[LongEqual]", 
           FractionBox["\[Lambda]", "2"], 
           SubscriptBox[
            StyleBox["T", "TI"], 
            StyleBox["DR", FontSlant -> "Plain"]], ",    ", 
           FractionBox[
            RowBox[{"\[PartialD]", 
              SubsuperscriptBox["\[CapitalSigma]", 
               StyleBox["tad", FontSlant -> "Plain"], 
               RowBox[{"(", "1", ")"}]]}], 
            RowBox[{"\[PartialD]", 
              SuperscriptBox[
               StyleBox["p", "TI"], "2"]}]], "\[LongEqual]", "0", ",    ", 
           "\[Delta]", 
           SubsuperscriptBox[
            StyleBox["Z", "TI"], 
            RowBox[{"\[Phi]", ",", 
              StyleBox["MS", FontSlant -> "Plain"]}], 
            RowBox[{"(", "1", ")"}]], "\[LongEqual]", "0", ",    ", 
           SubscriptBox[
            StyleBox["Z", "TI"], "\[Phi]"], "\[LongEqual]", "1", "+", 
           StyleBox["O", "TI"], 
           RowBox[{"(", 
             SuperscriptBox[
              StyleBox["g", "TI"], "2"], ")"}], "."}], 
         RowBox[{
           StyleBox["B", "TI"], "-", "29"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "$\\boxed{ \\Sigma_{\\mathrm{tad}}^{(1)}(p) \
=\\frac{\\lambda}{2}T_{\\mathrm{DR}}, \\qquad \
\\frac{\\partial\\Sigma_{\\mathrm{tad}}^{(1)}}{\\partial p^2}=0, \\qquad \
\\delta Z_{\\phi,\\mathrm{MS}}^{(1)}=0, \\qquad Z_\\phi=1+O(g^2). } \
\\tag{B-29}$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "72bbdbad-acfe-1b4c-a5e7-65cc149ac680"],
 "\n\nThis establishes the result in the massive theory. We have not set the \
tadpole to zero by using a scaleless massless DR integral.\n\n5. Why the \
tadpole cannot change the momentum exponent\n\nThe tadpole changes only the \
momentum-independent part of the inverse propagator. After MS subtraction,\n\n\
",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubsuperscriptBox["\[CapitalGamma]", 
          StyleBox["R", "TI"], 
          RowBox[{"(", "2", ")"}]], 
         RowBox[{"(", 
           StyleBox["p", "TI"], ")"}], "\[LongEqual]", 
         SuperscriptBox[
          StyleBox["p", "TI"], "2"], "+", 
         SuperscriptBox[
          StyleBox["m", "TI"], "2"], "+", 
         FractionBox[
          RowBox[{
            StyleBox["g", "TI"], 
            SuperscriptBox[
             StyleBox["m", "TI"], "2"]}], "2"], 
         RowBox[{"[", 
           RowBox[{
             SubscriptBox["\[Gamma]", 
              StyleBox["E", "TI"]], "-", "1", "-", "ln", 
             FractionBox[
              RowBox[{"4", 
                SuperscriptBox["\[Pi]\[Mu]", "2"]}], 
              SuperscriptBox[
               StyleBox["m", "TI"], "2"]]}], "]"}], "+", 
         StyleBox["O", "TI"], 
         RowBox[{"(", 
           SuperscriptBox[
            StyleBox["g", "TI"], "2"], ")"}], "."}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "$\\Gamma_R^{(2)}(p) = p^2+m^2+ \\frac{g m^2}{2} \\left[ \
\\gamma_E-1-\\ln\\frac{4\\pi\\mu^2}{m^2} \\right] +O(g^2).$", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "38aa02a2-1249-e94c-9ef4-424c00412416"],
 "\n\nThe coefficient and power of ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox[
        StyleBox["p", "TI"], "2"], TraditionalForm], "errors" -> {}, "input" -> 
     "$p^2$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d5de5549-34b0-2749-9786-62e0373be6dd"],
 " remain unchanged at one loop.\n\nTo see the distinction, an anomalous \
momentum power would have an expansion of the form\n\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox[
          RowBox[{"(", 
            SuperscriptBox[
             StyleBox["p", "TI"], "2"], ")"}], 
          RowBox[{"1", "-", "\[Eta]", "/", "2"}]], "\[Proportional]", 
         SuperscriptBox[
          StyleBox["p", "TI"], "2"], 
         RowBox[{"[", 
           RowBox[{"1", "-", 
             FractionBox["\[Eta]", "2"], "ln", 
             FractionBox[
              SuperscriptBox[
               StyleBox["p", "TI"], "2"], 
              SuperscriptBox["\[Mu]", "2"]], "+", "\[CenterEllipsis]"}], 
           "]"}], "."}], TraditionalForm], "errors" -> {}, "input" -> 
     "$(p^2)^{1-\\eta/2} \\propto p^2\\left[ \
1-\\frac{\\eta}{2}\\ln\\frac{p^2}{\\mu^2}+\\cdots \\right].$", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "20ce5979-8073-5e4d-ad3a-d9d4324ec2a1"],
 "\n\nA change of exponent therefore requires momentum-dependent logarithms. \
A constant tadpole self-energy cannot generate a term ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox[
          StyleBox["p", "TI"], "2"], "ln", 
         RowBox[{"(", 
           RowBox[{
             SuperscriptBox[
              StyleBox["p", "TI"], "2"], "/", 
             SuperscriptBox["\[Mu]", "2"]}], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> "$p^2\\ln(p^2/\\mu^2)$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f1cde6b9-df38-ae45-bcbd-9ee42349d483"],
 ". Its mass logarithm is not a momentum logarithm.\n\nEquivalently, with the \
field anomalous-dimension convention used in Part 2,\n\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         RowBox[{
           SubscriptBox["\[Gamma]", "\[Phi]"], 
           RowBox[{"(", 
             StyleBox["g", "TI"], ")"}], "\[LongEqual]", 
           FractionBox["1", "2"], 
           SubscriptBox[
            RowBox[{
              RowBox[{"\[Mu]", 
                FractionBox[
                 RowBox[{
                   StyleBox["d", "TI"], "ln", 
                   SubscriptBox[
                    StyleBox["Z", "TI"], "\[Phi]"]}], 
                 RowBox[{
                   StyleBox["d", "TI"], "\[Mu]"}]]}], 
              "\[VerticalSeparator]"}], 
            StyleBox["bare", FontSlant -> "Plain"]], "\[LongEqual]", 
           StyleBox["O", "TI"], 
           RowBox[{"(", 
             SuperscriptBox[
              StyleBox["g", "TI"], "2"], ")"}], ",    ", "\[Eta]", 
           "\[LongEqual]", "2", 
           SubscriptBox["\[Gamma]", "\[Phi]"], 
           RowBox[{"(", 
             SubscriptBox[
              StyleBox["g", "TI"], "*"], ")"}], "\[LongEqual]", 
           StyleBox["O", "TI"], 
           RowBox[{"(", 
             SuperscriptBox["\[Epsilon]", "2"], ")"}], ",    ", 
           SubscriptBox[
            StyleBox["G", "TI"], 
            StyleBox["crit", FontSlant -> "Plain"]], 
           RowBox[{"(", 
             StyleBox["p", "TI"], ")"}], "\[Proportional]", 
           SuperscriptBox[
            RowBox[{"(", 
              SuperscriptBox[
               StyleBox["p", "TI"], "2"], ")"}], 
            RowBox[{"-1", "+", "\[Eta]", "/", "2"}]], "."}], 
         RowBox[{
           StyleBox["B", "TI"], "-", "30"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "$\\boxed{ \\gamma_\\phi(g) =\\frac12 \\left.\\mu\\frac{d\\ln Z_\\phi}{d\
\\mu}\\right|_{\\mathrm{bare}} =O(g^2), \\qquad \
\\eta=2\\gamma_\\phi(g_*)=O(\\epsilon^2), \\qquad \
G_{\\mathrm{crit}}(p)\\propto(p^2)^{-1+\\eta/2}. } \\tag{B-30}$", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "851ac82e-e42e-3848-a31a-0619be0ce473"],
 "\n\nThus there is no one-loop correction to the momentum exponent. This \
does not establish ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Eta]", "\[LongEqual]", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "$\\eta=0$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "73f24f4d-ea8c-884f-9b15-0cb3e6605032"],
 " to all orders: the first possible contribution starts at two loops.\n\nThe \
critical power-law statement anticipates Part 2, where the mass is tuned to \
criticality. In Part 1, $m^2>0$, and the massive propagator is not itself a \
pure critical power law. Chapter 21 corroborates the perturbative order \
through its statements ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox["\[CapitalGamma]", 
          RowBox[{"(", "2", ")"}]], 
         RowBox[{"(", 
           SuperscriptBox[
            StyleBox["p", "TI"], "2"], ")"}], "\[LongEqual]", 
         SuperscriptBox[
          StyleBox["p", "TI"], "2"], "+", 
         StyleBox["O", "TI"], 
         RowBox[{"(", 
           SuperscriptBox["\[Lambda]", "2"], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> "$\\Gamma^{(2)}(p^2)=p^2+O(\\lambda^2)$", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "191c9557-b6d5-d547-a921-a49a3c33c0bf"],
 " on printed p. 218 and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Gamma]", 
         RowBox[{"(", "\[Lambda]", ")"}], "\[LongEqual]", 
         StyleBox["O", "TI"], 
         RowBox[{"(", 
           SuperscriptBox["\[Lambda]", "2"], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> "$\\gamma(\\lambda)=O(\\lambda^2)$", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "c252769b-d79e-a042-865c-a7940c542e6b"],
 " on printed p. 219.\n\n6. MS versus subsection 1.3\n\nSubsection 1.3 \
imposed finite zero-momentum normalization conditions. In particular,\n\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[Delta]\[Lambda]", "1.3"], "\[LongEqual]", 
         FractionBox[
          RowBox[{"3", 
            SuperscriptBox["\[Lambda]", "2"]}], "2"], 
         SubscriptBox[
          StyleBox["B", "TI"], 
          StyleBox["DR", FontSlant -> "Plain"]], 
         RowBox[{"(", "0", ")"}], ",    ", "\[Delta]", 
         SubsuperscriptBox[
          StyleBox["m", "TI"], "1.3", "2"], "\[LongEqual]", "-", 
         FractionBox["\[Lambda]", "2"], 
         SubscriptBox[
          StyleBox["T", "TI"], 
          StyleBox["DR", FontSlant -> "Plain"]], ","}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "$\\delta\\lambda_{\\text{1.3}} \
=\\frac{3\\lambda^2}{2}B_{\\mathrm{DR}}(0), \\qquad \\delta m_{\\text{1.3}}^2 \
=-\\frac{\\lambda}{2}T_{\\mathrm{DR}},$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "51888590-728e-ec4f-ad81-4a1d23dddcbb"],
 "\n\nwhich cancel both poles and finite corrections at the subtraction \
point.\n\nMS instead keeps only the pole parts of these counterterms. \
Consequently, the MS parameters need not satisfy ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubsuperscriptBox["\[CapitalGamma]", 
          StyleBox["R", "TI"], 
          RowBox[{"(", "2", ")"}]], 
         RowBox[{"(", "0", ")"}], "\[LongEqual]", 
         SuperscriptBox[
          StyleBox["m", "TI"], "2"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "$\\Gamma_R^{(2)}(0)=m^2$ or $\\Gamma_R^{(4)}(0)=\\lambda$", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "4c124c2a-9cfe-c64e-85f6-33e4625ebbf1"],
 ". The one-loop field counterterm nevertheless vanishes in both \
prescriptions, because the tadpole has no momentum dependence.\n\nThe \
requested conclusions are therefore\n\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[Beta]", 
          StyleBox["g", "TI"]], "\[LongEqual]", "-", "\[Epsilon]", 
         StyleBox["g", "TI"], "+", "3", 
         SuperscriptBox[
          StyleBox["g", "TI"], "2"], "+", 
         StyleBox["O", "TI"], 
         RowBox[{"(", 
           SuperscriptBox[
            StyleBox["g", "TI"], "3"], ")"}], ",    ", 
         SubscriptBox[
          StyleBox["g", "TI"], "*"], "\[LongEqual]", 
         FractionBox["\[Epsilon]", "3"], "+", 
         StyleBox["O", "TI"], 
         RowBox[{"(", 
           SuperscriptBox["\[Epsilon]", "2"], ")"}], ",    ", "\[Delta]", 
         SubsuperscriptBox[
          StyleBox["Z", "TI"], "\[Phi]", 
          RowBox[{"(", "1", ")"}]], "\[LongEqual]", "0", ","}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "$\\boxed{ \\beta_g=-\\epsilon g+3g^2+O(g^3),\\qquad \
g_*=\\frac{\\epsilon}{3}+O(\\epsilon^2),\\qquad \\delta Z_\\phi^{(1)}=0, }$", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "eaefbd90-664f-b34b-a980-1f6327dd2824"],
 "\n\ntogether with the reason: the tadpole renormalizes the mass, not the \
momentum dependence of the propagator.\nThe code below confirms our \
derivations."
}], "Text",
 CellChangeTimes->{{4.004270093269724*^9, 4.0042704716561337`*^9}, {
  4.0042742705244064`*^9, 
  4.0042742811668854`*^9}},ExpressionUUID->"070fe236-4bae-6f45-b4c6-\
e9a86fe6c5f4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
      "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
      "===", "==="}], "="}], "*)"}], 
  RowBox[{"(*", 
   RowBox[{"SUBSECTION", " ", "1.4", " ", "VALIDATION", " ", 
    RowBox[{"(", 
     RowBox[{"Cleaned", " ", "Mathematica", " ", "Code"}], ")"}]}], "*)"}], 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
      "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
      "===", "==="}], "="}], "*)"}], 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"1.", " ", "Define", " ", "bare", " ", "coupling", " ", 
     RowBox[{"relation", ":", "g0"}]}], "=", 
    RowBox[{
     RowBox[{"mu", "^", "eps"}], "*", 
     RowBox[{"(", 
      RowBox[{"g", "+", 
       RowBox[{"3", "*", 
        RowBox[{
         RowBox[{"g", "^", "2"}], "/", "eps"}]}]}], ")"}]}]}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"g0Rel", "[", 
      RowBox[{"g_", ",", "eps_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"mu", "^", "eps"}], "*", 
      RowBox[{"(", 
       RowBox[{"g", "+", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"3", "*", 
           RowBox[{"g", "^", "2"}]}], ")"}], "/", "eps"}]}], ")"}]}]}], ";"}],
    "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{
      "2.", " ", "Verify", " ", "beta", " ", "function", " ", "via", " ", 
       "fixed"}], "-", 
      RowBox[{"bare", " ", 
       RowBox[{"condition", ":", 
        RowBox[{"mu", "*", 
         RowBox[{"dg", "/", "dmu"}]}]}]}]}], "=", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "eps"}], "*", "g"}], "+", 
      RowBox[{"b", "*", 
       RowBox[{"g", "^", "2"}]}]}]}], "*)"}], "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Expand", " ", "the", " ", "total", " ", "derivative", " ", "of", " ", 
     "g0", " ", "with", " ", "respect", " ", "to", " ", "mu", " ", "to", " ", 
     "order", " ", 
     RowBox[{"g", "^", "2"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"eq", "=", 
     RowBox[{"Series", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"eps", "*", 
         RowBox[{"g0Rel", "[", 
          RowBox[{"g", ",", "eps"}], "]"}]}], "+", 
        RowBox[{"betaG", "*", 
         RowBox[{"D", "[", 
          RowBox[{
           RowBox[{"g0Rel", "[", 
            RowBox[{"g", ",", "eps"}], "]"}], ",", "g"}], "]"}]}]}], ",", 
       RowBox[{"{", 
        RowBox[{"g", ",", "0", ",", "2"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"bSol", "=", 
     RowBox[{"Solve", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Coefficient", "[", 
         RowBox[{
          RowBox[{"Normal", "[", "eq", "]"}], ",", 
          RowBox[{"g", "^", "2"}]}], "]"}], "==", "0"}], ",", "betaG"}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
     "Substitute", " ", "betaG", " ", "ansatz", " ", "parameter", " ", "to", " ",
       "find", " ", "the", " ", "coefficient", " ", "b"}], "=", "3"}], "*)"}],
    "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"betaGResult", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "eps"}], "*", "g"}], "+", 
      RowBox[{"3", "*", 
       RowBox[{"g", "^", "2"}]}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Validated Beta Function beta_g: \>\"", ",", "betaGResult"}],
      "]"}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"3.", " ", "Solve", " ", "for", " ", "Wilson"}], "-", 
      RowBox[{
      "Fisher", " ", "fixed", " ", "point", " ", "where", " ", "beta_g"}]}], "=",
      "0"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"wfFixedPoint", "=", 
     RowBox[{"Solve", "[", 
      RowBox[{
       RowBox[{"betaGResult", "==", "0"}], ",", "g"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"gWF", "=", 
     RowBox[{"g", "/.", " ", 
      RowBox[{"wfFixedPoint", "[", 
       RowBox[{"[", "2", "]"}], "]"}]}]}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Select", " ", "non"}], "-", 
     RowBox[{"zero", " ", "root"}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Wilson-Fisher Fixed Point g_* = \>\"", ",", "gWF"}], "]"}], 
    ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "4.", " ", "Verify", " ", "tadpole", " ", "momentum", " ", "independence",
      " ", "and", " ", "field", " ", "counterterm"}], "*)"}], "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Treat", " ", "momentum"}], "-", 
     RowBox[{
     "squared", " ", "as", " ", "a", " ", "symbol", " ", "pSq", " ", 
      "instead", " ", "of", " ", "expression", " ", 
      RowBox[{"p", "^", "2"}], " ", "for", " ", "differentiation"}]}], "*)"}],
    "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"tadpolePole", "[", 
      RowBox[{"m2_", ",", "eps_", ",", "g_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"-", 
       RowBox[{"(", 
        RowBox[{"g", "*", "m2"}], ")"}]}], "/", "eps"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"fieldCountertermDerivative", "=", 
     RowBox[{"D", "[", 
      RowBox[{
       RowBox[{"tadpolePole", "[", 
        RowBox[{"m2", ",", "eps", ",", "g"}], "]"}], ",", "pSq"}], "]"}]}], 
    ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Tadpole momentum dependence (d/dpSq Sigma_tad): \>\"", ",", 
      "fieldCountertermDerivative"}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<One-loop field counterterm delta Z_phi^(1): 0 (tadpole \
has no momentum dependence)\>\"", "]"}], ";"}]}]}]], "Input",
 CellChangeTimes->{{4.0042733199925976`*^9, 4.0042733199925976`*^9}},
