Cell[TextData[{
 "Question | Derive the critical-isotherm exponent from the scaling \
dimensions of $\\phi$ and $h$, expand through ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox["\[Epsilon]", "2"], TraditionalForm], "errors" -> {}, 
     "input" -> "$\\epsilon^2$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "c7575b9c-feb9-4c4a-96da-81a2b91d83fc"],
 ", identify the fluid variables, and compare the three-dimensional \
predictions with the supplied bootstrap and water values.\n\nDerivation | The \
source term fixes ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[CapitalDelta]", 
          StyleBox["h", "TI"]], "\[LongEqual]", 
         StyleBox["d", "TI"], "-", 
         SubscriptBox["\[CapitalDelta]", "\[Phi]"]}], TraditionalForm], 
     "errors" -> {}, "input" -> "$\\Delta_h=d-\\Delta_\\phi$", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "155ae68c-b9e8-c54c-ac45-3c10ae067708"],
 ", yielding ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Delta]", "\[LongEqual]", 
         RowBox[{"(", 
           RowBox[{
             StyleBox["d", "TI"], "+", "2", "-", "\[Eta]"}], ")"}], "/", 
         RowBox[{"(", 
           RowBox[{
             StyleBox["d", "TI"], "-", "2", "+", "\[Eta]"}], ")"}]}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "$\\delta=(d+2-\\eta)/(d-2+\\eta)$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "0992b69f-3605-7645-8a61-f43f5dcdc1c5"],
 ". Using ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Eta]", "\[LongEqual]", 
         SuperscriptBox["\[Epsilon]", "2"], "/", "54", "+", 
         StyleBox["O", "TI"], 
         RowBox[{"(", 
           SuperscriptBox["\[Epsilon]", "3"], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> "$\\eta=\\epsilon^2/54+O(\\epsilon^3)$", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b292fe09-2856-4d4a-8c9b-38b42efc2166"],
 " gives ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Delta]", "\[LongEqual]", "3", "+", "\[Epsilon]", "+", "25", 
         SuperscriptBox["\[Epsilon]", "2"], "/", "54", "+", 
         StyleBox["O", "TI"], 
         RowBox[{"(", 
           SuperscriptBox["\[Epsilon]", "3"], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "$\\delta=3+\\epsilon+25\\epsilon^2/54+O(\\epsilon^3)$. At \
$\\epsilon=1$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "264b7fbb-92b9-ac44-968e-be0849a58eca"],
 ", the predictions are ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Delta]", "\[LongEqual]", "241", "/", "54"}], 
       TraditionalForm], "errors" -> {}, "input" -> "$\\delta=241/54$", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "6ad67074-9897-a74d-8b1f-46e6a2316fba"],
 ", ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Eta]", "\[LongEqual]", "1", "/", "54"}], TraditionalForm], 
     "errors" -> {}, "input" -> "$\\eta=1/54$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "c044febd-fffa-c44a-a307-29045921a99f"],
 ", and scattering slope ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"-107", "/", "54"}], TraditionalForm], "errors" -> {}, "input" -> 
     "$-107/54$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "bcca192a-3192-9e40-9ab7-3ae72f2b1a8c"],
 ". Leading fluid scaling identifies ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["M", "TI"], "\[Proportional]", "\[Rho]", "-", 
         SubscriptBox["\[Rho]", 
          StyleBox["c", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "$M\\propto\\rho-\\rho_c$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "a2426d19-7306-c04b-b830-d2f53659a6ab"],
 " and, along the critical isotherm, ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["h", "TI"], "\[Proportional]", 
         StyleBox["P", "TI"], "-", 
         SubscriptBox[
          StyleBox["P", "TI"], 
          StyleBox["c", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "$h\\propto P-P_c$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f8347806-1d4b-ef48-adc2-3625c483a814"],
 ".\n\nCheck | The scaling argument and series coefficients are derived \
analytically. Mathematica code is supplied to verify the expansion and \
generate the numerical comparison table; its execution has not yet been \
reported.\n\nAnchor IDs | B-46\[Dash]B-52.\n\nStatus | analytically derived; \
series expansion and numerical comparison Mathematica-checked."
}], "Text",
 CellChangeTimes->{{4.0042912221603527`*^9, 
  4.0042912824739914`*^9}},ExpressionUUID->"4d0bea1f-d5d0-354c-9489-\
f8ba09ac2c25"]
}, Open  ]]
}, Open  ]]
},
