Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Clear", "[", 
    RowBox[{
    "epsDR", ",", "massSq", ",", "muScale", ",", "tDRExact", ",", "bDRExact", 
     ",", "tDRFinite", ",", "bDRFinite"}], "]"}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"tDRExact", "=", 
    RowBox[{
     RowBox[{"massSq", "/", 
      RowBox[{"(", 
       RowBox[{"16", " ", 
        RowBox[{"Pi", "^", "2"}]}], ")"}]}], "*", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"4", " ", "Pi", " ", 
        RowBox[{
         RowBox[{"muScale", "^", "2"}], "/", "massSq"}]}], ")"}], "^", 
      RowBox[{"(", 
       RowBox[{"epsDR", "/", "2"}], ")"}]}], "*", 
     RowBox[{"Gamma", "[", 
      RowBox[{
       RowBox[{"-", "1"}], "+", 
       RowBox[{"epsDR", "/", "2"}]}], "]"}]}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"bDRExact", "=", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{"4", " ", "Pi", " ", 
        RowBox[{
         RowBox[{"muScale", "^", "2"}], "/", "massSq"}]}], ")"}], "^", 
      RowBox[{"(", 
       RowBox[{"epsDR", "/", "2"}], ")"}]}], "*", 
     RowBox[{
      RowBox[{"Gamma", "[", 
