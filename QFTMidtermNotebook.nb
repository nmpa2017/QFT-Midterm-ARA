                    StyleBox["q", "TI"]}], ")"}], "2"], "]"}], "\[Beta]"]}]], 
         "."}], TraditionalForm], "errors" -> {}, "input" -> 
     "$J_{\\alpha,\\beta}(Q) = \\int\\frac{d^dq}{(2\\pi)^d} \
\\frac{1}{(q^2)^\\alpha[(Q-q)^2]^\\beta}.$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "c0bda6dd-1904-824a-bbb1-d21bbe5e3bda"],
 "\n\nFeynman parametrization gives\n\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         FractionBox["1", 
          RowBox[{
            SuperscriptBox[
             StyleBox["A", "TI"], "\[Alpha]"], 
            SuperscriptBox[
             StyleBox["B", "TI"], "\[Beta]"]}]], "\[LongEqual]", 
         FractionBox[
          RowBox[{"\[CapitalGamma]", "(", 
            RowBox[{"\[Alpha]", "+", "\[Beta]"}], ")"}], 
          RowBox[{"\[CapitalGamma]", 
            RowBox[{"(", "\[Alpha]", ")"}], "\[CapitalGamma]", 
            RowBox[{"(", "\[Beta]", ")"}]}]], 
         SubsuperscriptBox["\[Integral]", "0", "1"], 
         StyleBox["d", "TI"], 
         StyleBox["x", "TI"], " ", 
         FractionBox[
          RowBox[{
            SuperscriptBox[
             StyleBox["x", "TI"], 
             RowBox[{"\[Alpha]", "-", "1"}]], 
            SuperscriptBox[
             RowBox[{"(", 
               RowBox[{"1", "-", 
                 StyleBox["x", "TI"]}], ")"}], 
             RowBox[{"\[Beta]", "-", "1"}]]}], 
          SuperscriptBox[
           RowBox[{"[", 
             RowBox[{
               StyleBox["x", "TI"], 
               StyleBox["A", "TI"], "+", 
               RowBox[{"(", 
                 RowBox[{"1", "-", 
                   StyleBox["x", "TI"]}], ")"}], 
               StyleBox["B", "TI"]}], "]"}], 
           RowBox[{"\[Alpha]", "+", "\[Beta]"}]]], "."}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "$\\frac{1}{A^\\alpha B^\\beta} = \\frac{\\Gamma(\\alpha+\\beta)} \
{\\Gamma(\\alpha)\\Gamma(\\beta)} \\int_0^1dx\\, \
\\frac{x^{\\alpha-1}(1-x)^{\\beta-1}} {[xA+(1-x)B]^{\\alpha+\\beta}}.$", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "fea19f41-6547-0a46-9a33-7fc6f3bc0b13"],
 "\n\nFor ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["A", "TI"], "\[LongEqual]", 
         SuperscriptBox[
          StyleBox["q", "TI"], "2"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "$A=q^2$", "state" -> "Boxes"|>,
