 FormBox[
  InterpretationBox[
   RowBox[{
    RowBox[{"-", 
     FractionBox["pSq", 
      RowBox[{"512", " ", 
       SuperscriptBox["\[Pi]", "4"], " ", "eps"}]]}], "+", 
    FractionBox[
     RowBox[{"pSq", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{"8", " ", 
          RowBox[{"log", "(", "mu", ")"}]}]}], "+", 
        RowBox[{"4", " ", 
         RowBox[{"log", "(", "pSq", ")"}]}], "+", 
        RowBox[{"4", " ", 
         TagBox["\[DoubledGamma]",
          Function[{}, EulerGamma]]}], "-", "13", "-", 
        RowBox[{"4", " ", 
         RowBox[{"log", "(", 
