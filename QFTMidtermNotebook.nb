\\left(\\frac{4\\pi\\mu^2}{p^2}\\right)^\\epsilon \\frac{ \
\\Gamma(\\epsilon-1)\\Gamma(1-\\epsilon/2)^3 }{ \\Gamma(3-3\\epsilon/2) }. } \
\\tag{B-35}$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ef4b1c25-02f8-4442-9f59-9b6021ea50ce"],
 "\n\nThe overall dimension is mass squared, as required for a two-point \
inverse-propagator correction.\n\n6. Laurent expansion through the finite \
term\n\nFirst,\n\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[CapitalGamma]", 
         RowBox[{"(", 
           RowBox[{"\[Epsilon]", "-", "1"}], ")"}], "\[LongEqual]", "-", 
         FractionBox["1", "\[Epsilon]"], "+", 
         SubscriptBox["\[Gamma]", 
          StyleBox["E", "TI"]], "-", "1", "+", 
         StyleBox["O", "TI"], 
         RowBox[{"(", "\[Epsilon]", ")"}], "."}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "$\\Gamma(\\epsilon-1) =-\\frac1\\epsilon+\\gamma_E-1+O(\\epsilon).$", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "95dbaeac-244e-0d45-8bff-4668c306c482"],
 "\n\nFor the remaining gamma-function ratio,\n\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[CapitalGamma]", 
         SuperscriptBox[
          RowBox[{"(", 
            RowBox[{"1", "-", "\[Epsilon]", "/", "2"}], ")"}], "3"], 
         "\[LongEqual]", "1", "+", 
         FractionBox["3", "2"], 
         SubscriptBox["\[Gamma]", 
          StyleBox["E", "TI"]], "\[Epsilon]", "+", 
         StyleBox["O", "TI"], 
         RowBox[{"(", 
           SuperscriptBox["\[Epsilon]", "2"], ")"}], ","}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "$\\Gamma(1-\\epsilon/2)^3 \
=1+\\frac32\\gamma_E\\epsilon+O(\\epsilon^2),$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "73a31fee-1294-b041-97a8-a1cefe470f0a"],
 "\n\nand\n\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         FractionBox["1", 
          RowBox[{"\[CapitalGamma]", "(", 
            RowBox[{"3", "-", "3", "\[Epsilon]", "/", "2"}], ")"}]], 
         "\[LongEqual]", 
         FractionBox["1", "2"], 
         RowBox[{"[", 
           RowBox[{"1", "+", 
             FractionBox["3", "2"], "\[Epsilon]", 
             RowBox[{"(", 
               RowBox[{
                 FractionBox["3", "2"], "-", 
                 SubscriptBox["\[Gamma]", 
                  StyleBox["E", "TI"]]}], ")"}], "+", 
             StyleBox["O", "TI"], 
             RowBox[{"(", 
               SuperscriptBox["\[Epsilon]", "2"], ")"}]}], "]"}], "."}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "$\\frac{1}{\\Gamma(3-3\\epsilon/2)} = \\frac12 \\left[ \
1+\\frac32\\epsilon\\left(\\frac32-\\gamma_E\\right) +O(\\epsilon^2) \
\\right].$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "cad689ee-5c81-8042-b48c-61e0f304a0a6"],
 "\n\nHence\n\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         FractionBox[
          RowBox[{"\[CapitalGamma]", 
            SuperscriptBox[
             RowBox[{"(", 
               RowBox[{"1", "-", "\[Epsilon]", "/", "2"}], ")"}], "3"]}], 
          RowBox[{"\[CapitalGamma]", "(", 
            RowBox[{"3", "-", "3", "\[Epsilon]", "/", "2"}], ")"}]], 
         "\[LongEqual]", 
         FractionBox["1", "2"], 
         RowBox[{"[", 
           RowBox[{"1", "+", 
             FractionBox["9", "4"], "\[Epsilon]", "+", 
             StyleBox["O", "TI"], 
             RowBox[{"(", 
               SuperscriptBox["\[Epsilon]", "2"], ")"}]}], "]"}], ","}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "$\\frac{\\Gamma(1-\\epsilon/2)^3} {\\Gamma(3-3\\epsilon/2)} = \
\\frac12\\left[1+\\frac94\\epsilon+O(\\epsilon^2)\\right],$", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "2a7ee44b-c640-a44f-ad0b-7c83b923015a"],
 "\n\nand therefore\n\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         FractionBox[
          RowBox[{"\[CapitalGamma]", 
            RowBox[{"(", 
              RowBox[{"\[Epsilon]", "-", "1"}], ")"}], "\[CapitalGamma]", 
            SuperscriptBox[
             RowBox[{"(", 
               RowBox[{"1", "-", "\[Epsilon]", "/", "2"}], ")"}], "3"]}], 
          RowBox[{"\[CapitalGamma]", "(", 
            RowBox[{"3", "-", "3", "\[Epsilon]", "/", "2"}], ")"}]], 
         "\[LongEqual]", "-", 
         FractionBox["1", 
          RowBox[{"2", "\[Epsilon]"}]], "+", 
         FractionBox[
          SubscriptBox["\[Gamma]", 
           StyleBox["E", "TI"]], "2"], "-", 
         FractionBox["13", "8"], "+", 
         StyleBox["O", "TI"], 
         RowBox[{"(", "\[Epsilon]", ")"}], "."}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "$\\frac{ \\Gamma(\\epsilon-1)\\Gamma(1-\\epsilon/2)^3 }{ \
\\Gamma(3-3\\epsilon/2) } = -\\frac{1}{2\\epsilon} \
+\\frac{\\gamma_E}{2}-\\frac{13}{8} +O(\\epsilon).$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "36b0032b-174f-bc43-983d-9c0a64a09d24"],
 "\n\nFinally,\n\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox[
          RowBox[{"(", 
            FractionBox[
             RowBox[{"4", 
               SuperscriptBox["\[Pi]\[Mu]", "2"]}], 
             SuperscriptBox[
              StyleBox["p", "TI"], "2"]], ")"}], "\[Epsilon]"], 
         "\[LongEqual]", "1", "+", "\[Epsilon]", "ln", 
         FractionBox[
          RowBox[{"4", 
            SuperscriptBox["\[Pi]\[Mu]", "2"]}], 
          SuperscriptBox[
           StyleBox["p", "TI"], "2"]], "+", 
         StyleBox["O", "TI"], 
         RowBox[{"(", 
           SuperscriptBox["\[Epsilon]", "2"], ")"}], "."}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "$\\left(\\frac{4\\pi\\mu^2}{p^2}\\right)^\\epsilon = \
1+\\epsilon\\ln\\frac{4\\pi\\mu^2}{p^2}+O(\\epsilon^2).$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "01c9c3cf-0b9d-134d-b28d-a40da595b1be"],
 "\n\nCombining these expansions,\n\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         RowBox[{
           StyleBox["H", "TI"], 
           RowBox[{"(", 
             StyleBox["p", "TI"], ")"}], "\[LongEqual]", "-", 
           FractionBox[
            SuperscriptBox[
             StyleBox["p", "TI"], "2"], 
            RowBox[{"2", 
              SuperscriptBox[
               RowBox[{"(", 
                 RowBox[{"16", 
                   SuperscriptBox["\[Pi]", "2"]}], ")"}], "2"]}]], 
           RowBox[{"[", 
             RowBox[{
               FractionBox["1", "\[Epsilon]"], "+", "ln", 
               FractionBox[
                RowBox[{"4", 
                  SuperscriptBox["\[Pi]\[Mu]", "2"]}], 
                SuperscriptBox[
                 StyleBox["p", "TI"], "2"]], "+", 
               FractionBox["13", "4"], "-", 
               SubscriptBox["\[Gamma]", 
                StyleBox["E", "TI"]]}], "]"}], "+", 
           StyleBox["O", "TI"], 
           RowBox[{"(", "\[Epsilon]", ")"}], "."}], 
         RowBox[{
           StyleBox["B", "TI"], "-", "36"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "$\\boxed{ H(p)= -\\frac{p^2}{2(16\\pi^2)^2} \\left[ \\frac1\\epsilon \
+\\ln\\frac{4\\pi\\mu^2}{p^2} +\\frac{13}{4}-\\gamma_E \\right] \
+O(\\epsilon). } \\tag{B-36}$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "45bbda11-2043-aa47-8903-2a3c187f35e2"],
 "\n\nIn particular,\n\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         RowBox[{
           SubscriptBox[
            RowBox[{
              RowBox[{
                StyleBox["H", "TI"], "(", 
                StyleBox["p", "TI"], ")"}], "\[VerticalSeparator]"}], 
            StyleBox["pole", FontSlant -> "Plain"]], "\[LongEqual]", "-", 
           FractionBox[
            SuperscriptBox[
             StyleBox["p", "TI"], "2"], 
            RowBox[{"2", 
              SuperscriptBox[
               RowBox[{"(", 
                 RowBox[{"16", 
                   SuperscriptBox["\[Pi]", "2"]}], ")"}], "2"], 
              "\[Epsilon]"}]], "."}], 
         RowBox[{
           StyleBox["B", "TI"], "-", "37"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "$\\boxed{ \\left.H(p)\\right|_{\\mathrm{pole}} = \
-\\frac{p^2}{2(16\\pi^2)^2\\epsilon}. } \\tag{B-37}$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f7e5da85-628d-664b-9ea6-847a7a2b4e21"],
 "\n\nThe negative pole is not inconsistent with the positive Euclidean \
integrand: the integral diverges near four dimensions, and B-36 is its \
dimensionally continued Laurent expansion, not a convergent positive integral \
evaluated at ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["d", "TI"], "\[LongEqual]", "4"}], TraditionalForm], 
     "errors" -> {}, "input" -> "$d=4$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "c79a3a19-6205-3d4f-8e53-aaa3dfd9f7fb"],
 ".\n\n7. Sunset contribution to the inverse propagator\n\nCombining B-31 \
with B-36, and using ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["g", "TI"], "\[LongEqual]", "\[Lambda]", "/", 
         RowBox[{"(", 
           RowBox[{"16", 
             SuperscriptBox["\[Pi]", "2"]}], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> "$g=\\lambda/(16\\pi^2)$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "a0d83900-3c8b-7846-85c5-027d64b1938d"],
 ", gives\n\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         RowBox[{
           SubsuperscriptBox["\[CapitalDelta]\[CapitalGamma]", 
            StyleBox["sunset", FontSlant -> "Plain"], 
            RowBox[{"(", "2", ")"}]], 
           RowBox[{"(", 
             StyleBox["p", "TI"], ")"}], "\[LongEqual]", 
           FractionBox[
            RowBox[{
              SuperscriptBox[
               StyleBox["g", "TI"], "2"], 
              SuperscriptBox[
               StyleBox["p", "TI"], "2"]}], "12"], 
           RowBox[{"[", 
             RowBox[{
               FractionBox["1", "\[Epsilon]"], "+", "ln", 
               FractionBox[
                RowBox[{"4", 
                  SuperscriptBox["\[Pi]\[Mu]", "2"]}], 
                SuperscriptBox[
                 StyleBox["p", "TI"], "2"]], "+", 
               FractionBox["13", "4"], "-", 
               SubscriptBox["\[Gamma]", 
                StyleBox["E", "TI"]]}], "]"}], "+", 
           StyleBox["O", "TI"], 
           RowBox[{"(", 
             RowBox[{
               SuperscriptBox[
                StyleBox["g", "TI"], "2"], "\[Epsilon]"}], ")"}], "."}], 
         RowBox[{
           StyleBox["B", "TI"], "-", "38"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "$\\boxed{ \\Delta\\Gamma_{\\mathrm{sunset}}^{(2)}(p) = \
\\frac{g^2p^2}{12} \\left[ \\frac1\\epsilon +\\ln\\frac{4\\pi\\mu^2}{p^2} \
+\\frac{13}{4}-\\gamma_E \\right] +O(g^2\\epsilon). } \\tag{B-38}$", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "0ccd2c00-f866-dc43-b145-b62d36ca851f"],
 "\n\nThus the momentum-dependent pole in the inverse propagator is positive:\
\n\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          RowBox[{
            RowBox[{
              SubsuperscriptBox["\[CapitalDelta]\[CapitalGamma]", 
               StyleBox["sunset", FontSlant -> "Plain"], 
               RowBox[{"(", "2", ")"}]], "(", 
              StyleBox["p", "TI"], ")"}], "\[VerticalSeparator]"}], 
          StyleBox["pole", FontSlant -> "Plain"]], "\[LongEqual]", 
         FractionBox[
          RowBox[{
            SuperscriptBox[
             StyleBox["g", "TI"], "2"], 
            SuperscriptBox[
             StyleBox["p", "TI"], "2"]}], 
          RowBox[{"12", "\[Epsilon]"}]], "."}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "$\\left.\\Delta\\Gamma_{\\mathrm{sunset}}^{(2)}(p)\\right|_{\\mathrm{\
pole}} =\\frac{g^2p^2}{12\\epsilon}.$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "cf07270f-90ab-8548-ba57-160bf7a86c7c"],
 "\n\nThe coefficient of the finite ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox[
          StyleBox["p", "TI"], "2"], "ln", 
         RowBox[{"(", 
           RowBox[{
             SuperscriptBox[
              StyleBox["p", "TI"], "2"], "/", 
             SuperscriptBox["\[Mu]", "2"]}], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> "$p^2\\ln(p^2/\\mu^2)$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f1b71a7c-8298-a04a-a4b2-ba941dd32c87"],
 " term is correspondingly ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"-", 
         SuperscriptBox[
          StyleBox["g", "TI"], "2"], "/", "12"}], TraditionalForm], 
     "errors" -> {}, "input" -> "$-g^2/12$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f898533f-88c2-4540-af23-f102e0a25600"],
 ". These are the ingredients we will use for field renormalization in \
subsection 2.2.\n8. Four-point subdivergences\n\nThe sunset contains three \
overlapping one-loop four-point subgraphs, corresponding to the three ways of \
selecting two of its three internal lines.\n\nEach divergent four-point \
subgraph is replaced, in the subtraction procedure, by a local coupling \
counterterm. Contracting that subgraph leaves a tadpole as the remaining \
loop. Its integral is proportional to\n\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox["\[Mu]", "\[Epsilon]"], "\[Integral]", 
         FractionBox[
          RowBox[{
            SuperscriptBox[
             StyleBox["d", "TI"], 
             StyleBox["d", "TI"]], 
            StyleBox["q", "TI"]}], 
          SuperscriptBox[
           RowBox[{"(", 
             RowBox[{"2", "\[Pi]"}], ")"}], 
           StyleBox["d", "TI"]]], 
         FractionBox["1", 
          SuperscriptBox[
           StyleBox["q", "TI"], "2"]], "."}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "$\\mu^\\epsilon\\int\\frac{d^dq}{(2\\pi)^d}\\frac1{q^2}.$", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "2d492280-8542-8b40-89a1-37994b7c1984"],
 "\n\nTwo facts are important:\n\nThis reduced graph has no external-momentum \
dependence.\nIn massless DR its integral is scaleless and vanishes.\n\n\
Therefore,\n\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         RowBox[{
           SubsuperscriptBox["\[CapitalDelta]\[CapitalGamma]", 
            StyleBox["4pt\\;CT", FontSlant -> "Plain"], 
            RowBox[{"(", "2", ")"}]], 
           RowBox[{"(", 
             StyleBox["p", "TI"], ")"}], " ", "\[Proportional] ", 
           SubscriptBox["\[Delta]\[Lambda]", 
            StyleBox["MS", FontSlant -> "Plain"]], " ", 
           SuperscriptBox["\[Mu]", "\[Epsilon]"], "\[Integral]", 
           FractionBox[
            RowBox[{
              SuperscriptBox[
               StyleBox["d", "TI"], 
               StyleBox["d", "TI"]], 
              StyleBox["q", "TI"]}], 
            SuperscriptBox[
             RowBox[{"(", 
               RowBox[{"2", "\[Pi]"}], ")"}], 
             StyleBox["d", "TI"]]], 
           FractionBox["1", 
            SuperscriptBox[
             StyleBox["q", "TI"], "2"]], "\[LongEqual]", "0", ",    ", 
           FractionBox["\[PartialD]", 
            RowBox[{"\[PartialD]", 
              SuperscriptBox[
               StyleBox["p", "TI"], "2"]}]], 
           SubsuperscriptBox["\[CapitalDelta]\[CapitalGamma]", 
            StyleBox["4pt\\;CT", FontSlant -> "Plain"], 
            RowBox[{"(", "2", ")"}]], 
           RowBox[{"(", 
             StyleBox["p", "TI"], ")"}], "\[LongEqual]", "0."}], 
         RowBox[{
           StyleBox["B", "TI"], "-", "39"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "$\\boxed{ \\Delta\\Gamma_{\\mathrm{4pt\\;CT}}^{(2)}(p) \\ \\propto\\ \
\\delta\\lambda_{\\mathrm{MS}}\\, \
\\mu^\\epsilon\\int\\frac{d^dq}{(2\\pi)^d}\\frac1{q^2} =0, \\qquad \
\\frac{\\partial}{\\partial p^2} \
\\Delta\\Gamma_{\\mathrm{4pt\\;CT}}^{(2)}(p)=0. } \\tag{B-39}$", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "56423e00-10d3-9f46-bd50-f99bec67d0d9"],
 "\n\nThis does not mean the four-point subgraphs are UV finite. They require \
subtraction. Rather, their counterterm insertions cannot change the ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox[
          StyleBox["p", "TI"], "2"], "/", "\[Epsilon]"}], TraditionalForm], 
     "errors" -> {}, "input" -> "$p^2/\\epsilon$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "9c396e02-d690-0b44-8ee3-b8a0fb5a03ed"],
 " coefficient: even if a nonzero mass were retained temporarily, the \
resulting tadpole would still be momentum-independent.\n\nThe subdivergences \
overlap, so they are not all subtracted simultaneously as disjoint subgraphs \
in a single forest term. Their individual local insertions nevertheless all \
have the same momentum-independent character."
}], "Text",
 CellChangeTimes->{{4.00428204038361*^9, 4.0042821269115753`*^9}, {
  4.0042839896421413`*^9, 4.004284221650734*^9}, {4.004286348971218*^9, 
  4.0042863899486504`*^9}},ExpressionUUID->"fb32b65b-846f-c640-a261-\
e557ae68746d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Define", " ", "dimension", " ", "d"}], "=", 
    RowBox[{"4", "-", "eps"}]}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"d", "=", 
     RowBox[{"4", "-", "eps"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "1.", " ", "Define", " ", "the", " ", "master", " ", "scalar", " ", 
     "integral", " ", "J_", 
     RowBox[{"{", 
      RowBox[{"alpha", ",", "beta"}], "}"}], 
     RowBox[{"(", "Q", ")"}], " ", "using", " ", 
     RowBox[{"FeynCalc", "/", "DR"}], " ", "formula"}], "*)"}], "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"J", 
      RowBox[{"(", 
       RowBox[{"alpha", ",", "beta"}], ")"}]}], "=", 
     RowBox[{"int", " ", 
      RowBox[{
       RowBox[{"d", "^", "dq"}], "/", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"2", "Pi"}], ")"}], "^", "d"}]}], "*", 
      RowBox[{"1", "/", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"q", "^", "2"}], ")"}], "^", "alpha"}], "*", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"Q", "-", "q"}], ")"}], "^", "2"}], ")"}], "^", 
          "beta"}]}], ")"}]}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"masterIntegral", "[", 
      RowBox[{"alpha_", ",", "beta_", ",", "QSq_", ",", "d_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"QSq", "^", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"d", "/", "2"}], "-", "alpha", "-", "beta"}], ")"}]}], "/", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"4", " ", "Pi"}], ")"}], "^", 
         RowBox[{"(", 
          RowBox[{"d", "/", "2"}], ")"}]}]}], ")"}], "*", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"Gamma", "[", 
          RowBox[{"alpha", "+", "beta", "-", 
           RowBox[{"d", "/", "2"}]}], "]"}], "*", 
         RowBox[{"Gamma", "[", 
          RowBox[{
           RowBox[{"d", "/", "2"}], "-", "alpha"}], "]"}], "*", 
         RowBox[{"Gamma", "[", 
          RowBox[{
           RowBox[{"d", "/", "2"}], "-", "beta"}], "]"}]}], ")"}], "/", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"Gamma", "[", "alpha", "]"}], "*", 
         RowBox[{"Gamma", "[", "beta", "]"}], "*", 
         RowBox[{"Gamma", "[", 
          RowBox[{"d", "-", "alpha", "-", "beta"}], "]"}]}], ")"}]}]}]}], 
    ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"2.", " ", "First", " ", 
      RowBox[{"Convolution", ":", 
       RowBox[{"integrate", " ", "over", " ", "l", " ", "for", " ", "H", 
        RowBox[{"(", "p", ")"}]}]}]}], "=", 
     RowBox[{"int", " ", "dk", " ", "int", " ", "dl", " ", 
      RowBox[{"1", "/", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"k", "^", "2"}], "*", 
         RowBox[{"l", "^", "2"}], "*", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"p", "-", "k", "-", "l"}], ")"}], "^", "2"}]}], 
        ")"}]}]}]}], "*)"}], "\n", 
   RowBox[{"(*", 
    RowBox[{"Inner", " ", "integral", " ", "is", " ", "J_", 
     RowBox[{"{", 
      RowBox[{"1", ",", "1"}], "}"}], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"p", "-", "k"}], ")"}], "^", "2"}], ")"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<--- Step 1: First Convolution over l ---\>\"", "]"}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"innerResult", "=", 
     RowBox[{"masterIntegral", "[", 
      RowBox[{"1", ",", "1", ",", "kSq", ",", "d"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<Inner integral result J_{1,1}((p-k)^2):\>\"", "]"}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"FullSimplify", "[", "innerResult", "]"}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"3.", " ", "Second", " ", 
     RowBox[{"Convolution", ":", 
      RowBox[{"integrate", " ", "over", " ", "k"}]}]}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"We", " ", "need", " ", "to", " ", "integrate", " ", 
     RowBox[{"k", "^", 
      RowBox[{"{", 
       RowBox[{"-", "2"}], "}"}]}], "*", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"p", "-", "k"}], ")"}], "^", "2"}], ")"}], "^", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"d", "/", "2"}], "-", "2"}], ")"}]}], "*", 
     RowBox[{"[", 
      RowBox[{
      "Constant", " ", "factors", " ", "from", " ", "inner", " ", 
       "integral"}], "]"}]}], "*)"}], "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
     "This", " ", "matches", " ", "masterIntegral", " ", "with", " ", 
      "alpha"}], "=", 
     RowBox[{
      RowBox[{"1", " ", "and", " ", "beta"}], "=", 
      RowBox[{"2", "-", 
       RowBox[{"d", "/", "2"}]}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"innerCoeff", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"Gamma", "[", 
          RowBox[{"2", "-", 
           RowBox[{"d", "/", "2"}]}], "]"}], "*", 
         RowBox[{
          RowBox[{"Gamma", "[", 
           RowBox[{
            RowBox[{"d", "/", "2"}], "-", "1"}], "]"}], "^", "2"}]}], ")"}], "/", 
       RowBox[{"Gamma", "[", 
        RowBox[{"d", "-", "2"}], "]"}]}], "/", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"4", " ", "Pi"}], ")"}], "^", 
       RowBox[{"(", 
        RowBox[{"d", "/", "2"}], ")"}]}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"outerIntegral", "=", 
     RowBox[{"innerCoeff", "*", 
      RowBox[{"masterIntegral", "[", 
       RowBox[{"1", ",", 
        RowBox[{"2", "-", 
         RowBox[{"d", "/", "2"}]}], ",", "pSq", ",", "d"}], "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Include", " ", "the", " ", 
     RowBox[{"mu", "^", "2"}], "eps", " ", "factor"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Hexpr", "=", 
     RowBox[{
      RowBox[{"mu", "^", 
       RowBox[{"(", 
        RowBox[{"2", "*", "eps"}], ")"}]}], "*", 
      RowBox[{"FullSimplify", "[", "outerIntegral", "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<\\n--- Step 2: Full Exact Expression H(p) (Eq. B-34) \
---\>\"", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", "Hexpr", "]"}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"4.", " ", "Laurent", " ", "Expansion", " ", "through", " ", "O", 
     RowBox[{"(", 
      RowBox[{"eps", "^", "0"}], ")"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<\\n--- Step 3: Laurent Expansion around eps -> 0 ---\>\
\"", "]"}], ";"}], "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Set", " ", 
      RowBox[{"p", "^", "2"}]}], "=", 
     RowBox[{
      RowBox[{"1", " ", "and", " ", "mu"}], "=", 
      RowBox[{
      "1", " ", "to", " ", "isolate", " ", "the", " ", "analytic", " ", 
       "epsilon", " ", "structure"}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Hunit", "=", 
     RowBox[{"Hexpr", "/.", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"pSq", "->", "pSq"}], ",", 
        RowBox[{"mu", "->", "mu"}]}], "}"}]}]}], ";"}], "\[IndentingNewLine]",
    "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Expand", " ", "around", " ", "eps"}], "=", "0"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"laurentExp", "=", 
     RowBox[{"Series", "[", 
      RowBox[{"Hunit", ",", 
       RowBox[{"{", 
        RowBox[{"eps", ",", "0", ",", "0"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<Laurent Expansion:\>\"", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", "laurentExp", "]"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Display", " ", "pole", " ", "and", " ", "finite", " ", "parts", " ", 
     "explicitly"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"polePart", "=", 
     RowBox[{"Coefficient", "[", 
      RowBox[{"laurentExp", ",", "eps", ",", 
       RowBox[{"-", "1"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"finitePart", "=", 
     RowBox[{"Coefficient", "[", 
      RowBox[{"laurentExp", ",", "eps", ",", "0"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<\\nPole Coefficient (1/eps):\>\"", ",", "polePart"}], "]"}],
     ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Finite Coefficient (eps^0):\>\"", ",", "finitePart"}], 
     "]"}], ";"}]}]}]], "Input",
 CellChangeTimes->{{4.0042855889812565`*^9, 4.0042855889812565`*^9}, {
  4.004285840780924*^9, 4.0042858457284985`*^9}},
 CellLabel->"In[98]:=",ExpressionUUID->"0731d479-6cdd-3f48-8055-70dc6ede33d4"],

