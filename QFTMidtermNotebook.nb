           RowBox[{"(", 
             RowBox[{"2", "\[Pi]"}], ")"}], 
           StyleBox["d", "TI"]]], 
         FractionBox["1", 
          RowBox[{
            SuperscriptBox[
             StyleBox["k", "TI"], "2"], 
            SuperscriptBox[
             RowBox[{"[", 
               SuperscriptBox[
                RowBox[{"(", 
