Cell["\<\
Derivation | Diagrams generated via CreateTopologies; amplitudes extracted \
via CreateFeynAmp and converted to standard scalar integrals via FCFAConvert \
and ToPaVe.
Check | Confirmed: Two-point function maps to A\:2080(m\.b2), four-point \
function channels map to B\:2080(P\:1d62\:2c7c\.b2, m\.b2, m\.b2); symmetry \
factors 1/2 verified.
Anchor IDs | B-01, B-02
Status | checked\
\>", "Text",
 CellChangeTimes->{{4.0038500997086926`*^9, 
  4.0038501056981373`*^9}},ExpressionUUID->"5f085ea2-15f5-c64b-ab14-\
3b8fac9771e2"]
}, Open  ]],

