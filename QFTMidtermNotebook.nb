      RowBox[{
       RowBox[{"-", 
        RowBox[{"D", "[", 
         RowBox[{"tDRFinite", ",", "massSq"}], "]"}]}], "-", "bDRFinite"}], ",", 
      RowBox[{"Assumptions", "->", 
