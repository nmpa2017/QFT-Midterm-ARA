Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Generate", " ", "only", " ", "the", " ", "sunset", " ", "topology"}], 
   "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"sunsetTopos", "=", 
     RowBox[{"CreateTopologies", "[", 
      RowBox[{"2", ",", 
       RowBox[{"1", "->", "1"}], ",", 
       RowBox[{"StartingTopologies", "->", "Theta"}], ",", 
       RowBox[{"Adjacencies", "->", 
        RowBox[{"{", "4", "}"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Insert", " ", "the", " ", "real", " ", "scalar", " ", "field"}],
      ",", 
     RowBox[{
     "using", " ", "the", " ", "working", " ", "full", " ", "model", " ", 
      "paths"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"sunset", "=", 
     RowBox[{"InsertFields", "[", 
      RowBox[{"sunsetTopos", ",", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"S", "[", "1", "]"}], "}"}], "->", 
        RowBox[{"{", 
         RowBox[{"S", "[", "1", "]"}], "}"}]}], ",", 
       RowBox[{"InsertionLevel", "->", 
        RowBox[{"{", "Classes", "}"}]}], ",", 
       RowBox[{"Model", "->", 
        RowBox[{"FileNameJoin", "[", 
         RowBox[{"{", 
          RowBox[{"modelDir", ",", "\"\<Phi4\>\""}], "}"}], "]"}]}], ",", 
       RowBox[{"GenericModel", "->", 
        RowBox[{"FileNameJoin", "[", 
         RowBox[{"{", 
          RowBox[{"modelDir", ",", "\"\<Phi4\>\""}], "}"}], "]"}]}]}], 
      "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"Paint", "[", 
    RowBox[{"sunset", ",", 
     RowBox[{"Numbering", "->", "Simple"}], ",", 
     RowBox[{"FieldNumbers", "->", "True"}]}], "]"}], "\[IndentingNewLine]", 
   "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Generate", " ", "and", " ", "convert", " ", "the", " ", "sunset", " ", 
     "amplitude"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"faSunset", "=", 
     RowBox[{"CreateFeynAmp", "[", 
      RowBox[{"sunset", ",", 
       RowBox[{"PreFactor", "->", "1"}]}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"fcSunset", "=", 
     RowBox[{"FCFAConvert", "[", 
      RowBox[{"faSunset", ",", 
       RowBox[{"IncomingMomenta", "->", 
        RowBox[{"{", "p", "}"}]}], ",", 
       RowBox[{"OutgoingMomenta", "->", 
        RowBox[{"{", "p", "}"}]}], ",", 
       RowBox[{"LoopMomenta", "->", 
        RowBox[{"{", 
         RowBox[{"k", ",", "l"}], "}"}]}], ",", 
       RowBox[{"ChangeDimension", "->", "D"}], ",", 
       RowBox[{"List", "->", "False"}]}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]",
    "fcSunset"}]}]], "Input",
